    "faqs_tVaRYD": {
      "type": "faqs",
      "blocks": {
        "faq_item_ApMt4r": {
          "type": "faq_item",
          "settings": {
            "question": "What is a yak chew?",
            "answer": "<p>I think of a yak chew as a simple, old-world cheese chew made for modern dogs. It is dense, long-lasting, and meant to give your dog a real job during supervised calm time.</p>"
          }
        },
        "faq_item_K7RCbk": {
          "type": "faq_item",
          "settings": {
            "question": "What are yak chews made from?",
            "answer": "<p>4 simple ingredients: Yak milk, cow milk, lime juice, salt. No rawhide, artificial flavors, preservatives, or unnecessary fillers.</p><p>Crafted in Nepal using traditional Himalayan methods. Packed in the USA under Prime Pet Food quality standards.</p>"
          }
        },
        "faq_item_nUazy7": {
          "type": "faq_item",
          "settings": {
            "question": "Are yak chews safe for dogs?",
            "answer": "<p>They can be a safe choice when they are the right size and you supervise the session. I always recommend fresh water nearby, shorter first sessions, and removing the chew before it becomes small enough to swallow.</p>"
          }
        },
        "faq_item_KxqTWx": {
          "type": "faq_item",
          "settings": {
            "question": "How are yak chews made?",
            "answer": "<p>The traditional process is slow: milk is heated, curds are formed, the cheese is pressed into shape, and the pieces are dried until they become dense enough for long chew sessions.</p>"
          }
        },
        "faq_item_kMyAkX": {
          "type": "faq_item",
          "settings": {
            "question": "What size yak chew should I get for my dog?",
            "answer": "<p>Start with weight, then look at mouth size and chewing style. If your dog is between sizes or chews hard, I would size up.</p><ul><li><strong>Small</strong>: for dogs up to 15 lbs</li><li><strong>Medium</strong>: for dogs up to 35 lbs</li><li><strong>Large</strong>: for dogs up to 55 lbs</li><li><strong>Extra Large</strong>: for dogs up to 85 lbs</li><li><strong>Jumbo</strong>: for dogs above 85 lbs</li></ul>"
          }
        },
        "faq_item_C3irtd": {
          "type": "faq_item",
          "settings": {
            "question": "Are yak chews good for dogs’ teeth?",
            "answer": "<p>Chewing can help scrape and occupy the mouth, but yak chews are hard. If your dog has weak teeth, dental disease, missing teeth, or a cracked-tooth history, ask your veterinarian before using any hard chew.</p>"
          }
        },
        "faq_item_EVBFGx": {
          "type": "faq_item",
          "settings": {
            "question": "Yak chew vs bully stick — which is better?",
            "answer": "<p>If you want a softer edible chew, bully sticks may fit. If you want lower odor, less grease, and a longer supervised chew session, I would usually start with a properly sized yak chew.</p>"
          }
        },
        "faq_item_JPDiP9": {
          "type": "faq_item",
          "settings": {
            "question": "What do I do with the end piece of a yak chew?",
            "answer": "<p>When the end piece gets small, take it away from your dog. Soak it, microwave it until it puffs, then let it cool completely before serving the crunchy puff.</p>"
          }
        },
        "faq_item_zCPr6g": {
          "type": "faq_item",
          "settings": {
            "question": "How long do they last?",
            "answer": "<p>Depending on your dog's chewing intensity, a single chew can last anywhere from 3 days to 2+ weeks.</p>"
          }
        },
        "faq_item_iqwipL": {
          "type": "faq_item",
          "settings": {
            "question": "Are they safe for puppies?",
            "answer": "<p>We recommend yak chews for puppies 4+ months old who have started teething. Always supervise chewing.</p>"
          }
        },
        "faq_item_nkxPPQ": {
          "type": "faq_item",
          "settings": {
            "question": "What do I do with the small end piece?",
            "answer": "<p>Soak it in hot water for 5 minutes, then microwave for 45–60 seconds. It puffs up into a delicious cheesy treat.</p>"
          }
        },
        "faq_item_power_chewers": {
          "type": "faq_item",
          "settings": {
            "question": "Can aggressive chewers use yak chews?",
            "answer": "<p>Many power chewers do well with a properly sized yak chew, but sizing and supervision matter. If your dog is between sizes, size up. If your dog tries to gulp, bite off large pieces, or has dental risk, pause and choose a softer option or ask your vet.</p>"
          }
        },
        "faq_item_hardness": {
          "type": "faq_item",
          "settings": {
            "question": "How hard are they?",
            "answer": "<p>They are hard cheese chews made for supervised chewing, not soft snacks. They gradually wear down as dogs work on them, but they are not right for dogs with weak teeth, dental disease, crowns, or a cracked-tooth history.</p>"
          }
        },
        "faq_item_storage": {
          "type": "faq_item",
          "settings": {
            "question": "How should I store them?",
            "answer": "<p>Keep chews in a cool, dry place and reseal the bag after opening. Avoid storing them in damp areas because moisture can change the texture.</p>"
          }
        },
        "faq_item_odor": {
          "type": "faq_item",
          "settings": {
            "question": "Do they smell?",
            "answer": "<p>They are low odor compared with many animal-based chews. You may notice a mild natural cheese smell, especially once your dog starts chewing, but they are made for cleaner indoor use.</p>"
          }
        }
      },
