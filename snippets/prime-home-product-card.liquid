{%- liquid
  assign card_url = '/collections/all'
  if product != blank
    assign card_url = product.url
  endif
  if product != blank and variant != blank
    assign card_url = product.url | append: '?variant=' | append: variant.id
  endif

  assign package_image_src = package_image | default: blank
  if package_image_src == blank
    if variant != blank and variant.featured_media != blank
      assign package_image_src = variant.featured_media.preview_image | image_url: width: 520
    elsif product != blank and product.featured_media != blank
      assign package_image_src = product.featured_media.preview_image | image_url: width: 520
    elsif product != blank and product.featured_image != blank
      assign package_image_src = product.featured_image | image_url: width: 520
    endif
  endif
-%}

<article class="ph-product-card">
  {% if image != blank %}
    <a class="ph-product-card__media ph-product-card__media-link" href="{{ card_url }}" aria-label="View {{ title | escape }} details">
      <img src="{{ image }}" alt="{{ image_alt | escape }}" loading="lazy" width="1024" height="1024">
      {% if package_image_src != blank %}
        <span class="ph-product-card__pack" aria-hidden="true">
          <img
            src="{{ package_image_src }}"
            alt=""
            loading="lazy"
            width="520"
            height="520"
          >
        </span>
      {% endif %}
      {% if label != blank %}
        <span class="ph-product-card__label">{{ label }}</span>
      {% endif %}
    </a>
  {% endif %}

  <div class="ph-product-card__body">
    <span class="ph-product-card__badge">{{ badge }}</span>
    <h3><a href="{{ card_url }}">{{ title }}</a></h3>
    <span class="ph-product-card__fit">{{ fit }}</span>
    {% if best_for != blank %}
      <span class="ph-product-card__best">Best for {{ best_for }}</span>
    {% endif %}
    <p>{{ text }}</p>
  </div>

  <div class="ph-product-card__footer">
    {% if variant != blank %}
      <div class="ph-product-card__buy-meta">
        <span class="ph-product-card__price">From {{ variant.price | money }}</span>
        <span class="ph-product-card__note">Ships fast from Prime Pet Food</span>
      </div>
      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ variant.id }}">
        <button type="submit"{% unless variant.available %} disabled{% endunless %}>
          {% if variant.available %}Add to cart{% else %}Sold out{% endif %}
        </button>
      </form>
    {% elsif product != blank %}
      <a href="{{ card_url }}" class="ph-product-card__link">View product</a>
    {% else %}
      <a href="/collections/all" class="ph-product-card__link">Shop chews</a>
    {% endif %}
  </div>
</article>
