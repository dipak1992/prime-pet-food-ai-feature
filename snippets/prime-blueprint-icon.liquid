{% comment %}
  Prime Pet Food blueprint icon family.
  Use inside an icon frame; paths are intentionally line-art/technical to feel
  closer to founder-led product engineering than generic web icons.
{% endcomment %}
{% liquid
  assign icon_name = name | default: 'chew-time'
  assign icon_size = size | default: 28
%}

<svg
  class="prime-blueprint-icon prime-blueprint-icon--{{ icon_name | handle }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.65"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path class="prime-blueprint-icon__guide" d="M4 4h24v24H4z" opacity=".18" stroke-dasharray="2 3"/>
  <path class="prime-blueprint-icon__guide" d="M16 3v26M3 16h26" opacity=".12" stroke-dasharray="2 4"/>

  {% case icon_name %}
    {% when 'chew-time' %}
      <circle cx="16" cy="16" r="8.5"/>
      <path d="M16 9.5v6.8l4.6 2.7"/>
      <path d="M10.2 6.2l-2.4 2.2M21.8 6.2l2.4 2.2"/>
    {% when 'safety' %}
      <path d="M16 5.2l8 3v6.5c0 5.4-3.4 9.4-8 12.1-4.6-2.7-8-6.7-8-12.1V8.2l8-3z"/>
      <path d="M11.8 16.2l2.8 2.8 5.8-6.2"/>
      <path d="M16 8.2v17"/>
    {% when 'ingredients' %}
      <path d="M12.2 6.4h7.6"/>
      <path d="M13.6 6.4v6.8l-4.8 9.2c-.9 1.7.3 3.7 2.2 3.7h10c1.9 0 3.1-2 2.2-3.7l-4.8-9.2V6.4"/>
      <path d="M11.2 20.2h9.6"/>
      <circle cx="14" cy="22.5" r=".8"/>
      <circle cx="18.8" cy="23.1" r=".8"/>
      <path d="M15 13.8h2"/>
    {% when 'fit' %}
      <path d="M7.5 17.5c2.1-5.7 6.1-8.9 12.2-9.5"/>
      <path d="M8.1 18.3c2.8 4.1 7.3 5 12.2 2.2"/>
      <path d="M19.7 8c2.4 2.6 2.7 7.6.6 12.5"/>
      <circle cx="9.5" cy="17.8" r="2.2"/>
      <path d="M12.2 13.2h6.8M13.5 16.1h5"/>
    {% when 'review' %}
      <path d="M16 5.7l2.9 6 6.6.9-4.8 4.7 1.2 6.6-5.9-3.1-5.9 3.1 1.2-6.6-4.8-4.7 6.6-.9 2.9-6z"/>
      <path d="M16 10.4v10.4M10.9 14.1h10.2"/>
    {% when 'guarantee' %}
      <path d="M23.8 10.5A9.2 9.2 0 1 0 25 16"/>
      <path d="M24 5.5v5.2h-5.2"/>
      <path d="M12.1 16.3l2.7 2.7 5.1-6.1"/>
    {% when 'shipping' %}
      <path d="M5 10.2h13.2v10.2H5z"/>
      <path d="M18.2 13.1h4.3l4.5 4.2v3.1h-8.8z"/>
      <circle cx="10" cy="22.8" r="2.1"/>
      <circle cx="23" cy="22.8" r="2.1"/>
      <path d="M7.6 7.8h7.8M5.2 13.4h5.4"/>
    {% when 'love' %}
      <path d="M16 25.5S6.6 20.2 6.6 12.4c0-3 2.2-5.2 5-5.2 1.8 0 3.3 1 4.4 2.5 1.1-1.5 2.6-2.5 4.4-2.5 2.8 0 5 2.2 5 5.2 0 7.8-9.4 13.1-9.4 13.1z"/>
      <path d="M11.2 12.2h3.2l1.1-2.3 2.2 5 1.1-2.7h2.8"/>
    {% when 'calm-home' %}
      <path d="M6.5 15.2L16 7.4l9.5 7.8v10H6.5z"/>
      <path d="M12.5 25.2v-7h7v7"/>
      <path d="M10.2 14.7h11.6M16 7.4v4.2"/>
    {% when 'value' %}
      <path d="M16 5v22"/>
      <path d="M21.2 9.2h-7.3a3.4 3.4 0 0 0 0 6.8h4.2a3.4 3.4 0 0 1 0 6.8H10"/>
      <path d="M8.2 8.2l15.6 15.6" opacity=".42"/>
    {% else %}
      <path d="M9 11h14v10H9z"/>
      <path d="M12 8h8M12 24h8"/>
  {% endcase %}
</svg>
