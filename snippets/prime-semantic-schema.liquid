{% comment %}
  Prime Pet Food semantic entity graph for Google, AI Overviews, and LLM retrieval.
  Keep this concise: page-level Product, FAQ, Article, and Breadcrumb schemas remain in their own templates.
{% endcomment %}

{%- liquid
  assign homepage_url = request.origin | append: routes.root_url
  assign product_url = request.origin | append: '/products/himalayan-yak-chews-for-dogs'
  assign guide_hub_url = request.origin | append: '/pages/yak-chew-guides'
  assign faq_url = request.origin | append: '/pages/faq'
  assign process_url = request.origin | append: '/pages/how-himalayan-yak-cheese-chews-are-made'
  assign duration_url = request.origin | append: '/pages/how-long-will-this-last-for-my-dog'
  assign rawhide_url = request.origin | append: '/pages/best-rawhide-alternative'
  assign aggressive_url = request.origin | append: '/pages/best-long-lasting-chew-for-aggressive-chewers'
  assign safety_hub_url = request.origin | append: '/pages/yak-chew-safety-science'
  assign safety_guide_url = request.origin | append: '/pages/yak-chew-safety-guide'
  assign enrichment_hub_url = request.origin | append: '/pages/dog-ritual-enrichment'
  assign decompression_url = request.origin | append: '/pages/canine-decompression'
  assign prime_scale_url = request.origin | append: '/pages/prime-scale'
  assign predictive_url = request.origin | append: '/pages/predictive-chew-intelligence'
  assign heritage_hub_url = request.origin | append: '/pages/himalayan-heritage-sourcing'
  assign wholesale_url = request.origin | append: '/pages/wholesale'
  assign search_base_url = request.origin | append: routes.search_url | append: '?q='
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ homepage_url | append: '#organization' | json }},
      "name": {{ shop.name | json }},
      "url": {{ homepage_url | json }},
      "description": "Prime Pet Food is a premium dog enrichment brand focused on Himalayan yak cheese dog chews, rawhide-free chewing routines, natural dog chews, and safer supervised chew-time education.",
      "sameAs": [
        {%- liquid
          assign has_same_as = false
          if settings.social_instagram_link != blank
            echo settings.social_instagram_link | json
            assign has_same_as = true
          endif
          if settings.social_facebook_link != blank
            if has_same_as
              echo ','
            endif
            echo settings.social_facebook_link | json
            assign has_same_as = true
          endif
          if settings.social_tiktok_link != blank
            if has_same_as
              echo ','
            endif
            echo settings.social_tiktok_link | json
          endif
        -%}
      ],
      "knowsAbout": [
        "Himalayan yak cheese dog chews",
        "yak chews for dogs",
        "long-lasting dog chews",
        "rawhide alternatives",
        "aggressive chewer enrichment",
        "natural dog chews",
        "dog chew safety",
        "thumbnail test for dog chews",
        "yak chew nub puffing",
        "dog enrichment",
        "canine decompression",
        "dog decompression rituals",
        "chew duration prediction",
        "predictive dog chew subscriptions",
        "dog chew hardness grading",
        "Prime Scale dog chew safety standard",
        "breed-specific chew sizing",
        "Nepalese yak cheese traditions",
        "supervised chewing routines"
      ]
    },
    {
      "@type": "WebSite",
      "@id": {{ homepage_url | append: '#website' | json }},
      "url": {{ homepage_url | json }},
      "name": {{ shop.name | json }},
      "publisher": {
        "@id": {{ homepage_url | append: '#organization' | json }}
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ search_base_url }}{%- raw -%}{search_term_string}{%- endraw -%}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "DefinedTermSet",
      "@id": {{ homepage_url | append: '#yak-chew-knowledge-graph' | json }},
      "name": "Prime Pet Food yak chew knowledge graph",
      "description": "A semantic map connecting Prime Pet Food content about Himalayan yak chews, dog enrichment, rawhide alternatives, chew safety, manufacturing, and breed-specific chew guidance.",
      "hasDefinedTerm": [
        {
          "@type": "DefinedTerm",
          "name": "Himalayan yak cheese dog chews",
          "url": {{ product_url | json }},
          "sameAs": {{ process_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Dog chew duration estimator",
          "url": {{ duration_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Safety-first yak chew education",
          "url": {{ safety_hub_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Supervised chewing and thumbnail test guidance",
          "url": {{ safety_guide_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Dog ritual and enrichment routines",
          "url": {{ enrichment_hub_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Canine decompression",
          "url": {{ decompression_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Prime Scale dog chew safety standard",
          "url": {{ prime_scale_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Predictive chew intelligence",
          "url": {{ predictive_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Himalayan heritage and sourcing",
          "url": {{ heritage_hub_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Rawhide-free dog chew alternatives",
          "url": {{ rawhide_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Aggressive chewer solutions",
          "url": {{ aggressive_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Yak chew safety and sizing FAQ",
          "url": {{ faq_url | json }}
        },
        {
          "@type": "DefinedTerm",
          "name": "Wholesale Himalayan dog chews",
          "url": {{ wholesale_url | json }}
        }
      ]
    },
    {
      "@type": "WebApplication",
      "@id": {{ duration_url | append: '#chew-duration-predictor' | json }},
      "name": "Prime Pet Food Chew Duration Predictor",
      "url": {{ duration_url | json }},
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "Web",
      "isAccessibleForFree": true,
      "publisher": {
        "@id": {{ homepage_url | append: '#organization' | json }}
      },
      "about": [
        "dog chew duration",
        "breed-specific yak chew sizing",
        "aggressive chewer guidance",
        "puppy chew guidance",
        "Himalayan yak cheese chews"
      ],
      "description": "A rules-based chew duration predictor that uses breed, age, size, and chewing strength to estimate Prime Pet Food yak chew duration and recommend a safer sizing routine."
    },
    {
      "@type": "WebApplication",
      "@id": {{ homepage_url | append: '#prime-pet-food-concierge' | json }},
      "name": "Prime Pet Food Concierge",
      "url": {{ homepage_url | json }},
      "applicationCategory": "ShoppingApplication",
      "operatingSystem": "Web",
      "isAccessibleForFree": true,
      "publisher": {
        "@id": {{ homepage_url | append: '#organization' | json }}
      },
      "about": [
        "Himalayan yak chews",
        "safe dog chew sizing",
        "rawhide-free dog chews",
        "chewing style recommendations",
        "puppy and aggressive chewer guidance"
      ],
      "description": "An on-site Prime Pet Food shopping concierge that answers sizing, safety, product, order, subscription, and wholesale questions using the store's yak chew knowledge base."
    }
  ]
}
</script>
