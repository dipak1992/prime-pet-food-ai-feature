{%- comment -%}
  Guaranteed Analysis Panel
  File: snippets/prime-guaranteed-analysis.liquid
  
  Displays a standard pet food Guaranteed Analysis panel with crude protein,
  fat, moisture, ash, and caloric density. Builds immediate trust with
  ingredient-conscious premium buyers.
  
  Usage: {% render 'prime-guaranteed-analysis' %}
{%- endcomment -%}

<div class="pga" aria-label="Guaranteed Analysis">
  <style>
    .pga {
      margin: 24px 0;
      font-family: var(--font-body-family, -apple-system, sans-serif);
      border: 1px solid #e5d9c8;
      border-radius: 12px;
      overflow: hidden;
    }

    .pga__header {
      background: #1a0f00;
      color: #fff;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .pga__title {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin: 0;
    }

    .pga__badge {
      font-size: 10px;
      font-weight: 700;
      padding: 3px 8px;
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
      border-radius: 100px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .pga__table {
      width: 100%;
      border-collapse: collapse;
    }

    .pga__table tr {
      border-bottom: 1px solid #f0ebe2;
    }

    .pga__table tr:last-child {
      border-bottom: none;
    }

    .pga__table td {
      padding: 11px 16px;
      font-size: 14px;
      color: #2d2416;
    }

    .pga__table td:first-child {
      font-weight: 600;
    }

    .pga__table td:last-child {
      text-align: right;
      font-weight: 700;
      color: #1a1a1a;
    }

    .pga__table tr.pga__highlight {
      background: #fffbeb;
    }

    .pga__footer {
      padding: 10px 16px;
      background: #f9f5ef;
      border-top: 1px solid #f0ebe2;
    }

    .pga__footer p {
      font-size: 11px;
      color: #7a6a52;
      margin: 0;
      line-height: 1.5;
    }

    .pga__footer strong {
      color: #4a3f2f;
    }
  </style>

  <div class="pga__header">
    <p class="pga__title">Guaranteed Analysis</p>
    <span class="pga__badge">4 Ingredients</span>
  </div>

  <table class="pga__table">
    <tr class="pga__highlight">
      <td>Crude Protein (min.)</td>
      <td>52.0%</td>
    </tr>
    <tr>
      <td>Crude Fat (min.)</td>
      <td>5.2%</td>
    </tr>
    <tr>
      <td>Crude Fiber (max.)</td>
      <td>0.5%</td>
    </tr>
    <tr>
      <td>Moisture (max.)</td>
      <td>10.2%</td>
    </tr>
    <tr>
      <td>Ash (max.)</td>
      <td>8.5%</td>
    </tr>
    <tr class="pga__highlight">
      <td>Caloric Content</td>
      <td>350 kcal/100g</td>
    </tr>
  </table>

  <div class="pga__footer">
    <p><strong>Ingredients:</strong> Yak milk, cow milk, lime juice, salt. No preservatives, no artificial colors, no grain, no gluten. Made in Nepal, packed in the USA.</p>
  </div>
</div>
