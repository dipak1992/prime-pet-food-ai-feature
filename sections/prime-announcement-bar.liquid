{% comment %}
  Prime Announcement Bar
  A premium rotating announcement/marketing bar for the top of the page.
  Self-contained section with CSS, JS, Liquid, and Schema.
{% endcomment %}

{%- liquid
  assign bg_color = section.settings.background_color | default: '#2C2C2C'
  assign text_color = section.settings.text_color | default: '#FAF7F2'
  assign auto_rotate = section.settings.auto_rotate
  assign rotation_speed = section.settings.rotation_speed | default: 4
  assign show_close = section.settings.show_close_button
-%}

<style>
  .prime-announcement-bar {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 100;
    overflow: hidden;
    font-family: var(--prime-font-caption, sans-serif);
    font-size: var(--prime-font-caption-size, 0.75rem);
    letter-spacing: var(--prime-tracking-wider, 0.1em);
    text-transform: uppercase;
    line-height: 1;
  }

  .prime-announcement-bar[aria-hidden="true"] {
    display: none;
  }

  .prime-announcement-bar__container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1200px;
    padding: 0 1rem;
    position: relative;
    height: 100%;
  }

  .prime-announcement-bar__messages {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .prime-announcement-bar__message {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 400ms var(--prime-ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    white-space: nowrap;
    pointer-events: none;
    text-align: center;
    width: 100%;
  }

  .prime-announcement-bar__message.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .prime-announcement-bar__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: {{ text_color }};
    opacity: 0.4;
    cursor: pointer;
    padding: 0.25rem;
    font-size: 0.625rem;
    line-height: 1;
    transition: opacity 200ms ease;
    display: none;
  }

  .prime-announcement-bar__nav:hover {
    opacity: 0.8;
  }

  .prime-announcement-bar__nav--prev {
    left: 0.5rem;
  }

  .prime-announcement-bar__nav--next {
    right: 2.5rem;
  }

  .prime-announcement-bar__close {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: {{ text_color }};
    opacity: 0.4;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    font-size: 1rem;
    line-height: 1;
    transition: opacity 200ms ease;
  }

  .prime-announcement-bar__close:hover {
    opacity: 0.8;
  }

  .prime-announcement-bar__close[aria-hidden="true"] {
    display: none;
  }

  @media (max-width: 749px) {
    .prime-announcement-bar {
      height: 36px;
    }

    .prime-announcement-bar__message {
      font-size: 0.675rem;
      padding: 0 2rem;
      white-space: normal;
      line-height: 1.2;
    }

    .prime-announcement-bar__nav {
      display: block;
    }
  }
</style>

<div
  class="prime-announcement-bar"
  id="prime-announcement-bar-{{ section.id }}"
  role="region"
  aria-label="Announcements"
  data-section-id="{{ section.id }}"
  data-auto-rotate="{{ auto_rotate }}"
  data-rotation-speed="{{ rotation_speed }}"
>
  <div class="prime-announcement-bar__container">
    <button class="prime-announcement-bar__nav prime-announcement-bar__nav--prev" aria-label="Previous announcement">‹</button>

    <div class="prime-announcement-bar__messages" aria-live="polite" aria-atomic="true">
      {%- for block in section.blocks -%}
        <div
          class="prime-announcement-bar__message{% if forloop.first %} is-active{% endif %}"
          {{ block.shopify_attributes }}
          role="marquee"
        >
          {{ block.settings.text }}
        </div>
      {%- endfor -%}
    </div>

    <button class="prime-announcement-bar__nav prime-announcement-bar__nav--next" aria-label="Next announcement">›</button>

    <button
      class="prime-announcement-bar__close"
      aria-label="Close announcement"
      {% unless show_close %}aria-hidden="true"{% endunless %}
    >×</button>
  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var bar = document.getElementById('prime-announcement-bar-' + sectionId);
    if (!bar) return;

    var storageKey = 'prime-announcement-dismissed-' + sectionId;

    // Check if dismissed
    if (sessionStorage.getItem(storageKey) === 'true') {
      bar.setAttribute('aria-hidden', 'true');
      return;
    }

    var messages = bar.querySelectorAll('.prime-announcement-bar__message');
    var totalMessages = messages.length;
    if (totalMessages <= 0) return;

    var currentIndex = 0;
    var autoRotate = bar.dataset.autoRotate === 'true';
    var rotationSpeed = parseInt(bar.dataset.rotationSpeed, 10) * 1000;
    var intervalId = null;
    var isPaused = false;

    function showMessage(index) {
      messages[currentIndex].classList.remove('is-active');
      currentIndex = (index + totalMessages) % totalMessages;
      messages[currentIndex].classList.add('is-active');
    }

    function nextMessage() {
      showMessage(currentIndex + 1);
    }

    function prevMessage() {
      showMessage(currentIndex - 1);
    }

    function startRotation() {
      if (autoRotate && totalMessages > 1 && !intervalId) {
        intervalId = setInterval(nextMessage, rotationSpeed);
      }
    }

    function stopRotation() {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    }

    // Auto-rotate
    startRotation();

    // Pause on hover (desktop)
    bar.addEventListener('mouseenter', function() {
      isPaused = true;
      stopRotation();
    });

    bar.addEventListener('mouseleave', function() {
      isPaused = false;
      startRotation();
    });

    // Navigation arrows
    var prevBtn = bar.querySelector('.prime-announcement-bar__nav--prev');
    var nextBtn = bar.querySelector('.prime-announcement-bar__nav--next');

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        stopRotation();
        prevMessage();
        if (!isPaused) startRotation();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        stopRotation();
        nextMessage();
        if (!isPaused) startRotation();
      });
    }

    // Close button
    var closeBtn = bar.querySelector('.prime-announcement-bar__close');
    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        stopRotation();
        bar.setAttribute('aria-hidden', 'true');
        sessionStorage.setItem(storageKey, 'true');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Prime Announcement Bar",
  "tag": "section",
  "class": "prime-announcement-bar-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#2C2C2C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FAF7F2"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate messages",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Rotation speed (seconds)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show close button",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "Free shipping over $30"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prime Announcement Bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Crafted using a traditional Himalayan recipe"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Rawhide-free. Long-lasting. Loved by heavy chewers."
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Packed in USA"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Free shipping over $30"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "4 simple ingredients. Nothing else."
          }
        }
      ]
    }
  ]
}
{% endschema %}
