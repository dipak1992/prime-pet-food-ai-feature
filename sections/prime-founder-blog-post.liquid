{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Prime Founder Blog Post Section
  Renders a rich, founder-voiced article layout with:
  - Founder byline + credential badge
  - Pull quote / key insight callout
  - Inline author bio
  - Internal links to related content
  Usage: Add to article template JSON as a section block.
{%- endcomment -%}

<div class="prime-fbp color-{{ section.settings.color_scheme }}">
  <style>
    .prime-fbp {
      font-family: var(--font-body-family, -apple-system, sans-serif);
    }

    .prime-fbp__byline {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 20px 0 8px;
      border-bottom: 1px solid #e5d9c8;
      margin-bottom: 28px;
    }

    .prime-fbp__byline-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #fef3c7;
      color: #92400e;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .prime-fbp__byline-meta {
      flex: 1;
    }

    .prime-fbp__byline-name {
      font-size: 14px;
      font-weight: 700;
      color: #1a1a1a;
      margin: 0 0 2px;
    }

    .prime-fbp__byline-role {
      font-size: 12px;
      color: #7a6a52;
      margin: 0;
    }

    .prime-fbp__byline-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 10px;
      background: #fef3c7;
      border: 1px solid #fde68a;
      border-radius: 100px;
      font-size: 11px;
      font-weight: 600;
      color: #92400e;
      white-space: nowrap;
    }

    .prime-fbp__key-insight {
      margin: 32px 0;
      padding: 20px 24px;
      background: linear-gradient(135deg, #fffbeb, #fef3c7);
      border-left: 4px solid #f59e0b;
      border-radius: 0 12px 12px 0;
    }

    .prime-fbp__key-insight-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #b45309;
      margin: 0 0 8px;
    }

    .prime-fbp__key-insight-text {
      font-size: 17px;
      font-weight: 600;
      color: #1a1a1a;
      line-height: 1.5;
      margin: 0;
      font-style: italic;
    }

    .prime-fbp__content {
      font-size: 16px;
      line-height: 1.75;
      color: #2d2416;
    }

    .prime-fbp__content h2 {
      font-size: 22px;
      font-weight: 700;
      margin: 36px 0 12px;
      color: #1a1a1a;
    }

    .prime-fbp__content h3 {
      font-size: 18px;
      font-weight: 700;
      margin: 28px 0 10px;
      color: #1a1a1a;
    }

    .prime-fbp__content p {
      margin: 0 0 18px;
    }

    .prime-fbp__content ul,
    .prime-fbp__content ol {
      margin: 0 0 18px;
      padding-left: 24px;
    }

    .prime-fbp__content li {
      margin-bottom: 8px;
    }

    .prime-fbp__related-links {
      margin: 40px 0 0;
      padding: 20px 24px;
      background: #f9f5ef;
      border: 1px solid #e5d9c8;
      border-radius: 12px;
    }

    .prime-fbp__related-links-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #7a6a52;
      margin: 0 0 12px;
    }

    .prime-fbp__related-links ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .prime-fbp__related-links a {
      font-size: 14px;
      font-weight: 600;
      color: #92400e;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .prime-fbp__related-links a:hover {
      text-decoration: underline;
    }

    .prime-fbp__related-links a::before {
      content: '→';
      font-size: 13px;
      opacity: 0.7;
    }
  </style>

  <div class="page-width page-width--narrow">

    {%- if section.settings.show_byline -%}
      <div class="prime-fbp__byline">
        <div class="prime-fbp__byline-avatar" aria-hidden="true">D</div>
        <div class="prime-fbp__byline-meta">
          <p class="prime-fbp__byline-name">{{ section.settings.byline_name }}</p>
          <p class="prime-fbp__byline-role">{{ section.settings.byline_role }}</p>
        </div>
        <span class="prime-fbp__byline-badge">🏔️ Founder Voice</span>
      </div>
    {%- endif -%}

    {%- if section.settings.key_insight != blank -%}
      <div class="prime-fbp__key-insight" role="note" aria-label="Key insight">
        <p class="prime-fbp__key-insight-label">Key Insight</p>
        <p class="prime-fbp__key-insight-text">{{ section.settings.key_insight }}</p>
      </div>
    {%- endif -%}

    {%- if section.settings.article_body != blank -%}
      <div class="prime-fbp__content rte">
        {{ section.settings.article_body }}
      </div>
    {%- endif -%}

    <div class="prime-fbp__related-links" aria-label="Related reading">
      <p class="prime-fbp__related-links-label">Related Reading</p>
      <ul>
        {%- for block in section.blocks -%}
          {%- if block.type == 'related_link' and block.settings.link_url != blank -%}
            <li>
              <a href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.blocks.size == 0 -%}
          <li><a href="/blogs/dog-behavior/how-long-do-yak-chews-last">How long do yak chews last for my dog?</a></li>
          <li><a href="/blogs/dog-behavior/best-rawhide-alternative">Why yak chews beat rawhide every time</a></li>
          <li><a href="/pages/my-dog">Build your dog's chew profile</a></li>
        {%- endif -%}
      </ul>
    </div>

    {%- render 'prime-author-bio', author: 'founder' -%}

  </div>
</div>

{% schema %}
{
  "name": "Prime Founder Blog Post",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" }
      ],
      "default": "background-1"
    },
    {
      "type": "checkbox",
      "id": "show_byline",
      "label": "Show founder byline",
      "default": true
    },
    {
      "type": "text",
      "id": "byline_name",
      "label": "Byline name",
      "default": "Dipak Regmi"
    },
    {
      "type": "text",
      "id": "byline_role",
      "label": "Byline role",
      "default": "Founder & CEO, Prime Pet Food"
    },
    {
      "type": "textarea",
      "id": "key_insight",
      "label": "Key insight pull quote",
      "info": "Displayed as a highlighted callout at the top of the article."
    },
    {
      "type": "richtext",
      "id": "article_body",
      "label": "Article body",
      "info": "Full founder-voiced article content. Supports headings, lists, bold, italic."
    }
  ],
  "blocks": [
    {
      "type": "related_link",
      "name": "Related link",
      "settings": [
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Read more"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prime Founder Blog Post",
      "blocks": [
        {
          "type": "related_link",
          "settings": {
            "link_label": "How long do yak chews last for my dog?",
            "link_url": "/blogs/dog-behavior/how-long-do-yak-chews-last"
          }
        },
        {
          "type": "related_link",
          "settings": {
            "link_label": "Why yak chews beat rawhide every time",
            "link_url": "/blogs/dog-behavior/best-rawhide-alternative"
          }
        },
        {
          "type": "related_link",
          "settings": {
            "link_label": "Build your dog's chew profile",
            "link_url": "/pages/my-dog"
          }
        }
      ]
    }
  ]
}
{% endschema %}
