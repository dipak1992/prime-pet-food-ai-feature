<script type="application/json" data-onhow="{{ section_id }}">
  {
    "id": {{ section_id | json }},
    "autoplay": {{ section.settings.autoplay | times: 1000 | json }}
  }
</script>

<script data-onhow-external-js="{{ section_id }}" src="https://cdn.shopify.com/s/files/1/0577/7673/4361/files/flickity-2.3.0.pkgd.min.js?v=1671485005" defer></script>

<script data-onhow-js="{{ section_id }}" type="module" defer>
(function(){

  const onhow = {
    settings: {},
    load: function(section){
      const elem = section.querySelector(`#slider-${onhow.settings.id}`);
      const videos = Array.from(section.querySelectorAll('video'));
      const playButtons = Array.from(section.querySelectorAll('.onhow__play-button'));
      const soundButtons = Array.from(section.querySelectorAll('.onhow__sound-button'));

      const syncVideoButtons = function() {
        videos.forEach((video, index) => {
          const button = playButtons[index];
          if (!button) return;

          const isPlaying = !video.paused && !video.ended;
          button.classList.toggle('is-playing', isPlaying);
          button.setAttribute('aria-label', isPlaying ? 'Pause video' : 'Play video');
        });
      };

      const pauseOtherVideos = function(activeVideo) {
        videos.forEach((video) => {
          if (video !== activeVideo) video.pause();
        });
      };

      const toggleVideo = function(index) {
        const video = videos[index];
        if (!video) return;

        pauseOtherVideos(video);

        if (video.paused || video.ended) {
          const playPromise = video.play();
          if (playPromise && typeof playPromise.catch === 'function') {
            playPromise.catch(syncVideoButtons);
          }
        } else {
          video.pause();
        }

        syncVideoButtons();
      };

      videos.forEach((video) => {
        video.addEventListener('play', syncVideoButtons);
        video.addEventListener('pause', syncVideoButtons);
        video.addEventListener('ended', syncVideoButtons);
      });

      onhow.flkty = new Flickity( elem, {
        cellAlign: JSON.parse(getComputedStyle(section).getPropertyValue('--cell-align')),
        autoPlay: this.settings.autoplay,
        draggable: JSON.parse(getComputedStyle(section).getPropertyValue('--draggable')),
        contain: false, 
        wrapAround: JSON.parse(getComputedStyle(section).getPropertyValue('--wrap-around')),
        adaptiveHeight: false,
        watchCSS: false,
        imagesLoaded: true,
        prevNextButtons: false,
        pageDots: false,
        on: {
          staticClick: function( event, pointer, cellElement, cellIndex ) {
            if ( typeof cellIndex == 'number' ) {
              this.selectCell( cellIndex );
            }
          },
          change: function() {
            videos.forEach(video => video.pause());
            syncVideoButtons();
          },
          ready: () => {
            setTimeout(() => {
              elem.classList.add('onhow__stretch-height');
              syncVideoButtons();
            }, 500);
          }
        }
      });

      var previousButton = section.querySelector('.onhow__nav-button--prev');
      if (typeof previousButton != 'undefined' && previousButton != null) {
        previousButton.addEventListener( 'click', function() {
          onhow.flkty.previous();
        });
      }

      var nextButton = section.querySelector('.onhow__nav-button--next');
      if (typeof nextButton != 'undefined' && nextButton != null) {
        nextButton.addEventListener( 'click', function() {
          onhow.flkty.next();
        });
      }

      if (playButtons.length) {
        playButtons.forEach((button, index) => {
          button.addEventListener('click', function(event) {
            event.preventDefault();
            event.stopPropagation();

            if (onhow.flkty && onhow.flkty.selectedIndex !== index) {
              onhow.flkty.selectCell(index);
              window.setTimeout(() => toggleVideo(index), 80);
            } else {
              toggleVideo(index);
            }
          });
        });
      }

      if (typeof soundButtons != 'undefined' && soundButtons != null) {
        soundButtons.forEach((button, index) => {
          button.addEventListener('click', function(event) {
            event.preventDefault();
            event.stopPropagation();

            const selectedVideo = videos[index];
            if (selectedVideo) {
              const nextMuted = !selectedVideo.muted ? true : false;
              videos.forEach((video, videoIndex) => {
                const videoButton = soundButtons[videoIndex];
                video.muted = true;
                if (videoButton) {
                  videoButton.classList.remove('onhow__sound-button--on');
                  videoButton.setAttribute('aria-label', 'Turn sound on');
                }
              });

              selectedVideo.muted = nextMuted;
              if (!nextMuted) {
                button.classList.add('onhow__sound-button--on');
                button.setAttribute('aria-label', 'Turn sound off');
              } else {
                button.classList.remove('onhow__sound-button--on');
                button.setAttribute('aria-label', 'Turn sound on');
              }
            }
          });
        });
      }

    },
    unload: function(section){
    }
  }

  window.addEventListener('shopify:section:unload', function (e) {
    const settings = document.querySelector(`[data-onhow="${e.detail.sectionId}"]`);
    const sectionId = e.detail.sectionId;
    const section = document.querySelector(`#DP--${e.detail.sectionId}`);
    if (sectionId == onhow.settings.id){
      onhow.unload(section);
    }
  });

  onhow.settings = JSON.parse(document.querySelector('[data-onhow="{{ section_id }}"]').innerHTML);
  const sectionId = {{ section_id | json }};
  const section = document.querySelector(`#DP--${sectionId}`);

  if (sectionId == onhow.settings.id){
    onhow.load(section);
  }
})()
</script>
