{% comment %}
<!-- slide video section -->
{% endcomment %}
{%- assign section_id = section.id | replace: '+', '' -%}
{% assign videos = section.blocks | where: 'type', 'video' %}
{%- assign background_placeholder_video_id = '15bb622f402f43929d26fab60c13fd21' -%}
{%- assign widths = '180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1950, 2100, 2260, 2450, 2700, 3000, 3350, 3750, 4100' -%}
{%- liquid
  assign instagram_url = settings.social_instagram_link | default: 'https://www.instagram.com/foodprimepet/'
  assign tiktok_url = settings.social_tiktok_link | default: 'https://www.tiktok.com/@primepetfood'
-%}

{%- capture minify -%}

<style>
.flickity-enabled{position:relative}.flickity-enabled:focus{outline:0;box-shadow: none;}.flickity-viewport{overflow:hidden;position:relative;height:100%}.flickity-slider{position:absolute;width:100%;height:100%}.flickity-enabled.is-draggable{-webkit-tap-highlight-color:transparent;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none}.flickity-enabled.is-draggable .flickity-viewport{cursor:move;cursor:-webkit-grab;cursor:grab}.flickity-enabled.is-draggable .flickity-viewport.is-pointer-down{cursor:-webkit-grabbing;cursor:grabbing}.flickity-button{position:absolute;background:hsla(0,0%,100%,.75);border:none;color:#333}.flickity-button:hover{background:#fff;cursor:pointer}.flickity-button:focus{outline:0;box-shadow:0 0 0 5px #19f}.flickity-button:active{opacity:.6}.flickity-button:disabled{opacity:.3;cursor:auto;pointer-events:none}.flickity-button-icon{fill:currentColor}.flickity-prev-next-button{top:50%;width:44px;height:44px;border-radius:50%;transform:translateY(-50%)}.flickity-prev-next-button.previous{left:10px}.flickity-prev-next-button.next{right:10px}.flickity-rtl .flickity-prev-next-button.previous{left:auto;right:10px}.flickity-rtl .flickity-prev-next-button.next{right:auto;left:10px}.flickity-prev-next-button .flickity-button-icon{position:absolute;left:20%;top:20%;width:60%;height:60%}.flickity-page-dots{position:absolute;width:100%;bottom:-25px;padding:0;margin:0;list-style:none;text-align:center;line-height:1}.flickity-rtl .flickity-page-dots{direction:rtl}.flickity-page-dots .dot{display:inline-block;width:10px;height:10px;margin:0 8px;background:#333;border-radius:50%;opacity:.25;cursor:pointer}.flickity-page-dots .dot.is-selected{opacity:1}

{%- if section.settings.custom_font_url != blank -%}
@font-face {
  font-family: 'CustomHeadingFont';
  src: url('{{ section.settings.custom_font_url }}');
  font-display: swap;
}
{%- endif -%}

{%- if section.settings.override_theme_font != blank -%}
  #DP--{{ section_id }} {
    --main-font: {{ section.settings.main_font.family }}, {{ section.settings.main_font.fallback_families }};
    --main-font-weight: {{ section.settings.main_font.weight }};
    --main-font-style: {{ section.settings.main_font.style }};
    --heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --heading-font-weight: {{ section.settings.heading_font.weight }};
    --heading-font-style: {{ section.settings.heading_font.style }};
  }
{%- endif -%}

#DP--{{ section_id }} {
  --cell-align: "center";
  {% if section.blocks.size > 4 %}
  --wrap-around: true;
  --draggable: ">1";
  {% else %}
    --wrap-around: false;
    --draggable: false;
  {% endif %}
  --arrow-color: {{ section.settings.text_color }};
  background: {{ section.settings.background_color }};
  padding-top: {{ section.settings.top_padding }}px;
  padding-bottom: {{ section.settings.bottom_padding }}px;
  overflow: visible;
}

#DP--{{ section_id }} .onhow__sizer {
  width: 100%;
}

#DP--{{ section_id }} .onhow__section-title {
  text-align: center;
  margin-bottom: {% if section.settings.description != blank %}{{ section.settings.heading_description_spacing }}px{% else %}40px{% endif %};
  color: {{ section.settings.text_color }};
  font-size: calc(var(--dp-g-heading-size, var(--dp-heading-size, 28px)) * {{ section.settings.heading_size | times: 0.01 }});
  letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  {%- if section.settings.custom_font_url != blank -%}
  font-family: 'CustomHeadingFont', var(--font-heading-family);
  {%- endif -%}
}

#DP--{{ section_id }} .onhow__section-description {
  text-align: center;
  margin-bottom: 40px;
  color: {{ section.settings.text_color }};
  font-size: calc(var(--dp-g-body-size, var(--dp-body-size, 16px)) * {{ section.settings.description_size | times: 0.01 }});
  line-height: var(--dp-g-body-line-height, var(--dp-body-line-height, calc(3px + 2.5ex + 3px)));
}

#DP--{{ section_id }} .onhow__section-description p {
  margin: 0 0 1em 0;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

#DP--{{ section_id }} .onhow__section-description p:last-child {
  margin-bottom: 0;
}

#DP--{{ section_id }} .onhow__section-description strong {
  font-weight: bold;
  color: inherit;
}

#DP--{{ section_id }} .onhow__section-description em {
  font-style: italic;
  color: inherit;
}

#DP--{{ section_id }} .onhow__section-description a {
  color: inherit;
  text-decoration: underline;
}

#DP--{{ section_id }} .onhow__section-description ul,
#DP--{{ section_id }} .onhow__section-description ol {
  margin: 0 0 1em 0;
  padding-left: 1.5em;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

#DP--{{ section_id }} .onhow__section-description li {
  margin-bottom: 0.5em;
  color: inherit;
}

#DP--{{ section_id }} .onhow__flex--main {
  position: relative;
  align-items: center;
  grid-template-columns: repeat(auto-fill, minmax(50%, 1fr));
  grid-auto-rows: 50%;
  grid-auto-columns: minmax(0, auto);
}

#DP--{{ section_id }} .onhow__content {
  flex: 1 0 40%;
  padding: 20px;
}

#DP--{{ section_id }} .onhow__inner-content {
  width: min(400px, 80%);
  margin: auto;
}

#DP--{{ section_id }} .onhow__small-heading {
  margin: 0;
  text-align: center;
  color: {{ section.settings.text_color }};
  {%- if section.settings.override_theme_font != blank -%}
  font-family: var(--heading-font);
  font-weight: var(--heading-font-weight);
  font-style: var(--heading-font-style);
  {%- endif -%}
  font-size: calc(var(--dp-g-heading-size, var(--dp-heading-size, 18px)) * 0.9);
  line-height: var(--dp-g-small-heading-line-height, var(--dp-small-heading-line-height, calc(3px + 2ex + 3px)));
}

#DP--{{ section_id }} .onhow__block .onhow__small-heading {
  font-size: calc(var(--dp-g-small-heading-size, var(--dp-small-heading-size, 24px)) * {{ section.settings.text_size | times: 0.01 }});
  {%- if section.settings.override_theme_font != blank -%}
    font-family: var(--heading-font);
    font-weight: var(--heading-font-weight);
    font-style: var(--heading-font-style);
  {%- endif -%}
}

#DP--{{ section_id }} .onhow__rte p,
#DP--{{ section_id }} .onhow__rte ul {
  line-height: var(--dp-g-body-line-height, var(--dp-body-line-height, calc(3px + 2.5ex + 3px)));
  color: {{ section.settings.text_color }};
  font-size: calc(var(--dp-g-body-size, var(--dp-body-size, 18px)) * {{ section.settings.text_size | times: 0.01 }});
  {%- if section.settings.override_theme_font != blank -%}
  font-family: var(--main-font);
  font-weight: var(--main-font-weight);
  font-style: var(--main-font-style);
  {%- endif -%}
}

#DP--{{ section_id }} .onhow__block {
  color: {{ section.settings.text_color }};
}

#DP--{{ section_id }} .onhow__block + .onhow__block {
  margin-top: 15px;
}

#DP--{{ section_id }} .onhow__videos {
  flex: 1 0 60%;
  overflow: visible;
  padding-bottom: 20px;
}

#DP--{{ section_id }} .onhow__video-slider {
  margin: auto;
  overflow: visible !important;
  padding-bottom: 60px; 
}

#DP--{{ section_id }} .onhow__videos-wrapper,
#DP--{{ section_id }} .onhow__videos,
#DP--{{ section_id }} .onhow__flex--main,
#DP--{{ section_id }} .onhow__sizer,
#DP--{{ section_id }} .flickity-slider {
  overflow: visible !important;
}

#DP--{{ section_id }} .onhow__item {
  --final-slide-width: min(350px, 90vw);
  --slide-height: calc(var(--final-slide-width) * 1.32);
  --selected-slide-height: calc(var(--final-slide-width) * 1.32);
  height: auto;
  width: var(--final-slide-width);
  margin: 0 {{ section.settings.gap | divided_by: 2.0 }}px;
  margin-bottom: 25px;
  display: inline-block;
  overflow: visible;
  transition: all 0.2s ease;
  position: relative;
  z-index: 1;
}

#DP--{{ section_id }} .is-selected {
  transform: translateY(-4px);
  z-index: 50;
}

#DP--{{ section_id }} .onhow__item > a {
  text-decoration: none;
}

#DP--{{ section_id }} .onhow__stretch-height .onhow__item {
  height: 100%;
}

#DP--{{ section_id }} .is-selected .onhow__video-wrapper {
  padding-top: 0;
}

#DP--{{ section_id }} .onhow__video-inner {
    width: 100%;
}

#DP--{{ section_id }} .is-selected .onhow__hosted-video {
  width: 100%;
  min-height: var(--selected-slide-height);
  display: block;
  object-fit: cover;
}

#DP--{{ section_id }} .onhow__video {
  height: 100%;
  display: flex;
  text-align: center;
  align-items: flex-start;
  position: relative;
  overflow: visible;
}

#DP--{{ section_id }} .onhow__video-wrapper {
  width: 100%;
  padding-top: 0;
  transition: all 0.5s ease;
  position: relative;
  height: var(--slide-height);
}

#DP--{{ section_id }} .onhow__hosted-video {
  width: 100%;
  min-height: var(--slide-height);
  display: block;
  object-fit: cover;
  border-radius: 20px;
  transition: all 0.5s ease;
  box-shadow: 0 18px 46px rgba(18, 12, 8, 0.14);
}

#DP--{{ section_id }} .onhow__social-frame {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 20px;
}

#DP--{{ section_id }} .onhow__platform-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 4;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 30px;
  padding: 7px 11px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 999px;
  background: rgba(18, 12, 8, 0.62);
  color: #fffaf3;
  font-size: 11px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
  backdrop-filter: blur(14px);
}

#DP--{{ section_id }} .onhow__platform-badge::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: #e66711;
  box-shadow: 0 0 0 4px rgba(230, 103, 17, 0.22);
}

#DP--{{ section_id }} .onhow__video-content {
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  border-radius: 15px;
  height: 100%;
  padding: 15px 10px;
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  transition: all 0.2s linear;
  z-index: 2;
  background: linear-gradient(transparent 0%, rgba(0,0,0,0.3) 70%, rgba(0,0,0,0.6) 100%);
}

#DP--{{ section_id }} .onhow__absolute-link {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

#DP--{{ section_id }} .onhow__item:hover {
  transform: translateY(-2px);
  z-index: 100;
}

#DP--{{ section_id }} .onhow__video-content:hover {
  box-shadow: none;
}

#DP--{{ section_id }} .onhow__sound-button {
  appearance: none;
  cursor: pointer;
  background-color: rgba(255, 255, 255, 0.5);
  border: 0;
  border-radius: 50%;
  position: absolute;
  bottom: 0;
  right: 0;
  width: 35px;
  height: 35px;
  margin: 10px;
  padding: 5px;
  background-image: url("data:image/svg+xml,%3Csvg width='24' height='24' xmlns='http://www.w3.org/2000/svg' fill-rule='evenodd' clip-rule='evenodd'%3E%3Cpath d='M18 23l-9.305-5.998.835-.651 7.47 4.815v-10.65l1-.781v13.265zm0-15.794l5.384-4.206.616.788-23.384 18.264-.616-.788 5.46-4.264h-2.46v-10h5.691l9.309-6v6.206zm-11.26 8.794l1.26-.984v-7.016h-4v8h2.74zm10.26-8.013v-5.153l-8 5.157v6.244l8-6.248z'/%3E%3C/svg%3E");
  background-size: 65%;
  background-position: center center;
  background-repeat: no-repeat;
  z-index: 5;
}

#DP--{{ section_id }} .onhow__sound-button--on {
  background-image: url("data:image/svg+xml,%3Csvg width='24' height='24' xmlns='http://www.w3.org/2000/svg' fill-rule='evenodd' clip-rule='evenodd'%3E%3Cpath d='M15 23l-9.309-6h-5.691v-10h5.691l9.309-6v22zm-9-15.009v8.018l8 5.157v-18.332l-8 5.157zm14.228-4.219c2.327 1.989 3.772 4.942 3.772 8.229 0 3.288-1.445 6.241-3.77 8.229l-.708-.708c2.136-1.791 3.478-4.501 3.478-7.522s-1.342-5.731-3.478-7.522l.706-.706zm-2.929 2.929c1.521 1.257 2.476 3.167 2.476 5.299 0 2.132-.955 4.042-2.476 5.299l-.706-.706c1.331-1.063 2.182-2.729 2.182-4.591 0-1.863-.851-3.529-2.184-4.593l.708-.708zm-12.299 1.299h-4v8h4v-8z'/%3E%3C/svg%3E");
}

#DP--{{ section_id }} .onhow__play-button {
  appearance: none;
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 6;
  width: 58px;
  height: 58px;
  border: 1px solid rgba(255, 250, 243, 0.72);
  border-radius: 999px;
  background: rgba(43, 20, 8, 0.74);
  color: #fffaf3;
  cursor: pointer;
  transform: translate(-50%, -50%);
  box-shadow: 0 16px 34px rgba(0, 0, 0, 0.24);
  transition: transform 0.2s ease, background 0.2s ease, opacity 0.2s ease;
}

#DP--{{ section_id }} .onhow__play-button:hover {
  background: rgba(225, 102, 16, 0.88);
  transform: translate(-50%, -50%) scale(1.04);
}

#DP--{{ section_id }} .onhow__play-button::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 52%;
  width: 0;
  height: 0;
  border-top: 12px solid transparent;
  border-bottom: 12px solid transparent;
  border-left: 18px solid currentColor;
  transform: translate(-50%, -50%);
}

#DP--{{ section_id }} .onhow__play-button.is-playing::before,
#DP--{{ section_id }} .onhow__play-button.is-playing::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 6px;
  height: 23px;
  border: 0;
  background: currentColor;
  transform: translateY(-50%);
}

#DP--{{ section_id }} .onhow__play-button.is-playing::before {
  left: 21px;
}

#DP--{{ section_id }} .onhow__play-button.is-playing::after {
  left: 31px;
}

#DP--{{ section_id }} .onhow__play-button.is-playing {
  opacity: 0;
}

#DP--{{ section_id }} .onhow__video-wrapper:hover .onhow__play-button.is-playing,
#DP--{{ section_id }} .onhow__video-wrapper:focus-within .onhow__play-button.is-playing {
  opacity: 1;
}

#DP--{{ section_id }} .onhow__text-area {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  width: 100%;
  align-items: center;
  justify-content: flex-end;
  color: white;
}

#DP--{{ section_id }} .onhow__text-area .onhow__text {
  color: white;
}

#DP--{{ section_id }} .onhow__text-area .onhow__text p {
  color: white;
  margin: 0 0 8px 0;
  font-weight: 600;
}

#DP--{{ section_id }} .onhow__view-product {
  display: inline-block;
  padding: 8px 16px;
  background: {{ section.settings.button_bg_color }};
  color: {{ section.settings.button_text_color }};
  border-radius: 4px;
  margin-top: 5px;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
}

#DP--{{ section_id }} .onhow__share-card {
  width: min(760px, calc(100% - 32px));
  margin: 4px auto 0;
  padding: 22px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 18px;
  align-items: center;
  border: 1px solid rgba(18, 18, 18, 0.1);
  border-radius: 16px;
  background: #fffaf3;
  color: #221a14;
  box-shadow: 0 18px 42px rgba(30, 22, 15, 0.08);
}

#DP--{{ section_id }} .onhow__share-card strong,
#DP--{{ section_id }} .onhow__share-card span {
  display: block;
}

#DP--{{ section_id }} .onhow__share-card strong {
  font-size: 18px;
  line-height: 1.22;
  font-weight: 800;
}

#DP--{{ section_id }} .onhow__share-card span {
  margin-top: 6px;
  color: #6f6257;
  font-size: 14px;
  line-height: 1.5;
}

#DP--{{ section_id }} .onhow__share-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

#DP--{{ section_id }} .onhow__share-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 11px 15px;
  border-radius: 999px;
  background: #1f1a16;
  color: #fff;
  text-decoration: none;
  font-size: 13px;
  line-height: 1;
  font-weight: 800;
}

#DP--{{ section_id }} .onhow__share-link--secondary {
  background: #e66711;
}

#DP--{{ section_id }} .onhow__videos-nav {
  width: fit-content;
  margin: 0 auto;
  display: flex;
  gap: 20px;
  margin-top: {{ section.settings.navigation_spacing }}px;
  position: relative;
  z-index: 5;
}

#DP--{{ section_id }} .onhow__nav-button {
  cursor: pointer;
  width: 38px;
  height: 38px;
  transform: scale(1.6);
  transition: all 0.3s ease;
}

#DP--{{ section_id }} .onhow__rte p,
#DP--{{ section_id }} .onhow__rte ul {
  color: {{ section.settings.text_color }};
}

#DP--{{ section_id }} .onhow__small-heading {
  color: {{ section.settings.text_color }};
}

#DP--{{ section_id }} .onhow__videos-wrapper:after {
  content: 'flickity';
  display: none;
}

#DP--{{ section_id }} .onhow__videos-wrapper:not(.flickity-enabled) {
  display: flex;
  gap: 10px;
  overflow: visible;
}

#DP--{{ section_id }} .onhow__videos-wrapper {
  overflow: visible;
}

#DP--{{ section_id }} .onhow__videos-wrapper:not(.flickity-enabled) .onhow__item:nth-child(n+{{ section.settings.per_row | plus: 1 }}){
  display: none;
}

#DP--{{ section_id }} .flickity-slider {
  top: 0;
}

@media (max-width: 768px) {
  #DP--{{ section_id }} {
    padding-top: {{ section.settings.top_padding | divided_by: 2 }}px;
    padding-bottom: {{ section.settings.bottom_padding | divided_by: 2 }}px;
    --draggable: ">1";
    --wrap-around: true;
  }

  #DP--{{ section_id }} .onhow__sizer {
    margin: 0 auto;
  }

  #DP--{{ section_id }} .onhow__video-slider {
    padding-bottom: 45px;
  }

  #DP--{{ section_id }} .onhow__item {
    --final-slide-width: min(280px, 85vw);
    --slide-height: calc(var(--final-slide-width) * 1.2);
    --selected-slide-height: calc(var(--final-slide-width) * 1.2);
    max-height: 50vh;
    margin-bottom: 20px;
  }

  #DP--{{ section_id }} .onhow__hosted-video {
    max-height: 45vh;
    object-fit: cover;
  }

  #DP--{{ section_id }} .onhow__section-title {
    font-size: calc(var(--dp-g-heading-size, var(--dp-heading-size, 24px)) * {{ section.settings.heading_size | times: 0.01 }});
    margin-bottom: {% if section.settings.description != blank %}{{ section.settings.heading_description_spacing | divided_by: 2 }}px{% else %}25px{% endif %};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  }

  #DP--{{ section_id }} .onhow__section-description {
    font-size: calc(var(--dp-g-body-size, var(--dp-body-size, 14px)) * {{ section.settings.description_size | times: 0.01 }});
    margin-bottom: 25px;
  }

  #DP--{{ section_id }} .onhow__nav-button {
    transform: scale(1.2);
  }

  #DP--{{ section_id }} .onhow__play-button {
    width: 54px;
    height: 54px;
  }

  #DP--{{ section_id }} .onhow__play-button.is-playing {
    opacity: 0.88;
  }

  #DP--{{ section_id }} .onhow__videos-nav {
    margin-top: {{ section.settings.navigation_spacing | divided_by: 1.5 }}px;
  }

  #DP--{{ section_id }} .onhow__share-card {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 20px 16px;
  }

  #DP--{{ section_id }} .onhow__share-actions {
    justify-content: center;
  }
}
</style>

{%- liquid
  if videos.size == 0
    break
  endif
-%}

<section id="DP--{{ section_id }}" class="DP--{{ section_id }} onhow__videos-slider onhow__section">
  {%- if section.settings.anchor_id != blank -%}
    <div id="{{ section.settings.anchor_id | remove: '#' | handleize }}" class="onhow__anchor-id" style="height: 0; overflow: hidden;"></div>
  {%- endif -%}
  <div class="onhow__sizer">
    {% if section.settings.heading != blank %}
      <h2 class="onhow__section-title">{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% if section.settings.description != blank %}
      <div class="onhow__section-description">{{ section.settings.description }}</div>
    {% endif %}

    <div class="onhow__flex onhow__flex--main">
      <div class="onhow__videos">
        <div id="slider-{{ section_id }}" class="onhow__videos-wrapper onhow__video-slider">
          {%- for block in videos -%}
            <div class="onhow__item onhow__item onhow__video-{{ forloop.index }} onhow__block-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="onhow__video">
                <div class="onhow__video-inner">
                  {%- if block.settings.html5_video != blank -%}
                    <div class="onhow__video-wrapper">
                      {%- assign video = block.settings.html5_video -%}
                      <video class="onhow__hosted-video" width="{{ video.aspect_ratio | times: 100 }}" height="100" playsinline loop muted loading="lazy" poster="{{ video.preview_image | image_url: width: 2800 }}">
                        {%- for source in video.sources -%}
                          {%- if source.format == 'mp4' or source.format == 'mov' -%}<source src="{{ source.url }}">{%- endif -%}
                        {%- endfor -%}
                      </video>
                      <div class="onhow__social-frame" aria-hidden="true"></div>
                      <div class="onhow__platform-badge">{%- if forloop.index0 == 1 or forloop.index0 == 3 or forloop.index0 == 5 -%}TikTok{%- else -%}Instagram{%- endif -%}</div>
                      <button class="onhow__play-button" type="button" aria-label="Play video"></button>
                      <button class="onhow__sound-button" type="button" aria-label="Turn sound on"></button>
                    </div>
                  {%- else -%}
         
                  <div class="onhow__video-wrapper">
                    <video
                      class="onhow__hosted-video"
                      width="2000" height="100"
                      playsinline loop muted loading="lazy">
                        <source src="https://cdn.shopify.com/videos/c/o/v/{{ background_placeholder_video_id }}.mp4" data-onhow-default-src>
                    </video>
                    <div class="onhow__social-frame" aria-hidden="true"></div>
                    <div class="onhow__platform-badge">{%- if forloop.index0 == 1 or forloop.index0 == 3 or forloop.index0 == 5 -%}TikTok{%- else -%}Instagram{%- endif -%}</div>
                    <button class="onhow__play-button" type="button" aria-label="Play video"></button>
                    <button class="onhow__sound-button" type="button" aria-label="Turn sound on"></button>
                  </div>
                  {%- endif -%}
                  {%- unless block.settings.product == blank -%}
                    <div class="onhow__video-content">
                      <a href="{{ block.settings.product.url }}" class="onhow__absolute-link"></a>
                      <div class="onhow__text-area">
                        <div class="onhow__text onhow__rte">
                          <p>{{ block.settings.caption | default: block.settings.product.title }}</p>
                        </div>
                        <a href="{{ block.settings.product.url }}" class="onhow__view-product">Shop the chew</a>
                      </div>
                    </div>
                  {%- endunless -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.show_arrows != blank -%}
          <div class="onhow__videos-nav">
            <div class="onhow__nav-button onhow__nav-button--prev">
              <svg width="25" height="25" xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd" clip-rule="evenodd"><path d="M12 0c6.623 0 12 5.377 12 12s-5.377 12-12 12-12-5.377-12-12 5.377-12 12-12zm0 1c6.071 0 11 4.929 11 11s-4.929 11-11 11-11-4.929-11-11 4.929-11 11-11zm3 5.753l-6.44 5.247 6.44 5.263-.678.737-7.322-6 7.335-6 .665.753z" fill="none" stroke="#121212"/></svg>
            </div>
            <div class="onhow__nav-button onhow__nav-button--next">
              <svg width="25" height="25" xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd" clip-rule="evenodd"><path d="M12 0c6.623 0 12 5.377 12 12s-5.377 12-12 12-12-5.377-12-12 5.377-12 12-12zm0 1c6.071 0 11 4.929 11 11s-4.929 11-11 11-11-4.929-11-11 4.929-11 11-11zm-3 5.753l6.44 5.247-6.44 5.263.678.737 7.322-6-7.335-6-.665.753z" fill="none" stroke="#121212"/></svg>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.show_share_cta -%}
      <div class="onhow__share-card">
        <div>
          <strong>{{ section.settings.share_heading | default: "Share your dog's calm-time moment" }}</strong>
          <span>{{ section.settings.share_text | default: "Post your dog with their Prime yak chew and tag us on Instagram or TikTok for a chance to be featured." }}</span>
        </div>
        <div class="onhow__share-actions">
          <a href="{{ instagram_url }}" class="onhow__share-link" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="{{ tiktok_url }}" class="onhow__share-link onhow__share-link--secondary" target="_blank" rel="noopener noreferrer">TikTok</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endcapture -%}
{{ minify | strip_newlines }}

