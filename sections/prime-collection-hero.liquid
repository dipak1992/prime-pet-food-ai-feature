<section class="pch-hero" aria-label="{{ collection.title }} collection">
  <div class="pch-hero__inner">

    <div class="pch-shell pch-hero__content">
      <div class="pch-hero__text">
        <p class="pch-kicker">{{ section.settings.eyebrow | default: 'All Prime Pet Food chews' }}</p>
        <h1>{{ section.settings.heading | default: collection.title }}</h1>
        {% if section.settings.subheading != blank %}
          <p class="pch-hero__sub">{{ section.settings.subheading }}</p>
        {% elsif collection.description != blank %}
          <p class="pch-hero__sub">{{ collection.description | strip_html | truncate: 180 }}</p>
        {% endif %}
        <div class="pch-hero__pills" aria-label="Key benefits">
          <span>
            {% render 'prime-blueprint-icon', name: 'safety', size: 13 %}
            Rawhide-free
          </span>
          <span>
            {% render 'prime-blueprint-icon', name: 'chew-time', size: 13 %}
            Classic, flavour, bulk, sizes
          </span>
          <span>
            {% render 'prime-blueprint-icon', name: 'ingredients', size: 13 %}
            Choose by dog fit
          </span>
          <span>
            {% render 'prime-blueprint-icon', name: 'love', size: 13 %}
            {{ collection.all_products_count }} product{% if collection.all_products_count != 1 %}s{% endif %} to compare
          </span>
        </div>
        <div class="pch-size-nav" aria-label="Shop by dog size">
          <a href="#product-grid" data-size-filter="Small">Small<br><span>1–15 lbs</span></a>
          <a href="#product-grid" data-size-filter="Medium">Medium<br><span>15–35 lbs</span></a>
          <a href="#product-grid" data-size-filter="Large">Large<br><span>35–55 lbs</span></a>
          <a href="#product-grid" data-size-filter="Extra Large">XL<br><span>55–85 lbs</span></a>
          <a href="#product-grid" data-size-filter="Jumbo">Jumbo<br><span>85+ lbs</span></a>
        </div>

        <p class="pch-product-count" role="status" aria-live="polite">
          {%- if collection.products_count < collection.all_products_count -%}
            Showing <strong>{{ collection.products_count }}</strong> of <strong>{{ collection.all_products_count }}</strong> products
            &nbsp;&mdash;&nbsp;<a href="{{ collection.url }}" class="pch-product-count__clear">Clear filters</a>
          {%- else -%}
            <strong>{{ collection.all_products_count }}</strong> product{% if collection.all_products_count != 1 %}s{% endif %} available
          {%- endif -%}
        </p>
      </div>

    </div>

  </div>

  <div class="pch-trust-bar" aria-label="Trust signals">
    <div class="pch-shell pch-trust-bar__inner">
      <div class="pch-trust-bar__item">
        {% render 'prime-blueprint-icon', name: 'ingredients', size: 18 %}
        <span>Simple ingredient promise</span>
      </div>
      <div class="pch-trust-bar__divider" aria-hidden="true"></div>
      <div class="pch-trust-bar__item">
        {% render 'prime-blueprint-icon', name: 'review', size: 18 %}
        <span>4.9&#9733; from 2,400+ reviews</span>
      </div>
      <div class="pch-trust-bar__divider" aria-hidden="true"></div>
      <div class="pch-trust-bar__item">
        {% render 'prime-blueprint-icon', name: 'shipping', size: 18 %}
        <span>Free shipping over $30</span>
      </div>
      <div class="pch-trust-bar__divider" aria-hidden="true"></div>
      <div class="pch-trust-bar__item">
        {% render 'prime-blueprint-icon', name: 'guarantee', size: 18 %}
        <span>30-day satisfaction guarantee</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════
     PRIME COLLECTION HERO
  ════════════════════════════════════════════════════════════════ */
  .pch-hero {
    --pch-ink: #171512;
    --pch-cream: #fffaf2;
    --pch-clay: #b85f32;
    --pch-clay-dark: #94451f;
    --pch-muted: #5f574e;
    --pch-line: rgba(55, 43, 31, 0.13);
    font-family: var(--prime-font-sans, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  }

  /* Product count indicator */
  .pch-product-count {
    margin: 12px 0 0;
    font-size: 13px;
    color: #5f574e;
    line-height: 1.4;
  }

  .pch-product-count strong {
    color: #171512;
    font-weight: 700;
  }

  .pch-product-count__clear {
    color: #b85f32;
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .pch-product-count__clear:hover {
    color: #94451f;
  }

  .pch-switch {
    background: #fff;
    border-bottom: 1px solid rgba(55, 43, 31, 0.12);
    padding: 22px 0;
    font-family: var(--prime-font-sans, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  }

  .pch-hero * { box-sizing: border-box; }

  .pch-shell {
    width: min(1160px, calc(100% - 32px));
    margin: 0 auto;
  }

  /* ═══════════════════════════════════════════════════════════════
     HERO LAYOUT
  ════════════════════════════════════════════════════════════════ */
  .pch-hero__inner {
    position: relative;
    min-height: 0;
    display: grid;
    overflow: hidden;
    isolation: isolate;
    background:
      linear-gradient(135deg, rgba(184, 95, 50, 0.08), rgba(255, 250, 242, 0) 48%),
      var(--pch-cream);
    border-bottom: 1px solid var(--pch-line);
  }

  .pch-hero__content {
    padding: 42px 0 34px;
    display: block;
  }

  /* ═══════════════════════════════════════════════════════════════
     HERO TEXT
  ════════════════════════════════════════════════════════════════ */
  .pch-kicker {
    margin: 0 0 10px;
    color: var(--pch-clay, #b85f32);
    font-size: 11px;
    font-weight: 780;
    letter-spacing: var(--prime-kicker-letter-spacing, 0.08em);
    text-transform: uppercase;
  }

  .pch-hero__text h1 {
    margin: 0;
    color: var(--pch-ink, #171512);
    font-family: var(--prime-font-display, var(--prime-font-sans, inherit));
    font-size: clamp(32px, 4.2vw, 52px);
    font-weight: 760;
    line-height: 1.04;
    letter-spacing: 0;
    max-width: 760px;
  }

  .pch-hero__sub {
    margin: 14px 0 0;
    color: var(--pch-muted, #5f574e);
    font-size: 16px;
    line-height: 1.6;
    max-width: 660px;
  }

  .pch-hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .pch-size-nav {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
    margin-top: 22px;
    max-width: 760px;
  }

  .pch-size-nav a {
    min-height: 54px;
    padding: 10px 8px;
    border: 1px solid rgba(55, 43, 31, 0.12);
    border-radius: 8px;
    background: #fff;
    color: var(--pch-ink, #171512);
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 760;
    line-height: 1.15;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .pch-size-nav a:hover {
    border-color: rgba(184, 95, 50, 0.45);
    box-shadow: 0 10px 28px rgba(23, 59, 43, 0.08);
    transform: translateY(-1px);
  }

  .pch-size-nav span {
    color: var(--pch-muted, #5f574e);
    font-size: 11px;
    font-weight: 620;
  }

  .pch-switch__inner {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    gap: 18px;
    align-items: center;
  }

  .pch-switch h2 {
    margin: 0;
    color: var(--pch-ink, #171512);
    font-family: var(--prime-font-display, var(--prime-font-serif, Georgia, serif));
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .pch-switch__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .pch-switch__grid article {
    padding: 16px;
    border: 1px solid rgba(55, 43, 31, 0.12);
    border-radius: 8px;
    background: #fffaf2;
  }

  .pch-switch__grid strong,
  .pch-switch__grid span {
    display: block;
  }

  .pch-switch__grid strong {
    color: var(--pch-ink, #171512);
    font-size: 14px;
    font-weight: 820;
  }

  .pch-switch__grid span {
    margin-top: 5px;
    color: var(--pch-muted, #5f574e);
    font-size: 12px;
    line-height: 1.45;
  }

  .pch-hero__pills span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 13px;
    border-radius: 999px;
    border: 1px solid rgba(55, 43, 31, 0.12);
    background: #ffffff;
    color: var(--pch-ink, #171512);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
  }

  .pch-hero__pills svg {
    flex-shrink: 0;
    opacity: 0.85;
  }

  /* ═══════════════════════════════════════════════════════════════
     TRUST BAR
  ════════════════════════════════════════════════════════════════ */
  .pch-trust-bar {
    background: #fff;
    border-bottom: 1px solid var(--pch-line, rgba(55, 43, 31, 0.13));
    padding: 10px 0;
  }

  .pch-trust-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
  }

  .pch-trust-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    color: var(--pch-ink, #171512);
    font-size: 13px;
    font-weight: 600;
  }

  .pch-trust-bar__item svg {
    color: var(--pch-clay, #b85f32);
    flex-shrink: 0;
  }

  .pch-trust-bar__divider {
    width: 1px;
    height: 20px;
    background: var(--pch-line, rgba(55, 43, 31, 0.13));
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════════════════════════════
     SHOP BY NEED INTRO
  ════════════════════════════════════════════════════════════════ */
  .pch-need-intro {
    padding: 34px 0;
    background: #ffffff;
    border-bottom: 1px solid rgba(55, 43, 31, 0.1);
    font-family: var(--prime-font-sans, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  }

  .pch-need-intro * { box-sizing: border-box; }

  .pch-need-intro__inner {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.2fr);
    gap: 22px;
    align-items: start;
  }

  .pch-need-intro__copy h2 {
    margin: 0;
    max-width: 460px;
    color: #171512;
    font-family: var(--prime-font-display, var(--prime-font-serif, Georgia, serif));
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .pch-need-intro__copy p:not(.pch-kicker) {
    margin: 12px 0 0;
    max-width: 520px;
    color: #5f574e;
    font-size: 15px;
    line-height: 1.6;
  }

  .pch-need-intro__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .pch-need-card {
    display: grid;
    align-content: start;
    min-height: 188px;
    padding: 18px;
    border: 1px solid rgba(55, 43, 31, 0.12);
    border-radius: 12px;
    background: #fffaf2;
    color: #171512;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .pch-need-card:hover {
    border-color: rgba(184, 95, 50, 0.38);
    box-shadow: 0 14px 34px rgba(23, 59, 43, 0.08);
    transform: translateY(-1px);
  }

  .pch-need-card span {
    color: #b85f32;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pch-need-card strong {
    display: block;
    margin-top: 14px;
    color: #171512;
    font-size: 20px;
    line-height: 1.12;
  }

  .pch-need-card p {
    margin: 10px 0 0;
    color: #5f574e;
    font-size: 13px;
    line-height: 1.55;
  }

  /* ═══════════════════════════════════════════════════════════════
     SIZE GUIDE SECTION
  ════════════════════════════════════════════════════════════════ */
  .pch-size-guide {
    padding: 56px 0 48px;
    background: #fffaf2;
    border-bottom: 1px solid rgba(55, 43, 31, 0.1);
    font-family: var(--prime-font-sans, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  }

  .pch-size-guide * { box-sizing: border-box; }

  .pch-size-guide__header {
    max-width: 680px;
    margin: 0 0 36px;
  }

  .pch-size-guide__header h2 {
    margin: 0 0 12px;
    color: #171512;
    font-family: var(--prime-font-display, var(--prime-font-serif, Georgia, serif));
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 760;
    line-height: 1.06;
    letter-spacing: 0;
  }

  .pch-size-guide__intro {
    margin: 0;
    color: #5f574e;
    font-size: 15px;
    line-height: 1.65;
  }

  .pch-size-guide__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .pch-size-card {
    background: #fff;
    border: 1px solid rgba(55, 43, 31, 0.12);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .pch-size-card:hover {
    box-shadow: 0 12px 32px rgba(23, 59, 43, 0.1);
    transform: translateY(-2px);
  }

  .pch-size-card__badge {
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }

  .pch-size-card__badge--small  { background: #7a9e7e; }
  .pch-size-card__badge--medium { background: #5c8a6a; }
  .pch-size-card__badge--large  { background: #b85f32; }
  .pch-size-card__badge--xl     { background: #94451f; }
  .pch-size-card__badge--jumbo  { background: #171512; }

  .pch-size-card__body {
    padding: 16px;
  }

  .pch-size-card__weight {
    margin: 0 0 8px;
    color: #5f574e;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pch-size-card__body h3 {
    margin: 0 0 10px;
    color: #171512;
    font-size: 15px;
    font-weight: 760;
    line-height: 1.25;
  }

  .pch-size-card__body p {
    margin: 0 0 12px;
    color: #5f574e;
    font-size: 13px;
    line-height: 1.6;
  }

  .pch-size-card__tags {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .pch-size-card__tags li {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    color: #3d6b4f;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }

  .pch-size-card__tags li::before {
    content: "✓";
    flex-shrink: 0;
    font-weight: 800;
    color: #3d6b4f;
  }

  /* ═══════════════════════════════════════════════════════════════
     CHEW GUIDE SECTION
  ════════════════════════════════════════════════════════════════ */
  .pch-chew-guide {
    padding: 56px 0 48px;
    background: #fff;
    border-bottom: 1px solid rgba(55, 43, 31, 0.1);
    font-family: var(--prime-font-sans, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  }

  .pch-chew-guide * { box-sizing: border-box; }

  .pch-chew-guide__header {
    max-width: 640px;
    margin: 0 0 36px;
  }

  .pch-chew-guide__header h2 {
    margin: 0 0 10px;
    color: #171512;
    font-family: var(--prime-font-display, var(--prime-font-serif, Georgia, serif));
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 760;
    line-height: 1.06;
  }

  .pch-chew-guide__sub {
    margin: 0;
    color: #5f574e;
    font-size: 15px;
    line-height: 1.6;
  }

  .pch-chew-guide__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .pch-chew-type {
    position: relative;
    padding: 24px;
    border: 1px solid rgba(55, 43, 31, 0.12);
    border-radius: 14px;
    background: #fffaf2;
  }

  .pch-chew-type--featured {
    border-color: rgba(184, 95, 50, 0.35);
    background: #fff7ee;
    box-shadow: 0 4px 20px rgba(184, 95, 50, 0.1);
  }

  .pch-chew-type__badge {
    display: inline-block;
    margin-bottom: 14px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #b85f32;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .pch-chew-type__icon {
    font-size: 28px;
    margin-bottom: 10px;
    line-height: 1;
  }

  .pch-chew-type h3 {
    margin: 0 0 10px;
    color: #171512;
    font-size: 18px;
    font-weight: 760;
    line-height: 1.2;
  }

  .pch-chew-type__desc {
    margin: 0 0 16px;
    color: #5f574e;
    font-size: 13px;
    line-height: 1.6;
  }

  .pch-chew-type__rec {
    margin-bottom: 16px;
    padding: 12px 14px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid rgba(55, 43, 31, 0.1);
  }

  .pch-chew-type__label {
    display: block;
    margin-bottom: 4px;
    color: #b85f32;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pch-chew-type__rec strong {
    color: #171512;
    font-size: 13px;
    font-weight: 760;
    line-height: 1.35;
  }

  .pch-chew-type__tips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pch-chew-type__tips li {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    color: #5f574e;
    font-size: 12px;
    line-height: 1.45;
  }

  .pch-chew-type__tips li::before {
    content: "→";
    flex-shrink: 0;
    color: #b85f32;
    font-weight: 700;
  }

  /* ═══════════════════════════════════════════════════════════════
     COMPARISON TABLE SECTION
  ════════════════════════════════════════════════════════════════ */
  .pch-comparison {
    padding: 56px 0 48px;
    background: #fffaf2;
    border-bottom: 1px solid rgba(55, 43, 31, 0.1);
    font-family: var(--prime-font-sans, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  }

  .pch-comparison * { box-sizing: border-box; }

  .pch-comparison__header {
    max-width: 640px;
    margin: 0 0 32px;
  }

  .pch-comparison__header h2 {
    margin: 0;
    color: #171512;
    font-family: var(--prime-font-display, var(--prime-font-serif, Georgia, serif));
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 760;
    line-height: 1.06;
  }

  .pch-comparison__table-wrap {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid rgba(55, 43, 31, 0.12);
    background: #fff;
  }

  .pch-comparison__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.4;
  }

  .pch-comparison__table thead th {
    padding: 14px 16px;
    text-align: left;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #5f574e;
    border-bottom: 2px solid rgba(55, 43, 31, 0.1);
    white-space: nowrap;
  }

  .pch-comparison__col--prime {
    background: rgba(184, 95, 50, 0.06);
  }

  .pch-comparison__table thead th.pch-comparison__col--prime {
    color: #b85f32;
    background: rgba(184, 95, 50, 0.1);
  }

  .pch-comparison__table tbody td {
    padding: 13px 16px;
    color: #171512;
    border-bottom: 1px solid rgba(55, 43, 31, 0.07);
    vertical-align: middle;
  }

  .pch-comparison__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .pch-comparison__table tbody td:first-child {
    font-weight: 700;
    color: #5f574e;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .pch-check  { color: #3d6b4f; font-weight: 800; margin-right: 4px; }
  .pch-cross  { color: #9a3412; font-weight: 800; margin-right: 4px; }
  .pch-neutral { color: #8a7e72; font-weight: 700; margin-right: 4px; }

  .pch-comparison__footnote {
    margin: 14px 0 0;
    color: #8a7e72;
    font-size: 11px;
    line-height: 1.5;
  }

  /* ═══════════════════════════════════════════════════════════════
     RESPONSIVE — Tablet
