<section class="pch-hero" aria-label="{{ collection.title }} collection">
  <div class="pch-hero__inner">

    <div class="pch-shell pch-hero__content">
      <div class="pch-hero__text">
        <p class="pch-kicker">{{ section.settings.eyebrow | default: 'Premium Himalayan yak chews' }}</p>
        <h1>{{ section.settings.heading | default: collection.title }}</h1>
        {% if section.settings.subheading != blank %}
          <p class="pch-hero__sub">{{ section.settings.subheading }}</p>
        {% elsif collection.description != blank %}
          <p class="pch-hero__sub">{{ collection.description | strip_html | truncate: 180 }}</p>
        {% endif %}
        <div class="pch-hero__pills" aria-label="Key benefits">
          <span>
            {% render 'prime-blueprint-icon', name: 'safety', size: 13 %}
            Rawhide-free
          </span>
          <span>
            {% render 'prime-blueprint-icon', name: 'chew-time', size: 13 %}
            Lasts 45–90 min avg
          </span>
          <span>
            {% render 'prime-blueprint-icon', name: 'ingredients', size: 13 %}
            4 simple ingredients
          </span>
          <span>
            {% render 'prime-blueprint-icon', name: 'love', size: 13 %}
            20,000+ dog parents
          </span>
        </div>
        <div class="pch-size-nav" aria-label="Shop by dog size">
          <a href="#product-grid" data-size-filter="Small">Small<br><span>1–15 lbs</span></a>
          <a href="#product-grid" data-size-filter="Medium">Medium<br><span>15–35 lbs</span></a>
          <a href="#product-grid" data-size-filter="Large">Large<br><span>35–55 lbs</span></a>
          <a href="#product-grid" data-size-filter="Extra Large">XL<br><span>55–85 lbs</span></a>
          <a href="#product-grid" data-size-filter="Jumbo">Jumbo<br><span>85+ lbs</span></a>
        </div>

        <p class="pch-product-count" role="status" aria-live="polite">
          {%- if collection.products_count < collection.all_products_count -%}
            Showing <strong>{{ collection.products_count }}</strong> of <strong>{{ collection.all_products_count }}</strong> products
            &nbsp;&mdash;&nbsp;<a href="{{ collection.url }}" class="pch-product-count__clear">Clear filters</a>
          {%- else -%}
            <strong>{{ collection.all_products_count }}</strong> product{% if collection.all_products_count != 1 %}s{% endif %} available
          {%- endif -%}
        </p>
      </div>
    </div>

  </div>

  <div class="pch-trust-bar" aria-label="Trust signals">
    <div class="pch-shell pch-trust-bar__inner">
      <div class="pch-trust-bar__item">
        {% render 'prime-blueprint-icon', name: 'ingredients', size: 18 %}
        <span>Vet-approved ingredients</span>
      </div>
      <div class="pch-trust-bar__divider" aria-hidden="true"></div>
      <div class="pch-trust-bar__item">
        {% render 'prime-blueprint-icon', name: 'review', size: 18 %}
        <span>4.9&#9733; from 2,400+ reviews</span>
      </div>
      <div class="pch-trust-bar__divider" aria-hidden="true"></div>
      <div class="pch-trust-bar__item">
        {% render 'prime-blueprint-icon', name: 'shipping', size: 18 %}
        <span>Free shipping over $30</span>
      </div>
      <div class="pch-trust-bar__divider" aria-hidden="true"></div>
      <div class="pch-trust-bar__item">
        {% render 'prime-blueprint-icon', name: 'guarantee', size: 18 %}
        <span>30-day satisfaction guarantee</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     EMOTIONAL CATEGORY INTROS + SIZE RECOMMENDATIONS
════════════════════════════════════════════════════════════════ -->
<section class="pch-size-guide" aria-label="Find the right chew for your dog">
  <div class="pch-shell">
    <div class="pch-size-guide__header">
      <p class="pch-kicker">Find the right fit</p>
      <h2>Every dog deserves a chew that actually lasts.</h2>
      <p class="pch-size-guide__intro">Not all chews are created equal — and neither are dogs. We size every chew to match your dog's jaw strength, weight, and chewing style so it lasts the full session and stays safe from start to finish.</p>
    </div>

    <div class="pch-size-guide__grid" role="list">

      <article class="pch-size-card" role="listitem" aria-label="Small dogs 1 to 15 pounds">
        <div class="pch-size-card__badge pch-size-card__badge--small">Small</div>
        <div class="pch-size-card__body">
          <p class="pch-size-card__weight">1–15 lbs &middot; Chihuahua, Yorkie, Maltese</p>
          <h3>Gentle chewers who still need real enrichment.</h3>
          <p>Small dogs chew just as eagerly as big ones — they just need a size that won't overwhelm them. Our small chews are trimmed to the right thickness so little jaws get a satisfying session without the frustration of a chew that's too big to grip.</p>
          <ul class="pch-size-card__tags">
            <li>Perfect for light-to-moderate chewers</li>
            <li>Long-lasting indoor calm-time</li>
            <li>Digestible if a small piece breaks off</li>
          </ul>
        </div>
      </article>

      <article class="pch-size-card" role="listitem" aria-label="Medium dogs 15 to 35 pounds">
        <div class="pch-size-card__badge pch-size-card__badge--medium">Medium</div>
        <div class="pch-size-card__body">
          <p class="pch-size-card__weight">15–35 lbs &middot; Beagle, Cocker Spaniel, Shiba Inu</p>
          <h3>The sweet spot for most household dogs.</h3>
          <p>Medium dogs are often the most enthusiastic chewers in the house. Our medium chews are sized to give them a real workout — 45 to 75 minutes of focused chewing that burns mental energy and keeps them off the furniture.</p>
          <ul class="pch-size-card__tags">
            <li>Best for moderate-to-strong chewers</li>
            <li>Great for separation anxiety relief</li>
            <li>Ideal crate-time companion</li>
          </ul>
        </div>
      </article>

      <article class="pch-size-card" role="listitem" aria-label="Large dogs 35 to 55 pounds">
        <div class="pch-size-card__badge pch-size-card__badge--large">Large</div>
        <div class="pch-size-card__body">
          <p class="pch-size-card__weight">35–55 lbs &middot; Border Collie, Labrador, Husky</p>
          <h3>Built for dogs with real jaw power.</h3>
          <p>Large dogs go through flimsy chews in minutes. Our large yak chews are dense enough to hold up to serious chewing — giving high-energy breeds the sustained focus they need to settle down and actually relax.</p>
          <ul class="pch-size-card__tags">
            <li>Best for aggressive chewers</li>
            <li>60–90 min avg chew session</li>
            <li>Keeps high-drive dogs occupied</li>
          </ul>
        </div>
      </article>

      <article class="pch-size-card" role="listitem" aria-label="Extra large dogs 55 to 85 pounds">
        <div class="pch-size-card__badge pch-size-card__badge--xl">XL</div>
        <div class="pch-size-card__body">
          <p class="pch-size-card__weight">55–85 lbs &middot; Golden Retriever, German Shepherd, Boxer</p>
          <h3>For the dog who destroys everything else.</h3>
          <p>If your dog has gone through every chew on the market in under 10 minutes, you haven't tried a real yak chew yet. XL chews are thick, dense, and built to last — even for the most determined power chewers.</p>
          <ul class="pch-size-card__tags">
            <li>Best for power chewers</li>
            <li>Replaces rawhide and bully sticks</li>
            <li>Satisfying for large working breeds</li>
          </ul>
        </div>
      </article>

      <article class="pch-size-card" role="listitem" aria-label="Jumbo dogs 85 pounds and up">
        <div class="pch-size-card__badge pch-size-card__badge--jumbo">Jumbo</div>
        <div class="pch-size-card__body">
          <p class="pch-size-card__weight">85+ lbs &middot; Great Dane, Mastiff, Saint Bernard</p>
          <h3>The biggest chew for the biggest dogs.</h3>
          <p>Giant breeds need a chew that matches their size — not something they'll swallow whole in two bites. Our jumbo chews are the thickest we make, designed to give large-breed dogs a full enrichment session that actually tires them out.</p>
          <ul class="pch-size-card__tags">
            <li>Designed for giant breeds</li>
            <li>Longest-lasting option we offer</li>
            <li>Safe for supervised solo chewing</li>
          </ul>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     CHEW GUIDE — CHEWER TYPE COMPARISON
════════════════════════════════════════════════════════════════ -->
<section class="pch-chew-guide" aria-label="Chew guide by chewer type">
  <div class="pch-shell">
    <div class="pch-chew-guide__header">
      <p class="pch-kicker">Chew guide</p>
      <h2>What kind of chewer is your dog?</h2>
      <p class="pch-chew-guide__sub">Jaw strength matters more than breed. Here's how to pick the right chew based on how your dog actually chews.</p>
    </div>

    <div class="pch-chew-guide__grid">

      <div class="pch-chew-type">
        <div class="pch-chew-type__icon" aria-hidden="true">🐾</div>
        <h3>Gentle chewer</h3>
        <p class="pch-chew-type__desc">Licks and nibbles more than gnaws. Often older dogs, small breeds, or dogs new to yak chews.</p>
        <div class="pch-chew-type__rec">
          <span class="pch-chew-type__label">Best pick</span>
          <strong>Small or Medium — one size down from their weight</strong>
        </div>
        <ul class="pch-chew-type__tips">
          <li>Start with a smaller size to build confidence</li>
          <li>Soften the end slightly in warm water if needed</li>
          <li>Great for senior dogs with sensitive teeth</li>
        </ul>
      </div>

      <div class="pch-chew-type pch-chew-type--featured">
        <div class="pch-chew-type__badge">Most common</div>
        <div class="pch-chew-type__icon" aria-hidden="true">🦴</div>
        <h3>Moderate chewer</h3>
        <p class="pch-chew-type__desc">Chews steadily and consistently. Most dogs fall here — they enjoy the process and don't rush through it.</p>
        <div class="pch-chew-type__rec">
          <span class="pch-chew-type__label">Best pick</span>
          <strong>Match their weight range exactly</strong>
        </div>
        <ul class="pch-chew-type__tips">
          <li>45–75 min avg session per chew</li>
          <li>Perfect for crate time or calm-down routines</li>
          <li>Ideal for dogs with separation anxiety</li>
        </ul>
      </div>

      <div class="pch-chew-type">
        <div class="pch-chew-type__icon" aria-hidden="true">💪</div>
        <h3>Power chewer</h3>
        <p class="pch-chew-type__desc">Attacks the chew aggressively. Goes through bully sticks in minutes. Has destroyed every other chew you've tried.</p>
        <div class="pch-chew-type__rec">
          <span class="pch-chew-type__label">Best pick</span>
          <strong>One size up from their weight range</strong>
        </div>
        <ul class="pch-chew-type__tips">
          <li>Size up to extend the session</li>
          <li>Supervise the first few sessions</li>
          <li>Remove when chew gets small enough to swallow</li>
        </ul>
      </div>

    </div>
  </div>
</section>

