      "id": "stat1_label",
      "label": "Stat 1 label",
      "default": "Average chew time"
    },
    {
      "type": "text",
      "id": "stat2_value",
      "label": "Stat 2 value",
      "default": "4"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 label",
      "default": "4 simple ingredients"
    },
    {
      "type": "text",
      "id": "stat3_value",
      "label": "Stat 3 value",
      "default": "4.9★"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Stat 3 label",
      "default": "From 2,400+ reviews"
    },
    {
      "type": "text",
      "id": "stat4_value",
      "label": "Stat 4 value",
      "default": "30-day"
    },
    {
      "type": "text",
      "id": "stat4_label",
      "label": "Stat 4 label",
      "default": "Satisfaction guarantee"
    },
    {
      "type": "text",
      "id": "stat5_value",
      "label": "Stat 5 value",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "stat5_label",
      "label": "Stat 5 label",
      "default": "Shipping over $30"
    }
  ],
  "presets": [
    {
      "name": "Prime Pet Food trust bar"
    }
  ]
}
{% endschema %}
