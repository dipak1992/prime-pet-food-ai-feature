<div class="pptb" aria-label="Product trust signals">
  <div class="pptb__inner page-width">

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'chew-time', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat1_value | default: '67 min' }}</strong>
        <span>{{ section.settings.stat1_label | default: 'Average chew time' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'ingredients', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat2_value | default: '4' }}</strong>
        <span>{{ section.settings.stat2_label | default: '4 simple ingredients' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'review', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat3_value | default: '4.9★' }}</strong>
        <span>{{ section.settings.stat3_label | default: 'From 2,400+ reviews' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'guarantee', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat4_value | default: '30-day' }}</strong>
        <span>{{ section.settings.stat4_label | default: 'Satisfaction guarantee' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'shipping', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat5_value | default: 'Free' }}</strong>
        <span>{{ section.settings.stat5_label | default: 'Shipping over $30' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat6_value | default: 'Nepal' }}</strong>
        <span>{{ section.settings.stat6_label | default: 'Supporting farming families' }}</span>
      </div>
    </div>

  </div>
</div>

<style>
  .pptb {
    background: #fff;
    border-top: 1px solid rgba(55, 43, 31, 0.1);
    border-bottom: 1px solid rgba(55, 43, 31, 0.1);
    padding: 16px 0;
    font-family: var(--prime-font-sans, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  }

  .pptb * { box-sizing: border-box; }

  .pptb__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
  }

  .pptb__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    flex-shrink: 0;
  }

  .pptb__icon {
    color: #b85f32;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(184, 95, 50, 0.22);
    border-radius: 8px;
    background:
      linear-gradient(rgba(184, 95, 50, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(184, 95, 50, 0.08) 1px, transparent 1px),
      #fff8ef;
    background-size: 9px 9px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    position: relative;
  }

  .pptb__icon::after {
    content: "";
    position: absolute;
    inset: 5px;
    border: 1px dashed rgba(184, 95, 50, 0.18);
    border-radius: 5px;
    pointer-events: none;
  }

  .pptb__icon svg {
    position: relative;
    z-index: 1;
  }

  .pptb__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .pptb__text strong {
    display: block;
    color: #171512;
    font-size: 15px;
    font-weight: 780;
    line-height: 1.2;
  }

  .pptb__text span {
    display: block;
    color: #5f574e;
    font-size: 12px;
    line-height: 1.3;
  }

  .pptb__divider {
    width: 1px;
    height: 32px;
    background: rgba(55, 43, 31, 0.12);
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .pptb__inner {
      justify-content: flex-start;
      gap: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      flex-wrap: nowrap;
      padding-bottom: 2px;
    }

    .pptb__inner::-webkit-scrollbar {
      display: none;
    }

    .pptb__item {
      padding: 6px 14px;
      flex-shrink: 0;
    }

    .pptb__divider {
      height: 24px;
    }
  }

  @media (max-width: 560px) {
    .pptb__item {
      padding: 6px 12px;
    }

    .pptb__text strong {
      font-size: 14px;
    }

    .pptb__text span {
      font-size: 11px;
    }

    .pptb__icon svg {
      width: 18px;
      height: 18px;
    }

    .pptb__icon {
      width: 34px;
      height: 34px;
    }
  }
</style>

