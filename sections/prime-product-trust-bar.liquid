<div class="pptb" aria-label="Product trust signals">
  <div class="pptb__inner page-width">

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'chew-time', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat1_value | default: 'Real' }}</strong>
        <span>{{ section.settings.stat1_label | default: 'Chew time' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'ingredients', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat2_value | default: '4' }}</strong>
        <span>{{ section.settings.stat2_label | default: '4 simple ingredients' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'review', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat3_value | default: '4.9★' }}</strong>
        <span>{{ section.settings.stat3_label | default: 'From 2,400+ reviews' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'guarantee', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat4_value | default: '30-day' }}</strong>
        <span>{{ section.settings.stat4_label | default: 'Satisfaction guarantee' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'shipping', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat5_value | default: 'Free' }}</strong>
        <span>{{ section.settings.stat5_label | default: 'Shipping over $30' }}</span>
      </div>
    </div>

    <div class="pptb__divider" aria-hidden="true"></div>

    <div class="pptb__item">
      <div class="pptb__icon" aria-hidden="true">
        {% render 'prime-blueprint-icon', name: 'impact', size: 22 %}
      </div>
      <div class="pptb__text">
        <strong>{{ section.settings.stat6_value | default: 'Impact' }}</strong>
        <span>{{ section.settings.stat6_label | default: 'Supports Nepali makers' }}</span>
      </div>
    </div>

  </div>

  {% if section.settings.show_impact_note %}
    <div class="pptb__impact page-width" aria-label="Prime Pet Food impact promise">
      <span>{{ section.settings.impact_kicker | default: 'Every chew matters' }}</span>
      <p>{{ section.settings.impact_text | default: "Each purchase helps keep our sourcing tied to Nepali Himalayan farming families and supports Prime Pet Food's rural education commitment." }}</p>
    </div>
  {% endif %}

  {% if section.settings.show_vet_advisory %}
    <div class="pptb__vet-advisory page-width">
      {% render 'prime-vet-advisory' %}
    </div>
  {% endif %}
</div>

<style>
  .pptb {
    background: #fff;
    border-top: 1px solid rgba(55, 43, 31, 0.1);
    border-bottom: 1px solid rgba(55, 43, 31, 0.1);
    padding: 16px 0;
    font-family: var(--prime-font-sans, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  }

  .pptb * { box-sizing: border-box; }

  .pptb__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
  }

  .pptb__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    flex-shrink: 0;
  }

  .pptb__icon {
    color: #b85f32;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(184, 95, 50, 0.22);
    border-radius: 8px;
    background:
      linear-gradient(rgba(184, 95, 50, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(184, 95, 50, 0.08) 1px, transparent 1px),
      #fff8ef;
    background-size: 9px 9px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    position: relative;
  }

  .pptb__icon::after {
    content: "";
    position: absolute;
    inset: 5px;
    border: 1px dashed rgba(184, 95, 50, 0.18);
    border-radius: 5px;
    pointer-events: none;
  }

  .pptb__icon svg {
    position: relative;
    z-index: 1;
  }

  .pptb__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .pptb__text strong {
    display: block;
    color: #171512;
    font-size: 15px;
    font-weight: 780;
    line-height: 1.2;
  }

  .pptb__text span {
    display: block;
    color: #5f574e;
    font-size: 12px;
    line-height: 1.3;
  }

  .pptb__divider {
    width: 1px;
    height: 32px;
    background: rgba(55, 43, 31, 0.12);
    flex-shrink: 0;
  }

  .pptb__impact {
    max-width: 960px;
    margin: 10px auto 0;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    color: #46382d;
  }

  .pptb__impact span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 26px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #fff8ef;
    border: 1px solid rgba(184, 95, 50, 0.2);
    color: #94451f;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pptb__impact p {
    margin: 0;
    max-width: 720px;
    font-size: 13px;
    line-height: 1.45;
  }

  @media (max-width: 860px) {
    .pptb__inner {
      justify-content: flex-start;
      gap: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      flex-wrap: nowrap;
      padding-bottom: 2px;
    }

    .pptb__inner::-webkit-scrollbar {
      display: none;
    }

    .pptb__item {
      padding: 6px 14px;
      flex-shrink: 0;
    }

    .pptb__divider {
      height: 24px;
    }

    .pptb__impact {
      justify-content: flex-start;
      text-align: left;
      padding: 10px 18px 0;
      gap: 9px;
    }
  }

  @media (max-width: 560px) {
    .pptb__item {
      padding: 6px 12px;
    }

    .pptb__text strong {
      font-size: 14px;
    }

    .pptb__text span {
      font-size: 11px;
    }

    .pptb__icon svg {
      width: 18px;
      height: 18px;
    }

    .pptb__icon {
      width: 34px;
      height: 34px;
    }

    .pptb__impact {
      align-items: flex-start;
      flex-direction: column;
      padding-inline: 16px;
    }

    .pptb__impact p {
      font-size: 12px;
    }
  }
</style>

