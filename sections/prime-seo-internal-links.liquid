{{ 'prime-roadmap.css' | asset_url | stylesheet_tag }}

<section class="psil" aria-labelledby="PrimeSeoInternalLinksTitle">
  <div class="psil__inner">
    <div class="psil__copy">
      <p class="psil__kicker">{{ section.settings.eyebrow }}</p>
      <h2 id="PrimeSeoInternalLinksTitle">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <a class="psil__primary-link" href="/pages/how-long-will-this-last-for-my-dog">Use the chew duration estimator</a>
    </div>
    <ul class="psil__links">
      <li><a href="/pages/how-long-will-this-last-for-my-dog"><span>Duration</span><strong>Estimate chew time for your dog</strong><small>Use weight, age, and chewing style before choosing a size.</small></a></li>
      <li><a href="/pages/yak-chew-safety-guide"><span>Safety</span><strong>Read the supervision guide</strong><small>Know when to size up, remove the nub, and avoid hard chews.</small></a></li>
      <li><a href="/pages/best-long-lasting-chew-for-aggressive-chewers"><span>Strong chewers</span><strong>Buying for a power chewer?</strong><small>Set realistic expectations for dogs with stronger jaw pressure.</small></a></li>
      <li><a href="/pages/yak-chews-for-puppies"><span>Puppies</span><strong>Check puppy guidance first</strong><small>Age, teeth, and supervision matter more for younger dogs.</small></a></li>
      <li><a href="/pages/yak-chews-vs-bully-sticks"><span>Comparison</span><strong>Compare yak chews and bully sticks</strong><small>Useful if smell, mess, and ingredient simplicity matter.</small></a></li>
      <li><a href="/pages/yak-chew-guides"><span>All guides</span><strong>Browse the full chew guide library</strong><small>For sourcing, ingredients, duration, and routine questions.</small></a></li>
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Prime Pet Food SEO links",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Chew education"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose with confidence."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "These guides answer the most common buying questions about yak chew duration, sizing, ingredients, and safer supervised enrichment routines."
    }
  ],
  "presets": [
    {
      "name": "Prime Pet Food SEO links"
    }
  ]
}
{% endschema %}
