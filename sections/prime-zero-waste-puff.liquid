{%- comment -%}
  Microwave Puff Section
  File: sections/prime-zero-waste-puff.liquid

  Shows customers how to turn the small yak chew end piece into a crunchy
  cheese puff with a clear infographic, video link, and short safety steps.
{%- endcomment -%}

{%- liquid
  assign cta_url = section.settings.cta_url | default: '/products/himalayan-yak-chews-for-dogs'
  assign infographic_image = section.settings.infographic_image | default: 'prime-puff-instructions-infographic.jpg' | asset_url
-%}

<section class="pzw" aria-labelledby="PrimePetFoodZeroWasteTitle">
  <style>
    .pzw {
      --pzw-bg: #fff7ea;
      --pzw-ink: #1f1710;
      --pzw-muted: #67594b;
      --pzw-panel: #fffdf7;
      --pzw-line: rgba(69, 52, 36, 0.14);
      --pzw-accent: #b35b2f;
      --pzw-green: #183d2b;
      background:
        radial-gradient(circle at 16% 0%, rgba(179, 91, 47, 0.14), transparent 30%),
        linear-gradient(180deg, #fff9ef 0%, var(--pzw-bg) 100%);
      color: var(--pzw-ink);
      padding: clamp(48px, 8vw, 86px) 20px;
      font-family: var(--font-body-family, -apple-system, sans-serif);
      overflow: hidden;
    }

    .pzw__inner {
      max-width: 1160px;
      margin: 0 auto;
    }

    .pzw__header {
      max-width: 760px;
      margin: 0 auto 30px;
      text-align: center;
    }

    .pzw__badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 7px 14px;
      margin-bottom: 14px;
      border: 1px solid rgba(24, 61, 43, 0.18);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.58);
      color: var(--pzw-green);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .pzw__title {
      max-width: 680px;
      margin: 0 auto 12px;
      color: var(--pzw-ink);
      font-size: clamp(30px, 4.8vw, 52px);
      font-weight: 780;
      letter-spacing: 0;
      line-height: 1.04;
    }

    .pzw__subtitle {
      max-width: 650px;
      margin: 0 auto;
      color: var(--pzw-muted);
      font-size: clamp(15px, 2vw, 18px);
      line-height: 1.55;
    }

    .pzw__visual {
      margin: 0 0 26px;
    }

    .pzw__infographic {
      margin: 0;
      overflow: hidden;
      border: 1px solid var(--pzw-line);
      border-radius: 18px;
      background: var(--pzw-panel);
      box-shadow: 0 22px 58px rgba(58, 39, 23, 0.14);
    }

    .pzw__infographic img {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 360px;
      object-fit: cover;
    }

    .pzw__steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 24px;
    }

    .pzw__step {
      position: relative;
      min-height: 150px;
      padding: 22px 18px 20px;
      border: 1px solid var(--pzw-line);
      border-radius: 16px;
      background: rgba(255, 253, 247, 0.78);
    }

    .pzw__step-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      margin-bottom: 15px;
      border-radius: 999px;
      background: var(--pzw-green);
      color: #fff7ea;
      font-size: 13px;
      font-weight: 800;
    }

    .pzw__step-title {
      margin: 0 0 7px;
      color: var(--pzw-ink);
      font-size: 15px;
      font-weight: 760;
      line-height: 1.25;
    }

    .pzw__step-desc {
      margin: 0;
      color: var(--pzw-muted);
      font-size: 13px;
      line-height: 1.48;
    }

    .pzw__arrow {
      display: none;
    }

    @media (min-width: 769px) {
      .pzw__arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        right: -18px;
        top: 50%;
        z-index: 2;
        width: 28px;
        height: 28px;
        transform: translateY(-50%);
        border-radius: 999px;
        background: var(--pzw-accent);
        color: #fff7ea;
        font-size: 14px;
        font-weight: 900;
      }

      .pzw__step:last-child .pzw__arrow {
        display: none;
      }
    }

    .pzw__safety-box {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 14px;
      align-items: flex-start;
      margin-bottom: 28px;
      padding: 20px;
      border: 1px solid rgba(24, 61, 43, 0.16);
      border-radius: 18px;
      background: rgba(24, 61, 43, 0.08);
    }

    .pzw__safety-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 14px;
      background: var(--pzw-green);
      color: #fff7ea;
      font-size: 20px;
      font-weight: 800;
    }

    .pzw__safety-title {
      margin: 0 0 6px;
      color: var(--pzw-green);
      font-size: 15px;
      font-weight: 800;
    }

    .pzw__safety-text {
      margin: 0;
      color: var(--pzw-muted);
      font-size: 14px;
      line-height: 1.62;
    }

    .pzw__cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }

    .pzw__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 14px 26px;
      border-radius: 999px;
      background: var(--pzw-ink);
      color: #fff7ea;
      font-size: 15px;
      font-weight: 780;
      line-height: 1;
      text-decoration: none;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    .pzw__cta:hover {
      background: var(--pzw-green);
      transform: translateY(-1px);
    }

    .pzw__video-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 13px 22px;
      border: 1px solid rgba(31, 23, 16, 0.18);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.54);
      color: var(--pzw-ink);
      font-size: 14px;
      font-weight: 760;
      line-height: 1;
      text-decoration: none;
    }

    .pzw__video-link:hover {
      border-color: rgba(24, 61, 43, 0.35);
      color: var(--pzw-green);
    }

    @media (max-width: 900px) {
      .pzw__infographic img {
        min-height: 300px;
      }

      .pzw__steps {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 560px) {
      .pzw {
        padding: 42px 16px 52px;
      }

      .pzw__header {
        margin-bottom: 22px;
        text-align: left;
      }

      .pzw__title,
      .pzw__subtitle {
        margin-left: 0;
        margin-right: 0;
      }

      .pzw__infographic,
      .pzw__safety-box,
      .pzw__step {
        border-radius: 14px;
      }

      .pzw__infographic img {
        height: auto;
        min-height: 0;
        object-fit: contain;
      }

      .pzw__steps {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .pzw__step {
        min-height: 0;
        padding: 17px 16px;
      }

      .pzw__step-num {
        margin-bottom: 10px;
      }

      .pzw__safety-box {
        grid-template-columns: 1fr;
        padding: 18px;
      }

      .pzw__cta,
      .pzw__video-link {
        width: 100%;
      }
    }
  </style>

  <div class="pzw__inner">
    <div class="pzw__header">
      <span class="pzw__badge">Microwave puff trick</span>
      <h2 class="pzw__title" id="PrimePetFoodZeroWasteTitle">{{ section.settings.heading }}</h2>
      <p class="pzw__subtitle">{{ section.settings.subheading }}</p>
    </div>

    <div class="pzw__visual">
      <figure class="pzw__infographic">
        <img
          src="{{ infographic_image }}"
          alt="Four step visual guide showing how to puff a small yak chew end piece"
          width="1776"
          height="918"
          loading="lazy"
        >
      </figure>
    </div>

    <div class="pzw__steps" aria-label="Microwave puff instructions">
      <div class="pzw__step">
        <span class="pzw__step-num">1</span>
        <p class="pzw__step-title">Remove the nub</p>
        <p class="pzw__step-desc">Take the chew away before the small end piece is easy to swallow.</p>
        <span class="pzw__arrow">&#8594;</span>
      </div>

      <div class="pzw__step">
        <span class="pzw__step-num">2</span>
        <p class="pzw__step-title">Soak it</p>
        <p class="pzw__step-desc">Place it in warm water for 5 to 10 minutes so it is ready to puff.</p>
        <span class="pzw__arrow">&#8594;</span>
      </div>

      <div class="pzw__step">
        <span class="pzw__step-num">3</span>
        <p class="pzw__step-title">Microwave briefly</p>
        <p class="pzw__step-desc">Heat on a microwave-safe plate for 45 to 60 seconds, until it expands.</p>
        <span class="pzw__arrow">&#8594;</span>
      </div>

      <div class="pzw__step">
        <span class="pzw__step-num">4</span>
        <p class="pzw__step-title">Cool completely</p>
        <p class="pzw__step-desc">Let the puff cool all the way down, then serve it as a crunchy treat.</p>
      </div>
    </div>

    <div class="pzw__safety-box">
      <div class="pzw__safety-icon">✓</div>
      <div class="pzw__safety-content">
        <p class="pzw__safety-title">Why this matters</p>
        <p class="pzw__safety-text">The final end piece is when supervision matters most. Taking it away early helps reduce swallow risk, and puffing it turns the last bit into a lighter, crunchy cheese treat after it cools.</p>
      </div>
    </div>

    <div class="pzw__cta-row">
      <a href="{{ cta_url }}" class="pzw__cta">
        {{ section.settings.cta_label }} &#8594;
      </a>
      {%- if section.settings.video_url != blank -%}
        <a href="{{ section.settings.video_url }}" class="pzw__video-link" target="_blank" rel="noopener">
          Watch puff trick video &#8599;
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zero Waste Puff Hack",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "When the chew gets small, puff it."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Take the small end piece away, soak it, microwave it, and let it cool into a crunchy cheese treat. More value, less waste, and a more controlled finish."
    },
    {
      "type": "text",
      "id": "infographic_image",
      "label": "Infographic image asset filename",
      "default": "prime-puff-instructions-infographic.jpg",
      "info": "Upload the image to theme assets, then enter the filename here."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Yak Chews"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Puff trick video URL (optional)",
      "info": "Direct MP4 URL for the puff trick video."
    }
  ],
  "presets": [
    {
      "name": "Zero Waste Puff Hack"
    }
  ]
}
{% endschema %}
