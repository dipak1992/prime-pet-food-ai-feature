{% comment %}
  Prime Hero Section
  Cinematic, emotionally-driven hero for Prime Pet Food homepage.
  Design: calm, decompression, peace, natural quality, premium simplicity.
  Reference: Apple product pages, Patagonia hero sections, premium wellness brands.
{% endcomment %}

{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_image_mobile = section.settings.hero_image_mobile
  assign headline = section.settings.headline
  assign subheadline = section.settings.subheadline
  assign cta_text = section.settings.cta_text
  assign cta_url = section.settings.cta_url
  assign show_trust_badges = section.settings.show_trust_badges
  assign show_scroll_indicator = section.settings.show_scroll_indicator
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section class="prime-hero" data-section-id="{{ section.id }}">
  <div class="prime-hero__media">
    {%- if hero_image != blank -%}
      <picture>
        {%- if hero_image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ hero_image_mobile | image_url: width: 750 }} 750w,
                    {{ hero_image_mobile | image_url: width: 1000 }} 1000w"
            sizes="100vw"
          >
        {%- endif -%}
        <img
          class="prime-hero__image"
          src="{{ hero_image | image_url: width: 2000 }}"
          srcset="{{ hero_image | image_url: width: 1000 }} 1000w,
                  {{ hero_image | image_url: width: 1500 }} 1500w,
                  {{ hero_image | image_url: width: 2000 }} 2000w,
                  {{ hero_image | image_url: width: 2500 }} 2500w"
          sizes="100vw"
          alt="{{ hero_image.alt | default: headline | escape }}"
          loading="eager"
          fetchpriority="high"
          width="{{ hero_image.width }}"
          height="{{ hero_image.height }}"
        >
      </picture>
    {%- else -%}
      <img
        class="prime-hero__image"
        src="{{ 'prime-homepage-hero-lifestyle-golden-v2.jpg' | asset_url }}"
        alt="{{ headline | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="prime-hero__overlay" style="--prime-hero-overlay-opacity: {{ overlay_opacity }};"></div>
  </div>

  <div class="prime-hero__content">
    <h1 class="prime-hero__headline">{{ headline }}</h1>
    <p class="prime-hero__subheadline">{{ subheadline }}</p>
    <a class="prime-hero__cta" href="{{ cta_url }}">{{ cta_text }}</a>

    {%- if show_trust_badges and section.blocks.size > 0 -%}
      <div class="prime-hero__trust-badges">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
            <span class="prime-hero__trust-badge" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'checkmark' -%}
                  <svg class="prime-hero__trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                {%- when 'leaf' -%}
                  <svg class="prime-hero__trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 19 2c1 2 2 4.5 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
                {%- when 'shield' -%}
                  <svg class="prime-hero__trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                {%- when 'globe' -%}
                  <svg class="prime-hero__trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
              {%- endcase -%}
              {{ block.settings.text }}
            </span>
            {%- unless forloop.last -%}
              <span class="prime-hero__trust-separator" aria-hidden="true">•</span>
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if show_scroll_indicator -%}
    <div class="prime-hero__scroll-indicator" aria-hidden="true">
      <span class="prime-hero__scroll-text">Scroll</span>
      <svg class="prime-hero__scroll-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  {%- endif -%}
</section>

<style>
  /* ==========================================================================
     PRIME HERO — Cinematic Full-Viewport Hero Section
     ========================================================================== */

  .prime-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
  }

  /* --------------------------------------------------------------------------
     Media / Background Image
     -------------------------------------------------------------------------- */

  .prime-hero__media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .prime-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .prime-hero.is-revealed .prime-hero__image {
    opacity: 1;
  }

  .prime-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(26, 26, 26, var(--prime-hero-overlay-opacity, 0.4)) 0%,
      rgba(26, 26, 26, calc(var(--prime-hero-overlay-opacity, 0.4) * 0.5)) 40%,
      transparent 70%
    );
    z-index: 2;
  }

  /* --------------------------------------------------------------------------
     Content
     -------------------------------------------------------------------------- */

  .prime-hero__content {
    position: relative;
    z-index: 3;
    padding: 0 0 80px 64px;
    max-width: 650px;
  }

  .prime-hero__headline {
    font-family: var(--prime-font-heading);
    font-size: var(--prime-font-display);
    font-weight: 400;
    line-height: var(--prime-leading-tight);
    letter-spacing: var(--prime-tracking-tight);
    color: var(--prime-white);
    margin: 0 0 20px 0;
    max-width: 600px;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: 0.2s;
  }

  .prime-hero.is-revealed .prime-hero__headline {
    opacity: 1;
    transform: translateY(0);
  }

  .prime-hero__subheadline {
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-body-lg);
    font-weight: 300;
    line-height: var(--prime-leading-normal);
    color: var(--prime-cream);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: 0.4s;
    margin: 0 0 32px 0;
    max-width: 500px;
  }

  .prime-hero.is-revealed .prime-hero__subheadline {
    opacity: 0.9;
    transform: translateY(0);
  }

  .prime-hero__cta {
    display: inline-block;
    background-color: var(--prime-terracotta);
    color: var(--prime-white);
    font-family: var(--prime-font-body);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: var(--prime-tracking-wide);
    text-decoration: none;
    padding: 16px 32px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, opacity 0.7s ease, transform 0.7s ease;
    transition-delay: 0s, 0.6s, 0.6s;
    opacity: 0;
    transform: translateY(24px);
    min-height: 48px;
    line-height: 1;
  }

  .prime-hero.is-revealed .prime-hero__cta {
    opacity: 1;
    transform: translateY(0);
  }

  .prime-hero__cta:hover {
    background-color: var(--prime-terracotta-hover);
  }

  .prime-hero__cta:focus-visible {
    outline: 2px solid var(--prime-white);
    outline-offset: 3px;
  }

  /* --------------------------------------------------------------------------
     Trust Badges
     -------------------------------------------------------------------------- */

  .prime-hero__trust-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    opacity: 0;
    transition: opacity 0.7s ease;
    transition-delay: 0.8s;
  }

  .prime-hero.is-revealed .prime-hero__trust-badges {
    opacity: 0.7;
  }

  .prime-hero__trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-caption);
    color: var(--prime-cream);
    text-transform: uppercase;
    letter-spacing: var(--prime-tracking-wider);
    white-space: nowrap;
  }

  .prime-hero__trust-icon {
    flex-shrink: 0;
  }

  .prime-hero__trust-separator {
    color: var(--prime-cream);
    opacity: 0.5;
    font-size: 0.625rem;
    line-height: 1;
  }

  /* --------------------------------------------------------------------------
     Scroll Indicator
     -------------------------------------------------------------------------- */

  .prime-hero__scroll-indicator {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.7s ease;
    transition-delay: 1s;
    animation: prime-hero-bounce 2s ease-in-out infinite;
    animation-delay: 1.5s;
  }

  .prime-hero.is-revealed .prime-hero__scroll-indicator {
    opacity: 0.6;
  }

  .prime-hero__scroll-text {
    font-family: var(--prime-font-body);
    font-size: 0.6875rem;
    color: var(--prime-cream);
    text-transform: uppercase;
    letter-spacing: var(--prime-tracking-wider);
  }

  .prime-hero__scroll-chevron {
    color: var(--prime-cream);
  }

  @keyframes prime-hero-bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(6px);
    }
    60% {
      transform: translateX(-50%) translateY(3px);
    }
  }

  /* --------------------------------------------------------------------------
     Mobile Responsive
     -------------------------------------------------------------------------- */

  @media screen and (max-width: 749px) {
    .prime-hero {
      height: 85vh;
      align-items: flex-end;
      justify-content: center;
    }

    .prime-hero__content {
      padding: 0 24px 100px 24px;
      max-width: 100%;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .prime-hero__headline {
      font-size: clamp(2rem, 8vw, 2.75rem);
      max-width: 100%;
    }

    .prime-hero__subheadline {
      max-width: 100%;
      font-size: clamp(0.9375rem, 3.5vw, 1.125rem);
    }

    .prime-hero__cta {
      width: 100%;
      max-width: 320px;
      text-align: center;
      padding: 18px 32px;
    }

    .prime-hero__trust-badges {
      justify-content: center;
    }

    .prime-hero__trust-separator {
      display: none;
    }

    .prime-hero__trust-badge {
      font-size: 0.6875rem;
    }

    .prime-hero__scroll-indicator {
      bottom: 16px;
    }
  }

  /* --------------------------------------------------------------------------
     Tablet
     -------------------------------------------------------------------------- */

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .prime-hero__content {
      padding: 0 0 64px 48px;
      max-width: 550px;
    }
  }

  /* --------------------------------------------------------------------------
     Reduced Motion
     -------------------------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    .prime-hero__headline,
    .prime-hero__subheadline,
    .prime-hero__cta,
    .prime-hero__trust-badges,
    .prime-hero__scroll-indicator,
    .prime-hero__image {
      transition: none !important;
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .prime-hero.is-revealed .prime-hero__subheadline {
      opacity: 0.9 !important;
    }

    .prime-hero.is-revealed .prime-hero__trust-badges {
      opacity: 0.7 !important;
    }

    .prime-hero.is-revealed .prime-hero__scroll-indicator {
      opacity: 0.6 !important;
    }
  }
</style>

<script>
  (function() {
    var hero = document.querySelector('.prime-hero[data-section-id="{{ section.id }}"]');
    if (!hero) return;

    /* Reveal animation on load */
    function revealHero() {
      hero.classList.add('is-revealed');
    }

    /* Trigger reveal after a brief delay to ensure paint */
    if (document.readyState === 'complete') {
      requestAnimationFrame(revealHero);
    } else {
      window.addEventListener('load', function() {
        requestAnimationFrame(revealHero);
      });
    }

    /* Subtle parallax on scroll (CSS-only fallback via will-change) */
    var image = hero.querySelector('.prime-hero__image');
    var scrollIndicator = hero.querySelector('.prime-hero__scroll-indicator');
    var ticking = false;

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(function() {
          var scrollY = window.pageYOffset || window.scrollY;
          var heroHeight = hero.offsetHeight;

          /* Only apply parallax while hero is in view */
          if (scrollY < heroHeight) {
            var parallaxOffset = scrollY * 0.3;
            image.style.transform = 'translate3d(0, ' + parallaxOffset + 'px, 0) scale(1.05)';

            /* Fade out scroll indicator as user scrolls */
            if (scrollIndicator) {
              var fadeProgress = Math.min(scrollY / (heroHeight * 0.2), 1);
              scrollIndicator.style.opacity = Math.max(0, 0.6 - fadeProgress);
            }
          }

          ticking = false;
        });
        ticking = true;
      }
    }

    /* Only add parallax on non-touch devices for performance */
    if (!('ontouchstart' in window) && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      window.addEventListener('scroll', onScroll, { passive: true });
      /* Initial scale to prevent jump */
      image.style.transform = 'translate3d(0, 0, 0) scale(1.05)';
      image.style.willChange = 'transform';
    }
  })();
</script>

{% schema %}
{
  "name": "Prime Hero",
  "tag": "div",
  "class": "prime-hero-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image",
      "info": "Recommended: 2500x1400px minimum. Lifestyle photography with natural lighting."
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero Image (Mobile)",
      "info": "Optional. Portrait-oriented image for mobile devices (750x1000px recommended)."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Calm dogs start with a better chew."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "The long-lasting Himalayan yak chew made with just 4 natural ingredients. Rawhide-free, digestible, and loved by heavy chewers."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop Yak Chews"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button Link",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show Trust Badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show Scroll Indicator",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "Trust Badge"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "checkmark"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prime Hero",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "text": "Packed in USA",
            "icon": "shield"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "text": "Traditional Himalayan Recipe",
            "icon": "globe"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "text": "100% Natural",
            "icon": "leaf"
          }
        }
      ]
    }
  ]
}
{% endschema %}
