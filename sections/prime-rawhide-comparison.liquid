{% comment %}
  Prime Rawhide Comparison Section
  A visually stunning infographic comparing Prime Yak Chews vs Rawhide
  Self-contained: CSS + JS + Liquid + Schema
{% endcomment %}

{% liquid
  assign bg_style = section.settings.background_style | default: 'cream'
  assign heading = section.settings.heading | default: "Why dogs (and their humans) choose Prime over rawhide"
  assign subheading = section.settings.subheading | default: "See how our all-natural yak chews compare to traditional rawhide — the difference is clear."
  assign cta_text = section.settings.cta_text | default: "Shop Rawhide-Free Chews"
  assign cta_url = section.settings.cta_url | default: "/collections/all"
%}

<section
  class="prime-compare prime-section prime-section--{{ bg_style }}"
  id="prime-compare-{{ section.id }}"
  aria-label="{{ heading }}"
>
  <div class="prime-container">
    <div class="prime-compare__header">
      <h2 class="prime-compare__heading">{{ heading }}</h2>
      {% if subheading != blank %}
        <p class="prime-compare__subheading">{{ subheading }}</p>
      {% endif %}
    </div>

    <div class="prime-compare__grid" role="list" aria-label="Comparison cards">
      {% for block in section.blocks %}
        {% if block.type == 'comparison' %}
          <div
            class="prime-compare__card"
            role="listitem"
            {{ block.shopify_attributes }}
            data-compare-card
            style="--card-index: {{ forloop.index0 }};"
          >
            <div class="prime-compare__card-icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'odor' %}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
                    <path d="M24 8C24 8 20 14 20 18C20 20.2 21.8 22 24 22C26.2 22 28 20.2 28 18C28 14 24 8 24 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M14 20C14 20 16 16 18 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M34 20C34 20 32 16 30 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M12 30C12 30 14 26 18 26C22 26 22 30 24 30C26 30 26 26 30 26C34 26 36 30 36 30" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M16 36C16 36 18 34 20 34C22 34 24 36 26 36C28 36 30 34 32 34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
                    <circle cx="20" cy="40" r="1" fill="currentColor" opacity="0.4"/>
                    <circle cx="28" cy="40" r="1" fill="currentColor" opacity="0.4"/>
                  </svg>
                {% when 'digestibility' %}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
                    <path d="M24 6V10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M20 10H28C28 10 30 10 30 12V16C30 18 28 20 26 22C24 24 24 26 24 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M18 10C18 10 16 12 16 16C16 20 20 22 20 26C20 30 18 32 18 36C18 40 22 42 24 42C26 42 30 40 30 36C30 32 28 30 28 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M20 16L26 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
                    <path d="M19 22L25 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
                    <circle cx="22" cy="34" r="1.5" fill="currentColor" opacity="0.4"/>
                  </svg>
                {% when 'splinter' %}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
                    <path d="M16 12L24 6L32 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 24L8 20L16 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M36 24L40 20L32 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M18 36L14 42L22 38" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M30 36L34 42L26 38" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="24" cy="26" r="8" stroke="currentColor" stroke-width="2"/>
                    <path d="M20 24L22 28L26 23L28 27" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'ingredients' %}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
                    <path d="M24 42V24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M24 24C24 24 18 20 18 14C18 8 24 6 24 6C24 6 30 8 30 14C30 20 24 24 24 24Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M24 18C24 18 20 16 20 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
                    <path d="M16 30C14 28 10 28 10 32C10 36 16 36 16 36" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M32 30C34 28 38 28 38 32C38 36 32 36 32 36" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'longevity' %}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
                    <circle cx="24" cy="26" r="16" stroke="currentColor" stroke-width="2"/>
                    <circle cx="24" cy="26" r="2" fill="currentColor"/>
                    <path d="M24 14V26" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M24 26L32 30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M20 6H28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M24 6V10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <circle cx="24" cy="26" r="13" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
                  </svg>
                {% when 'safety' %}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
                    <path d="M24 4L8 12V22C8 33 15 40 24 44C33 40 40 33 40 22V12L24 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M17 24L22 29L31 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% else %}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
                    <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2"/>
                    <path d="M17 24L22 29L31 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
              {% endcase %}
            </div>

            <h3 class="prime-compare__card-title">{{ block.settings.category }}</h3>

            <div class="prime-compare__card-comparison" role="group" aria-label="{{ block.settings.category }} comparison">
              <div class="prime-compare__card-side prime-compare__card-side--rawhide">
                <span class="prime-compare__card-indicator prime-compare__card-indicator--negative" aria-hidden="true">✗</span>
                <span class="prime-compare__card-label">Rawhide</span>
                <div class="prime-compare__card-bar-track">
                  <div
                    class="prime-compare__card-bar prime-compare__card-bar--rawhide"
                    style="--bar-width: {{ block.settings.rawhide_score | times: 10 }}%"
                    role="meter"
                    aria-valuenow="{{ block.settings.rawhide_score }}"
                    aria-valuemin="1"
                    aria-valuemax="10"
                    aria-label="Rawhide {{ block.settings.category }} score: {{ block.settings.rawhide_score }} out of 10"
                  ></div>
                </div>
                <span class="prime-compare__card-text">{{ block.settings.rawhide_text }}</span>
              </div>

              <div class="prime-compare__card-side prime-compare__card-side--prime">
                <span class="prime-compare__card-indicator prime-compare__card-indicator--positive" aria-hidden="true">✓</span>
                <span class="prime-compare__card-label">Prime</span>
                <div class="prime-compare__card-bar-track">
                  <div
                    class="prime-compare__card-bar prime-compare__card-bar--prime"
                    style="--bar-width: {{ block.settings.prime_score | times: 10 }}%"
                    role="meter"
                    aria-valuenow="{{ block.settings.prime_score }}"
                    aria-valuemin="1"
                    aria-valuemax="10"
                    aria-label="Prime {{ block.settings.category }} score: {{ block.settings.prime_score }} out of 10"
                  ></div>
                </div>
                <span class="prime-compare__card-text">{{ block.settings.prime_text }}</span>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="prime-compare__dots" role="tablist" aria-label="Comparison card navigation"></div>

    {% if cta_text != blank %}
      <div class="prime-compare__cta">
        <a href="{{ cta_url }}" class="prime-btn-primary prime-compare__cta-btn">
          {{ cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  /* ===== Prime Rawhide Comparison Section ===== */

  .prime-compare {
    --compare-coral: #D4756A;
    --compare-coral-light: #F5E6E4;
    --compare-sage: var(--prime-sage, #7A8B6F);
    --compare-sage-light: #EDF2EA;
    --compare-cream: var(--prime-cream, #FAF7F2);
    --compare-cream-dark: var(--prime-cream-dark, #F2EDE5);
    --compare-white: var(--prime-white, #FFFFFF);
    --compare-text: var(--prime-text, #2C2C2C);
    --compare-text-muted: var(--prime-text-muted, #6B6B6B);
    --compare-radius: 16px;
    --compare-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    --compare-shadow-hover: 0 8px 32px rgba(0, 0, 0, 0.1);

    padding: 80px 0;
    overflow: hidden;
  }

  .prime-compare.prime-section--cream {
    background-color: var(--compare-cream-dark);
  }

  .prime-compare.prime-section--white {
    background-color: var(--compare-white);
  }

  .prime-compare.prime-section--dark {
    background-color: var(--compare-text);
  }

  .prime-compare.prime-section--dark .prime-compare__heading,
  .prime-compare.prime-section--dark .prime-compare__subheading {
    color: var(--compare-white);
  }

  .prime-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .prime-compare__header {
    text-align: center;
    margin-bottom: 56px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .prime-compare__heading {
    font-family: var(--prime-font-heading, 'Georgia', serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--compare-text);
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }

  .prime-compare__subheading {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.6;
    color: var(--compare-text-muted);
    margin: 0;
  }

  /* Grid - Desktop */
  .prime-compare__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 48px;
  }

  /* Cards */
  .prime-compare__card {
    background: var(--compare-white);
    border-radius: var(--compare-radius);
    padding: 32px 28px;
    box-shadow: var(--compare-shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    transform: translateY(24px);
    will-change: transform, opacity;
  }

  .prime-compare__card.prime-compare__card--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .prime-compare__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--compare-shadow-hover);
  }

  .prime-compare__card.prime-compare__card--visible:hover {
    transform: translateY(-4px);
  }

  /* Card Icon */
  .prime-compare__card-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 16px;
    color: var(--compare-sage);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--compare-sage-light);
    border-radius: 12px;
    padding: 8px;
  }

  .prime-compare__card-icon svg {
    width: 100%;
    height: 100%;
  }

  /* Card Title */
  .prime-compare__card-title {
    font-family: var(--prime-font-heading, 'Georgia', serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--compare-text);
    margin: 0 0 20px;
    letter-spacing: -0.01em;
  }

  /* Card Comparison */
  .prime-compare__card-comparison {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .prime-compare__card-side {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .prime-compare__card-side--rawhide .prime-compare__card-label {
    color: var(--compare-coral);
  }

  .prime-compare__card-side--prime .prime-compare__card-label {
    color: var(--compare-sage);
  }

  /* Labels & Indicators */
  .prime-compare__card-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .prime-compare__card-indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
  }

  .prime-compare__card-indicator--negative {
    background: var(--compare-coral-light);
    color: var(--compare-coral);
  }

  .prime-compare__card-indicator--positive {
    background: var(--compare-sage-light);
    color: var(--compare-sage);
  }

  /* Progress Bars */
  .prime-compare__card-bar-track {
    width: 100%;
    height: 8px;
    background: #F0F0F0;
    border-radius: 4px;
    overflow: hidden;
  }

  .prime-compare__card-bar {
    height: 100%;
    border-radius: 4px;
    width: 0;
    transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .prime-compare__card-bar--rawhide {
    background: linear-gradient(90deg, var(--compare-coral), #E8998F);
  }

  .prime-compare__card-bar--prime {
    background: linear-gradient(90deg, var(--compare-sage), #95A888);
  }

  .prime-compare__card.prime-compare__card--visible .prime-compare__card-bar {
    width: var(--bar-width);
  }

  /* Card Text */
  .prime-compare__card-text {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--compare-text-muted);
  }

  .prime-compare__card-side--rawhide .prime-compare__card-text {
    color: var(--compare-coral);
    opacity: 0.85;
  }

  .prime-compare__card-side--prime .prime-compare__card-text {
    color: var(--compare-sage);
    font-weight: 500;
  }

  /* Dots - Mobile Only */
  .prime-compare__dots {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-bottom: 40px;
  }

  .prime-compare__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--compare-text);
    opacity: 0.2;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .prime-compare__dot--active {
    opacity: 0.8;
    transform: scale(1.3);
    background: var(--compare-sage);
  }

  /* CTA */
  .prime-compare__cta {
    text-align: center;
  }

  .prime-compare__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: var(--compare-sage);
    color: var(--compare-white);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 16px rgba(122, 139, 111, 0.3);
    letter-spacing: 0.01em;
  }

  .prime-compare__cta-btn:hover {
    background: #6A7B5F;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(122, 139, 111, 0.4);
  }

  .prime-compare__cta-btn:active {
    transform: translateY(0);
  }

  /* ===== Tablet: 2 columns ===== */
  @media (max-width: 1024px) and (min-width: 769px) {
    .prime-compare__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  /* ===== Mobile: Carousel ===== */
  @media (max-width: 768px) {
    .prime-compare {
      padding: 56px 0;
    }

    .prime-compare__header {
      margin-bottom: 36px;
      padding: 0 16px;
    }

    .prime-compare__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: 16px;
      padding: 8px 24px 24px;
      margin-bottom: 24px;
    }

    .prime-compare__grid::-webkit-scrollbar {
      display: none;
    }

    .prime-compare__card {
      flex: 0 0 85vw;
      max-width: 340px;
      scroll-snap-align: center;
      padding: 28px 24px;
    }

    .prime-compare__card:hover {
      transform: none;
      box-shadow: var(--compare-shadow);
    }

    .prime-compare__card.prime-compare__card--visible:hover {
      transform: translateY(0);
    }

    .prime-compare__dots {
      display: flex;
    }

    .prime-compare__cta-btn {
      padding: 14px 32px;
      font-size: 0.9375rem;
    }
  }

  /* ===== Reduced Motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .prime-compare__card {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .prime-compare__card-bar {
      transition: none;
      width: var(--bar-width);
    }

    .prime-compare__card:hover {
      transform: none;
    }
  }

  /* ===== Dark section variant card adjustments ===== */
  .prime-compare.prime-section--dark .prime-compare__card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .prime-compare.prime-section--dark .prime-compare__card-title {
    color: var(--compare-white);
  }

  .prime-compare.prime-section--dark .prime-compare__card-icon {
    background: rgba(122, 139, 111, 0.15);
  }

  .prime-compare.prime-section--dark .prime-compare__card-bar-track {
    background: rgba(255, 255, 255, 0.1);
  }
</style>

<script>
  (function() {
    const section = document.getElementById('prime-compare-{{ section.id }}');
    if (!section) return;

    const cards = section.querySelectorAll('[data-compare-card]');
    const grid = section.querySelector('.prime-compare__grid');
    const dotsContainer = section.querySelector('.prime-compare__dots');

    // ===== Intersection Observer for scroll animations =====
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      const observerOptions = {
        root: null,
        rootMargin: '0px 0px -60px 0px',
        threshold: 0.15
      };

      const cardObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            const card = entry.target;
            const index = parseInt(card.style.getPropertyValue('--card-index')) || 0;
            setTimeout(function() {
              card.classList.add('prime-compare__card--visible');
            }, index * 120);
            cardObserver.unobserve(card);
          }
        });
      }, observerOptions);

      cards.forEach(function(card) {
        cardObserver.observe(card);
      });
    } else {
      // If reduced motion, show all cards immediately
      cards.forEach(function(card) {
        card.classList.add('prime-compare__card--visible');
      });
    }

    // ===== Mobile Carousel Dots =====
    function initDots() {
      const isMobile = window.innerWidth <= 768;

      if (isMobile && cards.length > 0) {
        dotsContainer.innerHTML = '';
        cards.forEach(function(_, index) {
          const dot = document.createElement('button');
          dot.className = 'prime-compare__dot' + (index === 0 ? ' prime-compare__dot--active' : '');
          dot.setAttribute('role', 'tab');
          dot.setAttribute('aria-label', 'Go to comparison ' + (index + 1));
          dot.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
          dot.addEventListener('click', function() {
            const card = cards[index];
            if (card && grid) {
              const scrollLeft = card.offsetLeft - (grid.offsetWidth - card.offsetWidth) / 2;
              grid.scrollTo({ left: scrollLeft, behavior: 'smooth' });
            }
          });
          dotsContainer.appendChild(dot);
        });

        // Update dots on scroll
        let scrollTimeout;
        grid.addEventListener('scroll', function() {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(updateActiveDot, 50);
        }, { passive: true });
      } else {
        dotsContainer.innerHTML = '';
      }
    }

    function updateActiveDot() {
      if (!grid || cards.length === 0) return;

      const scrollLeft = grid.scrollLeft;
      const gridWidth = grid.offsetWidth;
      const center = scrollLeft + gridWidth / 2;

      let closestIndex = 0;
      let closestDistance = Infinity;

      cards.forEach(function(card, index) {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const distance = Math.abs(center - cardCenter);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      const dots = dotsContainer.querySelectorAll('.prime-compare__dot');
      dots.forEach(function(dot, index) {
        if (index === closestIndex) {
          dot.classList.add('prime-compare__dot--active');
          dot.setAttribute('aria-selected', 'true');
        } else {
          dot.classList.remove('prime-compare__dot--active');
          dot.setAttribute('aria-selected', 'false');
        }
      });
    }

    // Initialize
    initDots();

    // Re-initialize on resize
    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(initDots, 250);
    });
  })();
</script>

{% schema %}
{
  "name": "Prime Rawhide Comparison",
  "tag": "section",
  "class": "prime-rawhide-comparison-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why dogs (and their humans) choose Prime over rawhide"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how our all-natural yak chews compare to traditional rawhide — the difference is clear."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop Rawhide-Free Chews"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL",
      "default": "/collections/all"
    },
    {
      "type": "select",
      "id": "background_style",
