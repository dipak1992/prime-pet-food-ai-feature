{% comment %}
  Section: #PrimeCalmTime Community Showcase
  Displays a curated grid of customer UGC posts tagged #PrimeCalmTime.
  Encourages community participation and social proof.

  Usage: Add to homepage, product pages, or any template via theme editor.
{% endcomment %}

{% liquid
  assign instagram_url = settings.social_instagram_link | default: 'https://www.instagram.com/foodprimepet/'
  assign tiktok_url = settings.social_tiktok_link | default: 'https://www.tiktok.com/@primepetfood'
  assign fallback_images = 'prime-calmtime-golden-retriever.jpg|prime-calmtime-german-shepherd.jpg|prime-calmtime-labrador.jpg|prime-calmtime-french-bulldog.jpg|prime-calmtime-beagle.jpg|prime-calmtime-poodle.jpg' | split: '|'
%}

<section id="primecalmtime" class="pcc" aria-label="#PrimeCalmTime community showcase">
  <div class="pcc__inner page-width">

    {%- comment -%} Header {%- endcomment -%}
    <header class="pcc__header">
      <p class="pcc__eyebrow">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
        {{ section.settings.eyebrow | default: "#PrimeCalmTime" }}
      </p>
      <h2 class="pcc__title">{{ section.settings.title | default: "Real dogs. Real calm. Real chews." }}</h2>
      <p class="pcc__subtitle">{{ section.settings.subtitle | default: "Join thousands of dog parents sharing their pup's calm-time moments. Tag your photos with #PrimeCalmTime for a chance to be featured." }}</p>
      <div class="pcc__social-links" aria-label="Follow Prime Pet Food">
        <a href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" class="pcc__social-link pcc__social-link--instagram">
          {%- render 'icon-instagram' -%}
          Instagram
        </a>
        <a href="{{ tiktok_url }}" target="_blank" rel="noopener noreferrer" class="pcc__social-link pcc__social-link--tiktok">
          {%- render 'icon-tiktok' -%}
          TikTok
        </a>
      </div>
    </header>

    {%- comment -%} UGC Card Grid {%- endcomment -%}
    <div class="pcc__grid" role="list">

      {%- for block in section.blocks -%}
        {%- if block.type == 'ugc_post' -%}
          {%- assign fallback_index = forloop.index0 | modulo: fallback_images.size -%}
          {%- assign fallback_image = fallback_images[fallback_index] -%}
          {%- assign platform = 'Instagram' -%}
          {%- if forloop.index0 == 1 or forloop.index0 == 3 or forloop.index0 == 5 -%}
            {%- assign platform = 'TikTok' -%}
          {%- endif -%}
          <article class="pcc__card" role="listitem" {{ block.shopify_attributes }}>
            <div class="pcc__card-image-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.alt_text | default: block.settings.dog_name | append: ' enjoying a Prime yak chew' }}"
                  class="pcc__card-img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- else -%}
                <img
                  src="{{ fallback_image | asset_url }}"
                  alt="{{ block.settings.dog_name | default: 'Prime Pet Food customer dog' }} enjoying a Prime yak chew"
                  class="pcc__card-img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- endif -%}

              <div class="pcc__platform-badge" aria-label="{{ platform }} post">{{ platform }}</div>

              {%- comment -%} Duration badge overlay {%- endcomment -%}
              {%- if block.settings.chew_duration != blank -%}
                <div class="pcc__card-duration" aria-label="Chew duration: {{ block.settings.chew_duration }}">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  {{ block.settings.chew_duration }}
                </div>
              {%- endif -%}

              {%- comment -%} Verified badge {%- endcomment -%}
              <div class="pcc__card-verified" aria-label="Verified customer">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Verified
              </div>
            </div>

            <div class="pcc__card-body">
              {%- if block.settings.caption != blank -%}
                <p class="pcc__card-caption">&ldquo;{{ block.settings.caption }}&rdquo;</p>
              {%- endif -%}
              <div class="pcc__card-meta">
                <div class="pcc__card-owner">
                  <span class="pcc__card-dog">{{ block.settings.dog_name | default: 'A happy pup' }}</span>
                  {%- if block.settings.breed != blank -%}
                    <span class="pcc__card-breed">{{ block.settings.breed }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.handle != blank -%}
                  <span class="pcc__card-handle">@{{ block.settings.handle }}</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Default placeholder cards when no blocks are added {%- endcomment -%}
        {%- assign placeholder_names = 'Biscuit,Koda,Maple,Luna,Scout,Winnie' | split: ',' -%}
        {%- assign placeholder_breeds = 'Golden Retriever,German Shepherd,Labrador,French Bulldog,Beagle,Poodle Mix' | split: ',' -%}
        {%- assign placeholder_durations = '82 min,71 min,64 min,48 min,57 min,62 min' | split: ',' -%}
        {%- assign placeholder_captions = 'He barely moved for over an hour. Best purchase ever!,Finally found something that keeps her busy during my work calls.,Maple is obsessed. We go through one a week now.,Luna finally has a calm evening routine.,Scout takes his chew to the same sunny spot every day.,Winnie settles in before I even finish making coffee.' | split: ',' -%}
        {%- assign placeholder_handles = 'biscuit_the_golden,koda_adventures,maple_lab_life,luna_chews,scout_sits,winnie_at_home' | split: ',' -%}
        {%- assign placeholder_images = 'prime-calmtime-golden-retriever,prime-calmtime-german-shepherd,prime-calmtime-labrador,prime-calmtime-french-bulldog,prime-calmtime-beagle,prime-calmtime-poodle' | split: ',' -%}

        {%- for i in (0..5) -%}
          <article class="pcc__card" role="listitem">
            <div class="pcc__card-image-wrap">
              <img
                src="{{ placeholder_images[i] | append: '.jpg' | asset_url }}"
                alt="{{ placeholder_names[i] }} the {{ placeholder_breeds[i] }} enjoying a Prime yak chew"
                class="pcc__card-img"
                loading="lazy"
                width="600"
                height="600"
              >
              <div class="pcc__card-duration" aria-label="Chew duration: {{ placeholder_durations[i] }}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                {{ placeholder_durations[i] }}
              </div>
              <div class="pcc__card-verified" aria-label="Verified customer">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Verified
              </div>
            </div>
            <div class="pcc__card-body">
              <p class="pcc__card-caption">&ldquo;{{ placeholder_captions[i] }}&rdquo;</p>
              <div class="pcc__card-meta">
                <div class="pcc__card-owner">
                  <span class="pcc__card-dog">{{ placeholder_names[i] }}</span>
                  <span class="pcc__card-breed">{{ placeholder_breeds[i] }}</span>
                </div>
                <span class="pcc__card-handle">@{{ placeholder_handles[i] }}</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}

    </div>

    {%- comment -%} CTA to join community {%- endcomment -%}
    <div class="pcc__cta-wrap">
      <div class="pcc__cta-card">
        <div class="pcc__cta-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="4"/>
            <circle cx="12" cy="12" r="3.2"/>
            <path d="M17.5 8.5h.01"/>
          </svg>
        </div>
        <div class="pcc__cta-text">
          <strong>{{ section.settings.cta_heading | default: "Share your dog's calm-time moment" }}</strong>
          <span>{{ section.settings.cta_subtext | default: "Tag @primepetfood and use #PrimeCalmTime on Instagram or TikTok. We feature real dogs every week." }}</span>
        </div>
        <div class="pcc__cta-actions">
          <a href="{{ section.settings.cta_url | default: instagram_url }}" class="pcc__cta-btn" target="_blank" rel="noopener noreferrer" aria-label="{{ section.settings.cta_label | default: 'Follow on Instagram' }}">
            {%- render 'icon-instagram' -%}
            {{ section.settings.cta_label | default: 'Follow on Instagram' }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
          <a href="{{ tiktok_url }}" class="pcc__cta-btn pcc__cta-btn--secondary" target="_blank" rel="noopener noreferrer" aria-label="Follow on TikTok">
            {%- render 'icon-tiktok' -%}
            Follow on TikTok
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .pcc {
    padding: 72px 24px;
    background: {{ section.settings.bg_color | default: "#FDFCF7" }};
    font-family: var(--font-body-family, -apple-system, sans-serif);
  }

  .pcc__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .pcc__header {
    text-align: center;
    margin: 0 auto 42px;
    max-width: 720px;
  }

  .pcc__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #c2410c;
    margin: 0 0 12px;
  }

  .pcc__title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .pcc__subtitle {
    font-size: 16px;
    color: #6b7280;
    margin: 0 auto;
    max-width: 560px;
    line-height: 1.6;
  }

  .pcc__social-links {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 22px;
  }

  .pcc__social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    border: 1px solid rgba(26, 26, 26, 0.1);
    border-radius: 999px;
    background: #fff;
    color: #1a1a1a;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 760;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 10px 26px rgba(22, 19, 15, 0.06);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .pcc__social-link:hover {
    transform: translateY(-1px);
    border-color: rgba(194, 65, 12, 0.28);
    box-shadow: 0 16px 36px rgba(22, 19, 15, 0.1);
  }

  .pcc__social-link svg {
    width: 18px;
    height: 18px;
  }

  /* ── Grid ── */
  .pcc__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0 auto 40px;
    max-width: 1040px;
  }

  /* ── Card ── */
  .pcc__card {
    background: #fff;
    border: 1px solid rgba(26, 26, 26, 0.08);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 14px 40px rgba(22, 19, 15, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pcc__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 54px rgba(22, 19, 15, 0.13);
  }

  .pcc__card-image-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #efe8dc;
  }

  .pcc__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .pcc__card-image-wrap::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(23, 21, 18, 0.52) 100%);
  }

  .pcc__card:hover .pcc__card-img {
    transform: scale(1.04);
  }

  .pcc__card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #9ca3af;
    font-size: 13px;
  }

  /* Duration badge */
  .pcc__card-duration {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    padding: 5px 10px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2px;
  }

  .pcc__platform-badge {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 780;
    line-height: 1;
    letter-spacing: 0.02em;
    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
  }

  /* Verified badge */
  .pcc__card-verified {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(47, 111, 70, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    padding: 4px 9px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
  }

  /* Card body */
  .pcc__card-body {
    padding: 17px;
  }

  .pcc__card-caption {
    font-size: 14px;
    line-height: 1.5;
    color: #374151;
    margin: 0 0 12px;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pcc__card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .pcc__card-owner {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .pcc__card-dog {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .pcc__card-breed {
    font-size: 12px;
    color: #9ca3af;
  }

  .pcc__card-handle {
    font-size: 12px;
    color: #c2410c;
    font-weight: 600;
    white-space: nowrap;
  }

  /* ── CTA wrap ── */
  .pcc__cta-wrap {
    margin-top: 8px;
  }

  .pcc__cta-card {
    display: flex;
    align-items: center;
    gap: 20px;
    background:
      radial-gradient(circle at top left, rgba(194, 65, 12, 0.08), transparent 34%),
      linear-gradient(135deg, #fff7ed 0%, #fef3c7 100%);
    border: 1px solid rgba(194, 65, 12, 0.15);
    border-radius: 20px;
    padding: 24px 28px;
    flex-wrap: wrap;
  }

  .pcc__cta-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(194, 65, 12, 0.1);
    border-radius: 14px;
    color: #c2410c;
  }

  .pcc__cta-text {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pcc__cta-text strong {
    font-size: 16px;
    font-weight: 800;
    color: #1a1a1a;
  }

  .pcc__cta-text span {
    font-size: 14px;
    color: #6b7280;
    line-height: 1.5;
  }

  .pcc__cta-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .pcc__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #c2410c;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 100px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .pcc__cta-btn svg.icon,
  .pcc__cta-btn svg.icon-instagram,
  .pcc__cta-btn svg.icon-tiktok {
    width: 16px;
    height: 16px;
  }

  .pcc__cta-btn:hover {
    background: #9a3412;
    transform: translateY(-1px);
  }

  .pcc__cta-btn--secondary {
    border: 1px solid rgba(26, 26, 26, 0.14);
    background: #1a1a1a;
  }

  .pcc__cta-btn--secondary:hover {
    background: #2f2a25;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .pcc {
      padding: 52px 0;
      overflow: hidden;
    }

    .pcc__header,
    .pcc__cta-wrap {
      padding-inline: 16px;
    }

    .pcc__grid {
      display: flex;
      gap: 14px;
      max-width: none;
      margin-inline: 0;
      padding: 0 16px 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .pcc__grid::-webkit-scrollbar {
      display: none;
    }

    .pcc__card {
      flex: 0 0 min(78vw, 320px);
      scroll-snap-align: start;
    }

    .pcc__cta-card {
      flex-direction: column;
      text-align: center;
      padding: 20px;
    }

    .pcc__cta-text {
      align-items: center;
    }

    .pcc__cta-actions {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .pcc__header {
      text-align: left;
      margin-bottom: 28px;
    }

    .pcc__social-links {
      justify-content: flex-start;
    }

    .pcc__subtitle {
      margin-left: 0;
    }

    .pcc__card {
      flex-basis: min(84vw, 318px);
    }

    .pcc__cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "CalmTime Community",
  "tag": "section",
  "class": "prime-calmtime-community",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "#PrimeCalmTime"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Real dogs. Real calm. Real chews."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Swipe through real calm-time moments from Prime Pet Food dogs, then follow along on Instagram and TikTok."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FDFCF7"
    },
    {
      "type": "header",
      "content": "Community CTA"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Share your dog's calm-time moment"
    },
    {
      "type": "textarea",
      "id": "cta_subtext",
      "label": "CTA subtext",
      "default": "Tag @foodprimepet and use #PrimeCalmTime on Instagram or TikTok. We feature real dogs every week."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link URL"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Follow on Instagram"
    }
  ],
  "blocks": [
    {
      "type": "ugc_post",
      "name": "UGC Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Customer caption / quote"
        },
        {
          "type": "text",
          "id": "dog_name",
          "label": "Dog's name",
          "default": "Biscuit"
        },
        {
          "type": "text",
          "id": "breed",
          "label": "Breed",
          "default": "Golden Retriever"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Instagram / TikTok handle (without @)"
        },
        {
          "type": "text",
          "id": "chew_duration",
          "label": "Chew duration (e.g. 78 min)",
          "info": "Shown as a badge overlay on the photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "#PrimeCalmTime Community",
      "blocks": [
        {
          "type": "ugc_post",
          "settings": {
            "dog_name": "Biscuit",
            "breed": "Golden Retriever",
            "handle": "biscuit_the_golden",
            "caption": "He barely moved for over an hour. Best purchase ever!",
            "chew_duration": "82 min"
          }
        },
        {
