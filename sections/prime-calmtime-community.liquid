{% comment %}
  Section: #PrimeCalmTime Community Showcase
  Displays a curated grid of customer UGC posts tagged #PrimeCalmTime.
  Encourages community participation and social proof.

  Usage: Add to homepage, product pages, or any template via theme editor.
{% endcomment %}

<section class="pcc" aria-label="#PrimeCalmTime community showcase">
  <div class="pcc__inner page-width">

    {%- comment -%} Header {%- endcomment -%}
    <header class="pcc__header">
      <p class="pcc__eyebrow">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
        {{ section.settings.eyebrow | default: '#PrimeCalmTime' }}
      </p>
      <h2 class="pcc__title">{{ section.settings.title | default: 'Real dogs. Real calm. Real chews.' }}</h2>
      <p class="pcc__subtitle">{{ section.settings.subtitle | default: 'Join thousands of dog parents sharing their pup\'s calm-time moments. Tag your photos with #PrimeCalmTime for a chance to be featured.' }}</p>
    </header>

    {%- comment -%} UGC Card Grid {%- endcomment -%}
    <div class="pcc__grid" role="list">

      {%- for block in section.blocks -%}
        {%- if block.type == 'ugc_post' -%}
          <article class="pcc__card" role="listitem" {{ block.shopify_attributes }}>
            <div class="pcc__card-image-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.alt_text | default: block.settings.dog_name | append: ' enjoying a Prime yak chew' }}"
                  class="pcc__card-img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- else -%}
                <div class="pcc__card-placeholder" aria-hidden="true">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                  <span>Photo coming soon</span>
                </div>
              {%- endif -%}

              {%- comment -%} Duration badge overlay {%- endcomment -%}
              {%- if block.settings.chew_duration != blank -%}
                <div class="pcc__card-duration" aria-label="Chew duration: {{ block.settings.chew_duration }}">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  {{ block.settings.chew_duration }}
                </div>
              {%- endif -%}

              {%- comment -%} Verified badge {%- endcomment -%}
              <div class="pcc__card-verified" aria-label="Verified customer">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Verified
              </div>
            </div>

            <div class="pcc__card-body">
              {%- if block.settings.caption != blank -%}
                <p class="pcc__card-caption">&ldquo;{{ block.settings.caption }}&rdquo;</p>
              {%- endif -%}
              <div class="pcc__card-meta">
                <div class="pcc__card-owner">
                  <span class="pcc__card-dog">{{ block.settings.dog_name | default: 'A happy pup' }}</span>
                  {%- if block.settings.breed != blank -%}
                    <span class="pcc__card-breed">{{ block.settings.breed }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.handle != blank -%}
                  <span class="pcc__card-handle">@{{ block.settings.handle }}</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Default placeholder cards when no blocks are added {%- endcomment -%}
        {%- assign placeholder_cards = 'golden,shepherd,lab' | split: ',' -%}
        {%- assign placeholder_names = 'Biscuit,Koda,Maple' | split: ',' -%}
        {%- assign placeholder_breeds = 'Golden Retriever,German Shepherd,Labrador' | split: ',' -%}
        {%- assign placeholder_durations = '82 min,71 min,64 min' | split: ',' -%}
        {%- assign placeholder_captions = 'He barely moved for over an hour. Best purchase ever!,Finally found something that keeps her busy during my work calls.,Maple is obsessed. We go through one a week now.' | split: ',' -%}
        {%- assign placeholder_handles = 'biscuit_the_golden,koda_adventures,maple_lab_life' | split: ',' -%}
        {%- assign placeholder_images = 'prime-ugc-golden-retriever-chew-card,prime-ugc-german-shepherd-chew-card,prime-ugc-golden-retriever-chew-card' | split: ',' -%}

        {%- for i in (0..2) -%}
          <article class="pcc__card" role="listitem">
            <div class="pcc__card-image-wrap">
              <img
                src="{{ placeholder_images[i] | append: '.jpg' | asset_url }}"
                alt="{{ placeholder_names[i] }} the {{ placeholder_breeds[i] }} enjoying a Prime yak chew"
                class="pcc__card-img"
                loading="lazy"
                width="600"
                height="600"
              >
              <div class="pcc__card-duration" aria-label="Chew duration: {{ placeholder_durations[i] }}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                {{ placeholder_durations[i] }}
              </div>
              <div class="pcc__card-verified" aria-label="Verified customer">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Verified
              </div>
            </div>
            <div class="pcc__card-body">
              <p class="pcc__card-caption">&ldquo;{{ placeholder_captions[i] }}&rdquo;</p>
              <div class="pcc__card-meta">
                <div class="pcc__card-owner">
                  <span class="pcc__card-dog">{{ placeholder_names[i] }}</span>
                  <span class="pcc__card-breed">{{ placeholder_breeds[i] }}</span>
                </div>
                <span class="pcc__card-handle">@{{ placeholder_handles[i] }}</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}

    </div>

    {%- comment -%} CTA to join community {%- endcomment -%}
    <div class="pcc__cta-wrap">
      <div class="pcc__cta-card">
        <div class="pcc__cta-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
          </svg>
        </div>
        <div class="pcc__cta-text">
          <strong>{{ section.settings.cta_heading | default: 'Share your dog\'s calm-time moment' }}</strong>
          <span>{{ section.settings.cta_subtext | default: 'Tag @primepetfood and use #PrimeCalmTime on Instagram or TikTok. We feature real dogs every week.' }}</span>
        </div>
        {%- if section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="pcc__cta-btn" target="_blank" rel="noopener noreferrer" aria-label="{{ section.settings.cta_label | default: 'Share on Instagram' }}">
            {{ section.settings.cta_label | default: 'Share on Instagram' }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<style>
  .pcc {
    padding: 72px 24px;
    background: {{ section.settings.bg_color | default: '#FDFCF7' }};
    font-family: var(--font-body-family, -apple-system, sans-serif);
  }

  .pcc__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .pcc__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .pcc__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #c2410c;
    margin: 0 0 12px;
  }

  .pcc__title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .pcc__subtitle {
    font-size: 16px;
    color: #6b7280;
    margin: 0 auto;
    max-width: 560px;
    line-height: 1.6;
  }

  /* ── Grid ── */
  .pcc__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  /* ── Card ── */
  .pcc__card {
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pcc__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .pcc__card-image-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f3f4f6;
  }

  .pcc__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .pcc__card:hover .pcc__card-img {
    transform: scale(1.04);
  }

  .pcc__card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #9ca3af;
    font-size: 13px;
  }

  /* Duration badge */
  .pcc__card-duration {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    padding: 5px 10px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2px;
  }

  /* Verified badge */
  .pcc__card-verified {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(47, 111, 70, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    padding: 4px 9px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
  }

  /* Card body */
  .pcc__card-body {
    padding: 16px;
  }

  .pcc__card-caption {
    font-size: 14px;
    line-height: 1.5;
    color: #374151;
    margin: 0 0 12px;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pcc__card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .pcc__card-owner {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .pcc__card-dog {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .pcc__card-breed {
    font-size: 12px;
    color: #9ca3af;
  }

  .pcc__card-handle {
    font-size: 12px;
    color: #c2410c;
    font-weight: 600;
    white-space: nowrap;
  }

  /* ── CTA wrap ── */
  .pcc__cta-wrap {
    margin-top: 8px;
  }

  .pcc__cta-card {
    display: flex;
    align-items: center;
    gap: 20px;
    background: linear-gradient(135deg, #fff7ed 0%, #fef3c7 100%);
    border: 1px solid rgba(194, 65, 12, 0.15);
    border-radius: 20px;
    padding: 24px 28px;
    flex-wrap: wrap;
  }

  .pcc__cta-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(194, 65, 12, 0.1);
    border-radius: 14px;
    color: #c2410c;
  }

  .pcc__cta-text {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pcc__cta-text strong {
    font-size: 16px;
    font-weight: 800;
    color: #1a1a1a;
  }

  .pcc__cta-text span {
    font-size: 14px;
    color: #6b7280;
    line-height: 1.5;
  }

  .pcc__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #c2410c;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 100px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .pcc__cta-btn:hover {
    background: #9a3412;
    transform: translateY(-1px);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .pcc {
      padding: 48px 16px;
    }

    .pcc__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .pcc__cta-card {
      flex-direction: column;
      text-align: center;
      padding: 20px;
    }

    .pcc__cta-text {
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .pcc__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "#PrimeCalmTime Community",
  "tag": "section",
  "class": "prime-calmtime-community",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "#PrimeCalmTime"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Real dogs. Real calm. Real chews."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Join thousands of dog parents sharing their pup's calm-time moments. Tag your photos with #PrimeCalmTime for a chance to be featured."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FDFCF7"
    },
    {
      "type": "header",
      "content": "Community CTA"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Share your dog's calm-time moment"
    },
    {
      "type": "textarea",
      "id": "cta_subtext",
      "label": "CTA subtext",
      "default": "Tag @primepetfood and use #PrimeCalmTime on Instagram or TikTok. We feature real dogs every week."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link URL"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Share on Instagram"
    }
  ],
  "blocks": [
    {
      "type": "ugc_post",
      "name": "UGC Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Customer caption / quote"
        },
        {
          "type": "text",
          "id": "dog_name",
          "label": "Dog's name",
          "default": "Biscuit"
        },
        {
          "type": "text",
          "id": "breed",
          "label": "Breed",
          "default": "Golden Retriever"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Instagram / TikTok handle (without @)"
        },
        {
          "type": "text",
          "id": "chew_duration",
          "label": "Chew duration (e.g. 78 min)",
          "info": "Shown as a badge overlay on the photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "#PrimeCalmTime Community",
      "blocks": [
        {
          "type": "ugc_post",
          "settings": {
            "dog_name": "Biscuit",
            "breed": "Golden Retriever",
            "handle": "biscuit_the_golden",
            "caption": "He barely moved for over an hour. Best purchase ever!",
            "chew_duration": "82 min"
          }
        },
        {
          "type": "ugc_post",
          "settings": {
            "dog_name": "Koda",
            "breed": "German Shepherd",
            "handle": "koda_adventures",
            "caption": "Finally found something that keeps her busy during my work calls.",
            "chew_duration": "71 min"
          }
        },
        {
          "type": "ugc_post",
          "settings": {
            "dog_name": "Maple",
            "breed": "Labrador",
            "handle": "maple_lab_life",
            "caption": "Maple is obsessed. We go through one a week now.",
            "chew_duration": "64 min"
          }
        }
      ]
    }
  ]
}
{% endschema %}
