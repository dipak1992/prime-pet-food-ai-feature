{% comment %}
  Section: Authentic UGC Video Community
  Video-first social proof showing real dogs aggressively chewing Prime yak chews
  in actual residential environments. Raw, unpolished, authentic.

  Usage: Homepage, product pages, or any template via theme editor.
{% endcomment %}

{% liquid
  assign instagram_url = settings.social_instagram_link | default: 'https://www.instagram.com/foodprimepet/'
  assign tiktok_url = settings.social_tiktok_link | default: 'https://www.tiktok.com/@primepetfood'
%}

<section id="primecalmtime" class="pcc-ugc" aria-label="Real customer videos">
  <div class="pcc-ugc__inner page-width">

    {%- comment -%} Header — raw, no-nonsense {%- endcomment -%}
    <header class="pcc-ugc__header">
      <p class="pcc-ugc__eyebrow">{{ section.settings.eyebrow | default: "Straight from their living rooms" }}</p>
      <h2 class="pcc-ugc__title">{{ section.settings.title | default: "Dogs don't fake it. Neither do these videos." }}</h2>
      <p class="pcc-ugc__subtitle">{{ section.settings.subtitle | default: "Unscripted. Unfiltered. Real dogs destroying their Prime yak chews on real couches." }}</p>
    </header>

    {%- comment -%} Video Grid {%- endcomment -%}
    <div class="pcc-ugc__grid" role="list">

      {%- for block in section.blocks -%}
        {%- if block.type == 'ugc_video' -%}
          <article class="pcc-ugc__card" role="listitem" {{ block.shopify_attributes }}>
            <div class="pcc-ugc__video-wrap">
              {%- if block.settings.video_url != blank -%}
                <video
                  class="pcc-ugc__video"
                  src="{{ block.settings.video_url }}"
                  poster="{{ block.settings.poster | image_url: width: 600 | default: '' }}"
                  playsinline
                  muted
                  loop
                  preload="metadata"
                  aria-label="{{ block.settings.dog_name | default: 'Customer dog' }} chewing a Prime yak chew"
                ></video>
                <button class="pcc-ugc__play-btn" aria-label="Play video" type="button">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </button>
              {%- elsif block.settings.poster != blank -%}
                <img
                  src="{{ block.settings.poster | image_url: width: 600 }}"
                  alt="{{ block.settings.dog_name | default: 'Customer dog' }} with a Prime yak chew"
                  class="pcc-ugc__poster"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {%- else -%}
                <div class="pcc-ugc__placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </div>
              {%- endif -%}

              {%- if block.settings.verified -%}
                <span class="pcc-ugc__verified">✓ Real customer</span>
              {%- endif -%}
            </div>

            <div class="pcc-ugc__card-body">
              {%- if block.settings.caption != blank -%}
                <p class="pcc-ugc__caption">"{{ block.settings.caption }}"</p>
              {%- endif -%}
              <div class="pcc-ugc__meta">
                <span class="pcc-ugc__dog-name">{{ block.settings.dog_name | default: 'Good boy' }}</span>
                {%- if block.settings.location != blank -%}
                  <span class="pcc-ugc__location">{{ block.settings.location }}</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Default placeholder videos when no blocks are added {%- endcomment -%}
        {%- assign placeholder_names = 'Tank,Rosie,Bear,Penny,Duke,Mochi' | split: ',' -%}
        {%- assign placeholder_locations = 'Austin TX,Portland OR,Denver CO,Brooklyn NY,Nashville TN,Seattle WA' | split: ',' -%}
        {%- assign placeholder_captions = "He won't move until it's gone. 45 minutes of silence.,She dragged it under the coffee table and went to town.,Bear gets aggressive with these — in the best way.,Our couch has teeth marks now but she's happy so whatever.,Duke literally growls if you get near his chew. Obsessed.,Mochi takes hers to the bedroom rug every single time." | split: ',' -%}

        {%- for i in (0..5) -%}
          <article class="pcc-ugc__card" role="listitem">
            <div class="pcc-ugc__video-wrap">
              <div class="pcc-ugc__placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
                <span>Video from @{{ placeholder_names[i] | downcase }}_chews</span>
              </div>
              <span class="pcc-ugc__verified">✓ Real customer</span>
            </div>
            <div class="pcc-ugc__card-body">
              <p class="pcc-ugc__caption">"{{ placeholder_captions[i] }}"</p>
              <div class="pcc-ugc__meta">
                <span class="pcc-ugc__dog-name">{{ placeholder_names[i] }}</span>
                <span class="pcc-ugc__location">{{ placeholder_locations[i] }}</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}

    </div>

    {%- comment -%} CTA — submit your video {%- endcomment -%}
    <div class="pcc-ugc__cta">
      <p class="pcc-ugc__cta-text">
        <strong>{{ section.settings.cta_heading | default: "Film your dog. Tag us. Get featured." }}</strong>
        <span>{{ section.settings.cta_subtext | default: "No ring lights needed. Just your dog, their chew, and your phone." }}</span>
      </p>
      <div class="pcc-ugc__cta-links">
        <a href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" class="pcc-ugc__cta-btn">
          {%- render 'icon-instagram' -%}
          @foodprimepet
        </a>
        <a href="{{ tiktok_url }}" target="_blank" rel="noopener noreferrer" class="pcc-ugc__cta-btn pcc-ugc__cta-btn--alt">
          {%- render 'icon-tiktok' -%}
          @primepetfood
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .pcc-ugc {
    background: {{ section.settings.bg_color | default: '#1a1a1a' }};
    color: {{ section.settings.text_color | default: '#f5f5f5' }};
    padding: clamp(48px, 7vw, 88px) 0;
  }

  .pcc-ugc__inner {
    display: grid;
    gap: 40px;
  }

  .pcc-ugc__header {
    max-width: 680px;
  }

  .pcc-ugc__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d2632e;
    margin: 0 0 12px;
  }

  .pcc-ugc__title {
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    margin: 0 0 12px;
    font-weight: 800;
  }

  .pcc-ugc__subtitle {
    font-size: 16px;
    line-height: 1.5;
    opacity: 0.75;
    margin: 0;
  }

  /* Video Grid */
  .pcc-ugc__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .pcc-ugc__card {
    background: rgba(255,255,255,0.04);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pcc-ugc__card:hover {
    transform: translateY(-3px);
    border-color: rgba(210,99,46,0.4);
  }

  .pcc-ugc__video-wrap {
    position: relative;
    aspect-ratio: 3/4;
    background: #0d0d0d;
    overflow: hidden;
  }

  .pcc-ugc__video,
  .pcc-ugc__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pcc-ugc__play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.35);
    border: none;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .pcc-ugc__play-btn:hover {
    background: rgba(0,0,0,0.15);
  }

  .pcc-ugc__play-btn[hidden] {
    display: none;
  }

  .pcc-ugc__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: rgba(255,255,255,0.3);
    font-size: 12px;
  }

  .pcc-ugc__verified {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(0,0,0,0.7);
    color: #4ade80;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }

  .pcc-ugc__card-body {
    padding: 14px 16px 18px;
  }

  .pcc-ugc__caption {
    font-size: 14px;
    line-height: 1.45;
    margin: 0 0 10px;
    font-style: italic;
    opacity: 0.85;
  }

  .pcc-ugc__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }

  .pcc-ugc__dog-name {
    font-weight: 700;
    color: #d2632e;
  }

  .pcc-ugc__location {
    opacity: 0.5;
  }

  .pcc-ugc__location::before {
    content: '·';
    margin-right: 8px;
  }

  /* CTA */
  .pcc-ugc__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 24px 28px;
  }

  .pcc-ugc__cta-text {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pcc-ugc__cta-text strong {
    font-size: 16px;
  }

  .pcc-ugc__cta-text span {
    font-size: 13px;
    opacity: 0.6;
  }

  .pcc-ugc__cta-links {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .pcc-ugc__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    background: #d2632e;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .pcc-ugc__cta-btn:hover {
    background: #b8522a;
  }

  .pcc-ugc__cta-btn--alt {
    background: rgba(255,255,255,0.1);
  }

  .pcc-ugc__cta-btn--alt:hover {
    background: rgba(255,255,255,0.18);
  }

  .pcc-ugc__cta-btn svg {
    width: 16px;
    height: 16px;
  }

  /* Responsive */
  @media (max-width: 899px) {
    .pcc-ugc__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .pcc-ugc__cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 599px) {
    .pcc-ugc__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .pcc-ugc__video-wrap {
      aspect-ratio: 4/5;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.pcc-ugc__play-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var video = btn.previousElementSibling;
        if (video && video.tagName === 'VIDEO') {
          video.play();
          btn.hidden = true;
        }
      });
    });

    // Pause when out of viewport
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          var video = entry.target;
          if (!entry.isIntersecting && !video.paused) {
            video.pause();
            var btn = video.nextElementSibling;
            if (btn && btn.classList.contains('pcc-ugc__play-btn')) {
              btn.hidden = false;
            }
          }
        });
      }, { threshold: 0.3 });

      document.querySelectorAll('.pcc-ugc__video').forEach(function(video) {
        observer.observe(video);
      });
    }
  });
</script>

