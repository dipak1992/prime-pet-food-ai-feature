<footer class="prime-footer" role="contentinfo" aria-label="Site footer">

  <!-- ═══════════════════════════════════════════════════════════════
       BRAND STATEMENT — Emotional anchor at top
  ════════════════════════════════════════════════════════════════ -->
  <div class="prime-footer__statement" aria-label="Brand statement">
    <div class="prime-container">
      <h2 class="prime-footer__statement-text">{{ section.settings.brand_statement | default: 'Real chews. Real calm. Real ingredients.' }}</h2>
      <p class="prime-footer__statement-sub">{{ section.settings.brand_subtext | default: 'Made for dogs who deserve better than rawhide.' }}</p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       MAIN FOOTER GRID — Brand + 3 nav columns
  ════════════════════════════════════════════════════════════════ -->
  <div class="prime-footer__main">
    <div class="prime-container">
      <div class="prime-footer__grid">

        <!-- Column 1 — Brand -->
        <div class="prime-footer__brand">
          <a class="prime-footer__logo" href="/" aria-label="{{ shop.name }} home">PRIME</a>
          <p class="prime-footer__brand-desc">{{ section.settings.brand_description | default: 'Premium Himalayan yak chews for dogs who chew hard and owners who care.' }}</p>

          <div class="prime-footer__social" aria-label="Follow us on social media">
            {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram" class="prime-footer__social-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
            {% else %}
            <a href="#" aria-label="Follow us on Instagram" class="prime-footer__social-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
            {% endif %}

            {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Facebook" class="prime-footer__social-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
            {% else %}
            <a href="#" aria-label="Follow us on Facebook" class="prime-footer__social-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
            {% endif %}

            {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer" aria-label="Follow us on TikTok" class="prime-footer__social-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/>
              </svg>
            </a>
            {% else %}
            <a href="#" aria-label="Follow us on TikTok" class="prime-footer__social-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/>
              </svg>
            </a>
            {% endif %}
          </div>

          <span class="prime-footer__badge" aria-label="Packed in USA">Packed in USA 🇺🇸</span>
        </div>

        <!-- Column 2 — Shop -->
        <nav class="prime-footer__nav" aria-label="Shop navigation">
          <h3 class="prime-footer__nav-heading">Shop</h3>
          <ul class="prime-footer__nav-list" role="list">
            {% assign shop_links = section.blocks | where: "type", "nav_link" %}
            {% assign shop_col_links = shop_links | where: "settings.column", "shop" %}
            {% if shop_col_links.size > 0 %}
              {% for block in shop_col_links %}
                <li><a href="{{ block.settings.url | default: '#' }}" class="prime-footer__nav-link">{{ block.settings.label | default: 'Link' }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/collections/all" class="prime-footer__nav-link">All Chews</a></li>
              <li><a href="/collections/small-dogs" class="prime-footer__nav-link">Small Dogs</a></li>
              <li><a href="/collections/medium-dogs" class="prime-footer__nav-link">Medium Dogs</a></li>
              <li><a href="/collections/large-dogs" class="prime-footer__nav-link">Large Dogs</a></li>
              <li><a href="/pages/subscribe-and-save" class="prime-footer__nav-link">Subscribe &amp; Save</a></li>
              <li><a href="/products/gift-cards" class="prime-footer__nav-link">Gift Cards</a></li>
            {% endif %}
          </ul>
        </nav>

        <!-- Column 3 — Learn -->
        <nav class="prime-footer__nav" aria-label="Learn navigation">
          <h3 class="prime-footer__nav-heading">Learn</h3>
          <ul class="prime-footer__nav-list" role="list">
            {% assign learn_col_links = shop_links | where: "settings.column", "learn" %}
            {% if learn_col_links.size > 0 %}
              {% for block in learn_col_links %}
                <li><a href="{{ block.settings.url | default: '#' }}" class="prime-footer__nav-link">{{ block.settings.label | default: 'Link' }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/pages/about-us" class="prime-footer__nav-link">Our Story</a></li>
              <li><a href="/pages/how-himalayan-yak-cheese-chews-are-made" class="prime-footer__nav-link">How It's Made</a></li>
              <li><a href="/pages/ingredients" class="prime-footer__nav-link">Ingredients</a></li>
              <li><a href="/blogs/dog-behavior" class="prime-footer__nav-link">Blog</a></li>
              <li><a href="/pages/faq" class="prime-footer__nav-link">FAQ</a></li>
              <li><a href="/pages/puff-instructions" class="prime-footer__nav-link">Puff Instructions</a></li>
            {% endif %}
          </ul>
        </nav>

        <!-- Column 4 — Support -->
        <nav class="prime-footer__nav" aria-label="Support navigation">
          <h3 class="prime-footer__nav-heading">Support</h3>
          <ul class="prime-footer__nav-list" role="list">
            {% assign support_col_links = shop_links | where: "settings.column", "support" %}
            {% if support_col_links.size > 0 %}
              {% for block in support_col_links %}
                <li><a href="{{ block.settings.url | default: '#' }}" class="prime-footer__nav-link">{{ block.settings.label | default: 'Link' }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/pages/contact" class="prime-footer__nav-link">Contact Us</a></li>
              <li><a href="/pages/shipping-policy" class="prime-footer__nav-link">Shipping &amp; Returns</a></li>
              <li><a href="/pages/track-order" class="prime-footer__nav-link">Track Order</a></li>
              <li><a href="/pages/wholesale" class="prime-footer__nav-link">Wholesale</a></li>
              <li><a href="/pages/accessibility" class="prime-footer__nav-link">Accessibility</a></li>
            {% endif %}
          </ul>
        </nav>

      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       EMAIL SIGNUP STRIP
  ════════════════════════════════════════════════════════════════ -->
  <div class="prime-footer__email-strip" aria-label="Email newsletter signup">
    <div class="prime-container">
      <div class="prime-footer__email-inner">
        <p class="prime-footer__email-heading">{{ section.settings.email_heading | default: 'Get chew tips, dog stories, and the occasional discount.' }}</p>
        <form
          class="prime-footer__email-form"
          action="/contact#contact_form"
          method="post"
          accept-charset="UTF-8"
          id="prime-footer-email-form"
          aria-label="Email newsletter signup form"
        >
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="prime-footer__email-field">
            <label for="prime-footer-email-input" class="prime-footer__visually-hidden">Your email address</label>
            <input
              id="prime-footer-email-input"
              type="email"
              name="contact[email]"
              placeholder="Your email address"
              required
              autocomplete="email"
              class="prime-footer__email-input"
              aria-label="Email address for newsletter"
            >
            <button type="submit" class="prime-footer__email-btn" aria-label="Subscribe to newsletter">Subscribe</button>
          </div>
        </form>
        <p class="prime-footer__email-privacy">{{ section.settings.email_privacy | default: 'No spam. Unsubscribe anytime.' }}</p>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       BOTTOM BAR — Copyright + Legal
  ════════════════════════════════════════════════════════════════ -->
  <div class="prime-footer__bottom" role="contentinfo">
    <div class="prime-container">
      <div class="prime-footer__bottom-inner">
        <span class="prime-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} Prime Pet Food. All rights reserved.
        </span>
        <nav class="prime-footer__legal" aria-label="Legal links">
          <a href="/policies/privacy-policy" class="prime-footer__legal-link">Privacy Policy</a>
          <span class="prime-footer__legal-sep" aria-hidden="true">&middot;</span>
          <a href="/policies/terms-of-service" class="prime-footer__legal-link">Terms of Service</a>
          <span class="prime-footer__legal-sep" aria-hidden="true">&middot;</span>
          <a href="/pages/accessibility" class="prime-footer__legal-link">Accessibility</a>
        </nav>
      </div>
    </div>
  </div>

</footer>

<style>
  /* ═══════════════════════════════════════════════════════════════
     PRIME FOOTER REDESIGN — Design tokens & base
     Uses prime-design-system.css custom properties where available
  ════════════════════════════════════════════════════════════════ */

  .prime-footer {
    /* Local tokens — fall back to design system values */
    --pf2-bg:           var(--prime-charcoal, #2C2C2C);
    --pf2-bg-bottom:    #242424;
    --pf2-bg-strip:     #323232;
    --pf2-cream:        var(--prime-cream, #FAF7F2);
    --pf2-cream-60:     rgba(250, 247, 242, 0.60);
    --pf2-cream-70:     rgba(250, 247, 242, 0.70);
    --pf2-terracotta:   var(--prime-terracotta, #C4724F);
    --pf2-terracotta-h: var(--prime-terracotta-hover, #A85D3F);
    --pf2-font-heading: var(--prime-font-heading, Georgia, "Times New Roman", serif);
    --pf2-font-body:    var(--prime-font-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    --pf2-tracking:     var(--prime-tracking-wide, 0.05em);
    --pf2-container:    var(--prime-container-max, 1200px);

    background: var(--pf2-bg);
    color: var(--pf2-cream);
    font-family: var(--pf2-font-body);
    box-sizing: border-box;
  }

  .prime-footer *,
  .prime-footer *::before,
  .prime-footer *::after {
    box-sizing: inherit;
  }

  /* ─── Container ─────────────────────────────────────────────── */
  .prime-footer .prime-container {
    width: min(var(--pf2-container), calc(100% - 48px));
    margin-inline: auto;
  }

  /* ═══════════════════════════════════════════════════════════════
     BRAND STATEMENT — Emotional top anchor
  ════════════════════════════════════════════════════════════════ */
  .prime-footer__statement {
    padding: clamp(64px, 8vw, 100px) 0 clamp(48px, 6vw, 72px);
    text-align: center;
    border-bottom: 1px solid rgba(250, 247, 242, 0.10);
  }

  .prime-footer__statement-text {
    margin: 0 0 20px;
    font-family: var(--pf2-font-heading);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 400;
    line-height: var(--prime-leading-tight, 1.1);
    letter-spacing: var(--prime-tracking-tight, -0.02em);
    color: var(--pf2-cream);
    max-width: 820px;
    margin-inline: auto;
    margin-bottom: 20px;
  }

  .prime-footer__statement-sub {
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--pf2-cream-60);
    line-height: var(--prime-leading-normal, 1.6);
    font-style: italic;
    letter-spacing: 0.01em;
  }

  /* ═══════════════════════════════════════════════════════════════
     MAIN FOOTER GRID
  ════════════════════════════════════════════════════════════════ */
  .prime-footer__main {
    padding: clamp(48px, 6vw, 72px) 0;
    border-bottom: 1px solid rgba(250, 247, 242, 0.10);
  }

  .prime-footer__grid {
    display: grid;
    grid-template-columns: minmax(240px, 1.5fr) repeat(3, minmax(140px, 1fr));
    gap: clamp(32px, 4vw, 56px);
    align-items: start;
  }

  /* ─── Brand Column ───────────────────────────────────────────── */
  .prime-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .prime-footer__logo {
    display: inline-block;
    font-family: var(--pf2-font-heading);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 400;
    letter-spacing: var(--pf2-tracking);
    color: var(--pf2-cream);
    text-decoration: none;
    line-height: 1;
    margin-bottom: 20px;
    transition: opacity 0.2s ease;
  }

  .prime-footer__logo:hover {
    opacity: 0.8;
  }

  .prime-footer__brand-desc {
    margin: 0 0 28px;
    font-size: 0.9375rem;
    line-height: var(--prime-leading-relaxed, 1.8);
    color: var(--pf2-cream-70);
    max-width: 280px;
  }

  /* ─── Social Icons ───────────────────────────────────────────── */
  .prime-footer__social {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    align-items: center;
  }

  .prime-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--pf2-cream-60);
    text-decoration: none;
    border-radius: 50%;
    border: 1px solid rgba(250, 247, 242, 0.15);
    transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  .prime-footer__social-link:hover,
  .prime-footer__social-link:focus-visible {
    color: var(--pf2-terracotta);
    border-color: var(--pf2-terracotta);
    background: rgba(196, 114, 79, 0.08);
    outline: none;
  }

  .prime-footer__social-link:focus-visible {
    outline: 2px solid var(--pf2-terracotta);
    outline-offset: 2px;
  }

  /* ─── Badge ──────────────────────────────────────────────────── */
  .prime-footer__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 1px solid rgba(250, 247, 242, 0.18);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--pf2-cream-70);
    letter-spacing: 0.02em;
    width: fit-content;
  }

  /* ─── Nav Columns ────────────────────────────────────────────── */
  .prime-footer__nav {
    display: flex;
    flex-direction: column;
  }

  .prime-footer__nav-heading {
    margin: 0 0 20px;
    font-family: var(--pf2-font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--pf2-tracking);
    color: var(--pf2-cream);
  }

  .prime-footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prime-footer__nav-link {
    position: relative;
    display: inline-block;
    color: var(--pf2-cream-70);
    font-size: 0.9375rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 0.2s ease;
    padding-bottom: 1px;
  }

  /* Underline grow-from-left animation */
  .prime-footer__nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--pf2-cream);
    transition: width 0.25s ease;
  }

  .prime-footer__nav-link:hover,
  .prime-footer__nav-link:focus-visible {
    color: var(--pf2-cream);
    outline: none;
  }

  .prime-footer__nav-link:hover::after,
  .prime-footer__nav-link:focus-visible::after {
    width: 100%;
  }

  .prime-footer__nav-link:focus-visible {
    outline: 2px solid var(--pf2-terracotta);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ═══════════════════════════════════════════════════════════════
     EMAIL SIGNUP STRIP
  ════════════════════════════════════════════════════════════════ */
  .prime-footer__email-strip {
    background: var(--pf2-bg-strip);
    padding: clamp(40px, 5vw, 60px) 0;
    border-bottom: 1px solid rgba(250, 247, 242, 0.08);
  }

  .prime-footer__email-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    max-width: 560px;
    margin-inline: auto;
  }

  .prime-footer__email-heading {
    margin: 0;
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: var(--pf2-cream);
    line-height: var(--prime-leading-snug, 1.3);
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .prime-footer__email-field {
    display: flex;
    width: 100%;
    max-width: 480px;
    border: 1px solid rgba(250, 247, 242, 0.25);
    border-radius: 4px;
    overflow: hidden;
    background: rgba(250, 247, 242, 0.05);
    transition: border-color 0.2s ease;
  }

  .prime-footer__email-field:focus-within {
    border-color: rgba(250, 247, 242, 0.55);
  }

  .prime-footer__email-input {
    flex: 1;
    min-width: 0;
    padding: 14px 18px;
    background: transparent;
    border: none;
    color: var(--pf2-cream);
    font-size: 0.9375rem;
    font-family: var(--pf2-font-body);
    outline: none;
  }

  .prime-footer__email-input::placeholder {
    color: var(--pf2-cream-60);
  }

  .prime-footer__email-btn {
    flex-shrink: 0;
    padding: 14px 24px;
    background: var(--pf2-terracotta);
    color: #fff;
    border: none;
    font-size: 0.875rem;
    font-weight: 700;
    font-family: var(--pf2-font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .prime-footer__email-btn:hover {
    background: var(--pf2-terracotta-h);
    transform: scale(1.02);
  }

  .prime-footer__email-btn:active {
    transform: scale(0.99);
  }

  .prime-footer__email-btn:focus-visible {
    outline: 2px solid var(--pf2-cream);
    outline-offset: 2px;
  }

  .prime-footer__email-privacy {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--pf2-cream-60);
    line-height: 1.5;
  }

  /* ═══════════════════════════════════════════════════════════════
     BOTTOM BAR
  ════════════════════════════════════════════════════════════════ */
  .prime-footer__bottom {
    background: var(--pf2-bg-bottom);
    padding: 20px 0;
  }

  .prime-footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .prime-footer__copyright {
    font-size: 0.8125rem;
    color: var(--pf2-cream-60);
    line-height: 1.5;
  }

  .prime-footer__legal {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .prime-footer__legal-link {
    font-size: 0.8125rem;
    color: var(--pf2-cream-60);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .prime-footer__legal-link:hover,
  .prime-footer__legal-link:focus-visible {
    color: var(--pf2-cream);
    outline: none;
  }

  .prime-footer__legal-link:focus-visible {
    outline: 2px solid var(--pf2-terracotta);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .prime-footer__legal-sep {
    color: rgba(250, 247, 242, 0.25);
    font-size: 0.8125rem;
    user-select: none;
  }

  /* ─── Visually hidden utility ────────────────────────────────── */
  .prime-footer__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ═══════════════════════════════════════════════════════════════
     RESPONSIVE — Tablet (≤ 900px)
  ════════════════════════════════════════════════════════════════ */
  @media (max-width: 900px) {
    .prime-footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 32px;
    }

    .prime-footer__brand {
      grid-column: 1 / -1;
    }

    .prime-footer__brand-desc {
      max-width: 100%;
    }

    .prime-footer__statement-text {
      font-size: clamp(1.75rem, 4vw, 2.75rem);
    }

    .prime-footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     RESPONSIVE — Mobile (≤ 560px)
  ════════════════════════════════════════════════════════════════ */
  @media (max-width: 560px) {
    .prime-footer .prime-container {
      width: calc(100% - 32px);
    }

    .prime-footer__statement {
      padding: 48px 0 36px;
    }

    .prime-footer__statement-text {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }

    .prime-footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .prime-footer__brand {
      grid-column: auto;
    }

    .prime-footer__email-field {
      flex-direction: column;
      border-radius: 6px;
    }

    .prime-footer__email-input {
      padding: 14px 16px;
      border-bottom: 1px solid rgba(250, 247, 242, 0.15);
    }

    .prime-footer__email-btn {
      border-radius: 0 0 4px 4px;
      padding: 14px 16px;
      text-align: center;
    }

    .prime-footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .prime-footer__legal {
      gap: 6px;
    }

    .prime-footer__legal-link {
      font-size: 0.75rem;
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     REDUCED MOTION — Respect user preference
  ════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .prime-footer__nav-link::after,
    .prime-footer__social-link,
    .prime-footer__email-btn,
    .prime-footer__logo {
      transition: none;
    }

    .prime-footer__email-btn:hover {
      transform: none;
    }
  }

</style>

<script>
  (function () {
    'use strict';

    /* ─── Email form: minimal progressive enhancement ─────────── */
    var form = document.getElementById('prime-footer-email-form');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      var input = form.querySelector('.prime-footer__email-input');
      var btn   = form.querySelector('.prime-footer__email-btn');
      if (!input || !input.value.trim()) return;

      /* Visual feedback while submitting */
      if (btn) {
        btn.textContent = 'Subscribing\u2026';
        btn.disabled = true;
        btn.style.opacity = '0.75';
      }

      /* Re-enable after 4 s in case of network issues */
      setTimeout(function () {
        if (btn) {
          btn.textContent = 'Subscribe';
          btn.disabled = false;
          btn.style.opacity = '';
        }
      }, 4000);
    });
  })();
</script>

