{% liquid
  assign product_text = product.title | append: ' ' | append: product.handle | append: ' ' | append: product.tags | downcase
  assign product_category = 'classic'

  if product_text contains 'bulk' or product_text contains '2-lb' or product_text contains '2 lb' or product_text contains 'multi-pack' or product_text contains 'multipack'
    assign product_category = 'bulk'
  elsif product_text contains 'flavour' or product_text contains 'flavor' or product_text contains 'peanut' or product_text contains 'bacon' or product_text contains 'cheese flavor' or product_text contains 'flavoured'
    assign product_category = 'flavour'
  endif

  if product_category == 'bulk'
    assign kicker = section.settings.bulk_eyebrow
    assign heading = section.settings.bulk_heading
    assign intro = section.settings.bulk_intro
    assign fit_title = 'Good for'
    assign fit_text = 'Multi-dog homes, repeat yak chew buyers, stronger chewers, and anyone who wants the calm-time drawer stocked before the week gets busy.'
    assign difference_title = 'Why buy bulk'
    assign difference_text = 'You get more chewing sessions on hand, fewer last-minute reorders, and better value for dogs who already have yak chews in their routine.'
    assign routine_title = 'Easy to manage'
    assign routine_text = 'Store the chews sealed in a cool, dry place, rotate sizes by dog, and keep sessions supervised from first bite to final nub.'
    assign note_title = 'More chews, same safety rules'
    assign note_text = 'A larger bag should still be treated as a supervised chew routine. Size up for strong chewers and separate dogs if they guard high-value chews.'
    assign cta_label = 'Choose your bulk mix'
    assign cta_href = '#quick-order-list'
  elsif product_category == 'flavour'
    assign kicker = section.settings.flavour_eyebrow
    assign heading = section.settings.flavour_heading
    assign intro = section.settings.flavour_intro
    assign fit_title = 'Good for'
    assign fit_text = 'Picky dogs, first-time yak chew users, and dogs who need a little more aroma before they settle into a longer chew session.'
    assign difference_title = 'Why dogs notice it'
    assign difference_text = 'The added flavour gives your dog a clearer reason to start chewing, while the dense yak chew texture still supports a slower calm-time routine.'
    assign routine_title = 'Serve it calmly'
    assign routine_text = 'Offer it when your dog can settle, keep fresh water nearby, and remove the chew when the end piece becomes small enough to swallow.'
    assign note_title = 'Taste helps, fit still matters'
    assign note_text = "Choose the chew by your dog's size and chewing style first. Flavour can make the first session easier, but supervision and safe sizing still matter."
    assign cta_label = 'Choose a flavour'
    assign cta_href = product.url
  else
    assign kicker = section.settings.classic_eyebrow
    assign heading = section.settings.classic_heading
    assign intro = section.settings.classic_intro
    assign fit_title = 'Good for'
    assign fit_text = 'Everyday calm-time, post-walk settling, work-from-home focus, and dog parents who want a rawhide-free chew with a short ingredient list.'
    assign difference_title = 'Why this chew'
    assign difference_text = 'Dense Himalayan yak cheese gives your dog a slower chewing job than a soft treat, with low odor and four simple ingredients.'
    assign routine_title = 'Use it safely'
    assign routine_text = 'Match the size to your dog, supervise the session, keep fresh water nearby, and remove the leftover nub before it can be swallowed.'
    assign note_title = 'Start with the right size'
    assign note_text = "If your dog is between sizes or chews with strong jaw pressure, choose the larger size. A chew should never fit fully inside your dog's mouth."
    assign cta_label = 'Choose the right size'
    assign cta_href = product.url
  endif
%}

<section class="pca color-{{ section.settings.color_scheme }} gradient" aria-labelledby="ProductChewFitTitle-{{ section.id }}">
  <div class="pca__inner page-width">
    <div class="pca__header">
      <p class="pca__eyebrow">{{ kicker }}</p>
      <h2 id="ProductChewFitTitle-{{ section.id }}">{{ heading }}</h2>
      <p>{{ intro }}</p>
    </div>

    <div class="pca__grid">
      <article class="pca__card">
        <span>01</span>
        <h3>{{ fit_title }}</h3>
        <p>{{ fit_text }}</p>
      </article>

      <article class="pca__card">
        <span>02</span>
        <h3>{{ difference_title }}</h3>
        <p>{{ difference_text }}</p>
      </article>

      <article class="pca__card">
        <span>03</span>
        <h3>{{ routine_title }}</h3>
        <p>{{ routine_text }}</p>
      </article>
    </div>

    <div class="pca__note">
      <div>
        <h3>{{ note_title }}</h3>
        <p>{{ note_text }}</p>
      </div>
      <a href="{{ cta_href }}" class="pca__button">{{ cta_label }}</a>
    </div>
  </div>
</section>

<style>
  .pca {
    padding: clamp(44px, 6vw, 78px) 0;
  }

  .pca__inner {
    display: grid;
    gap: 26px;
  }

  .pca__header {
    max-width: 820px;
  }

  .pca__eyebrow {
    color: #d2632e;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .pca__header h2 {
    color: #24130d;
    font-size: clamp(28px, 4vw, 46px);
    line-height: 1.08;
    margin: 0 0 14px;
  }

  .pca__header p:last-child {
    color: #5f574e;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.65;
    margin: 0;
  }

  .pca__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pca__card,
  .pca__note {
    background: #fffdf9;
    border: 1px solid #eadfce;
    border-radius: 8px;
  }

  .pca__card {
    padding: 22px;
  }

  .pca__card span {
    color: #d2632e;
    display: inline-block;
    font-size: 13px;
    font-weight: 900;
    margin-bottom: 22px;
  }

  .pca__card h3,
  .pca__note h3 {
    color: #24130d;
    font-size: 20px;
    line-height: 1.2;
    margin: 0 0 10px;
  }

  .pca__card p,
  .pca__note p {
    color: #6f5a50;
    font-size: 14px;
    line-height: 1.58;
    margin: 0;
  }

  .pca__note {
    align-items: center;
    display: flex;
    gap: 22px;
    justify-content: space-between;
    padding: 24px;
  }

  .pca__button {
    align-items: center;
    background: #1f3a2d;
    border-radius: 8px;
    color: #ffffff;
    display: inline-flex;
    flex: 0 0 auto;
    font-size: 14px;
    font-weight: 800;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .pca__grid {
      grid-template-columns: 1fr;
    }

    .pca__note {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

{% schema %}
{
  "name": "Product chew fit guide",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "classic_eyebrow",
      "label": "Classic eyebrow",
      "default": "Everyday yak chew"
    },
    {
      "type": "text",
      "id": "classic_heading",
      "label": "Classic heading",
      "default": "A steady chew for everyday calm-time."
    },
    {
      "type": "textarea",
      "id": "classic_intro",
      "label": "Classic intro",
      "default": "Made for the moments when your dog needs something real to focus on: after a walk, during a work call, or before the house settles down for the night."
    },
    {
      "type": "text",
      "id": "flavour_eyebrow",
      "label": "Flavour eyebrow",
      "default": "Flavour yak chew"
    },
    {
      "type": "text",
      "id": "flavour_heading",
      "label": "Flavour heading",
      "default": "A more tempting start for dogs who need extra interest."
    },
    {
      "type": "textarea",
      "id": "flavour_intro",
      "label": "Flavour intro",
      "default": "The flavour helps invite your dog in, while the dense yak chew gives them the same slow, satisfying chewing routine dog parents come back for."
    },
    {
      "type": "text",
      "id": "bulk_eyebrow",
      "label": "Bulk eyebrow",
      "default": "Bulk yak chews"
    },
    {
      "type": "text",
      "id": "bulk_heading",
      "label": "Bulk heading",
      "default": "Keep calm-time stocked for the dogs who already love them."
    },
    {
      "type": "textarea",
      "id": "bulk_intro",
      "label": "Bulk intro",
      "default": "A practical option for repeat buyers, multi-dog homes, and heavy chewers who go through yak chews as part of a regular supervised routine."
    }
  ],
  "presets": [
    {
      "name": "Product chew fit guide"
    }
  ]
}
{% endschema %}
