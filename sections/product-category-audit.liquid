{% liquid
  assign product_text = product.title | append: ' ' | append: product.handle | append: ' ' | append: product.tags | downcase
  assign product_category = 'classic'

  if product_text contains 'bulk' or product_text contains '2-lb' or product_text contains '2 lb' or product_text contains 'multi-pack' or product_text contains 'multipack'
    assign product_category = 'bulk'
  elsif product_text contains 'flavour' or product_text contains 'flavor' or product_text contains 'peanut' or product_text contains 'bacon' or product_text contains 'cheese flavor' or product_text contains 'flavoured'
    assign product_category = 'flavour'
  endif

  if product_category == 'bulk'
    assign kicker = section.settings.bulk_eyebrow
    assign heading = section.settings.bulk_heading
    assign intro = section.settings.bulk_intro
    assign fit_title = 'Best fit'
    assign fit_text = 'Dog parents who already know their dog enjoys yak chews, multi-dog homes, heavy chewers, and customers who want fewer reorder moments.'
    assign difference_title = 'What changes on this page'
    assign difference_text = 'The decision is less about first-time discovery and more about value, storage, size mix, and keeping a steady calm-time routine stocked.'
    assign routine_title = 'How to use it'
    assign routine_text = 'Keep chews dry, rotate sizes by dog, supervise every session, and remove the small end piece before it can be swallowed.'
    assign note_title = 'Bulk does not mean casual'
    assign note_text = 'A larger bag should still be treated as a supervised chew routine. Size up for strong chewers and separate dogs if they guard high-value chews.'
    assign cta_label = 'Build the bulk order'
    assign cta_href = '#quick-order-list'
  elsif product_category == 'flavour'
    assign kicker = section.settings.flavour_eyebrow
    assign heading = section.settings.flavour_heading
    assign intro = section.settings.flavour_intro
    assign fit_title = 'Best fit'
    assign fit_text = 'Picky dogs, first-time yak chew customers, and dogs who need a little more aroma before they commit to a longer chew session.'
    assign difference_title = 'What changes on this page'
    assign difference_text = 'The flavour is the invitation. The chew still needs to be chosen by size, jaw strength, and supervised use, not just by what sounds tasty.'
    assign routine_title = 'How to use it'
    assign routine_text = 'Offer it during a calm window, let your dog settle into the chew, and remove it when the end piece becomes small enough to swallow.'
    assign note_title = 'Flavour should feel honest'
    assign note_text = 'The page should talk like a dog parent would: clearer appeal for picky dogs, no overpromising, and no pretending flavour replaces proper sizing.'
    assign cta_label = 'Choose a flavour'
    assign cta_href = product.url
  else
    assign kicker = section.settings.classic_eyebrow
    assign heading = section.settings.classic_heading
    assign intro = section.settings.classic_intro
    assign fit_title = 'Best fit'
    assign fit_text = 'Everyday calm-time routines, rawhide-free chewing, and dog parents who want a simple ingredient list with clear safety guidance.'
    assign difference_title = 'What this page should do'
    assign difference_text = 'Help shoppers choose the right chew size, understand the ingredient list, and feel confident about supervision and the puffed nub finish.'
    assign routine_title = 'How to use it'
    assign routine_text = 'Match the size to your dog, supervise the session, provide fresh water, and use the leftover nub as a puff treat once it is safely removed.'
    assign note_title = 'Start with fit, not hype'
    assign note_text = 'A good product page should sound calm and useful. The customer is trying to decide if this chew fits their dog, not read generic treat copy.'
    assign cta_label = 'Choose the right size'
    assign cta_href = product.url
  endif
%}

<section class="pca color-{{ section.settings.color_scheme }} gradient" aria-labelledby="ProductCategoryAuditTitle-{{ section.id }}">
  <div class="pca__inner page-width">
    <div class="pca__header">
      <p class="pca__eyebrow">{{ kicker }}</p>
      <h2 id="ProductCategoryAuditTitle-{{ section.id }}">{{ heading }}</h2>
      <p>{{ intro }}</p>
    </div>

    <div class="pca__grid">
      <article class="pca__card">
        <span>01</span>
        <h3>{{ fit_title }}</h3>
        <p>{{ fit_text }}</p>
      </article>

      <article class="pca__card">
        <span>02</span>
        <h3>{{ difference_title }}</h3>
        <p>{{ difference_text }}</p>
      </article>

      <article class="pca__card">
        <span>03</span>
        <h3>{{ routine_title }}</h3>
        <p>{{ routine_text }}</p>
      </article>
    </div>

    <div class="pca__note">
      <div>
        <h3>{{ note_title }}</h3>
        <p>{{ note_text }}</p>
      </div>
      <a href="{{ cta_href }}" class="pca__button">{{ cta_label }}</a>
    </div>
  </div>
</section>

<style>
  .pca {
    padding: clamp(44px, 6vw, 78px) 0;
  }

  .pca__inner {
    display: grid;
    gap: 26px;
  }

  .pca__header {
    max-width: 820px;
  }

  .pca__eyebrow {
    color: #d2632e;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .pca__header h2 {
    color: #24130d;
    font-size: clamp(28px, 4vw, 46px);
    line-height: 1.08;
    margin: 0 0 14px;
  }

  .pca__header p:last-child {
    color: #5f574e;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.65;
    margin: 0;
  }

  .pca__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pca__card,
  .pca__note {
    background: #fffdf9;
    border: 1px solid #eadfce;
    border-radius: 8px;
  }

  .pca__card {
    padding: 22px;
  }

  .pca__card span {
    color: #d2632e;
    display: inline-block;
    font-size: 13px;
    font-weight: 900;
    margin-bottom: 22px;
  }

  .pca__card h3,
  .pca__note h3 {
    color: #24130d;
    font-size: 20px;
    line-height: 1.2;
    margin: 0 0 10px;
  }

  .pca__card p,
  .pca__note p {
    color: #6f5a50;
    font-size: 14px;
    line-height: 1.58;
    margin: 0;
  }

  .pca__note {
    align-items: center;
    display: flex;
    gap: 22px;
    justify-content: space-between;
    padding: 24px;
  }

  .pca__button {
    align-items: center;
    background: #1f3a2d;
    border-radius: 8px;
    color: #ffffff;
    display: inline-flex;
    flex: 0 0 auto;
    font-size: 14px;
    font-weight: 800;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .pca__grid {
      grid-template-columns: 1fr;
    }

    .pca__note {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

{% schema %}
{
  "name": "Product category audit",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "classic_eyebrow",
      "label": "Classic eyebrow",
      "default": "Classic yak chew page"
    },
    {
      "type": "text",
      "id": "classic_heading",
      "label": "Classic heading",
      "default": "For everyday calm-time, the page needs to help shoppers choose the right fit."
    },
    {
      "type": "textarea",
      "id": "classic_intro",
      "label": "Classic intro",
      "default": "This is the core chew page. It should explain the simple ingredients, the dense texture, the right size choice, and the safest way to finish the chew without sounding like a generic pet treat listing."
    },
    {
      "type": "text",
      "id": "flavour_eyebrow",
      "label": "Flavour eyebrow",
      "default": "Flavour chew page"
    },
    {
      "type": "text",
      "id": "flavour_heading",
      "label": "Flavour heading",
      "default": "For flavour chews, lead with taste appeal but keep the sizing advice clear."
    },
    {
      "type": "textarea",
      "id": "flavour_intro",
      "label": "Flavour intro",
      "default": "Flavour chews should speak to picky dogs and curious first-time buyers. The tone should stay practical: the flavour gets attention, while the chew still needs the right size, supervision, and a calm routine."
    },
    {
      "type": "text",
      "id": "bulk_eyebrow",
      "label": "Bulk eyebrow",
      "default": "Bulk chew page"
    },
    {
      "type": "text",
      "id": "bulk_heading",
      "label": "Bulk heading",
      "default": "For bulk chews, the page should feel like a stocked routine, not just a bigger bag."
    },
    {
      "type": "textarea",
      "id": "bulk_intro",
      "label": "Bulk intro",
      "default": "Bulk buyers usually know why they are here: their dog already uses chews, they have more than one dog, or they want better value. This page should make quantity, storage, sizing, and safe daily use easy to understand."
    }
  ],
  "presets": [
    {
      "name": "Product category audit"
    }
  ]
}
{% endschema %}
