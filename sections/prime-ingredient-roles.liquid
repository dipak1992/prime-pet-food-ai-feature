{%- comment -%}
  Ingredient Role Infographic Section
  File: sections/prime-ingredient-roles.liquid
  
  Explains the specific role of each of the 4 ingredients in a concise,
  visual format. Explicitly addresses consumer fears about sodium and
  citrus by stating trace amounts and purpose.
  
  Usage: Add to any template JSON as a section.
{%- endcomment -%}

<section class="pir" aria-labelledby="PrimeIngredientRolesTitle">
  <style>
    .pir {
      padding: clamp(48px, 7vw, 80px) 24px;
      background: #fff;
      font-family: var(--font-body-family, -apple-system, sans-serif);
    }

    .pir__inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .pir__header {
      text-align: center;
      margin-bottom: 40px;
    }

    .pir__kicker {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #b45309;
      margin: 0 0 10px;
    }

    .pir__title {
      font-size: clamp(24px, 3.5vw, 36px);
      font-weight: 800;
      color: #1a1a1a;
      margin: 0 0 12px;
      line-height: 1.2;
    }

    .pir__subtitle {
      font-size: 16px;
      color: #6b5c3e;
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .pir__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 32px;
    }

    @media (max-width: 768px) {
      .pir__grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 480px) {
      .pir__grid {
        grid-template-columns: 1fr;
      }
    }

    .pir__card {
      background: #fffaf2;
      border: 1px solid #e5d9c8;
      border-radius: 16px;
      padding: 24px 20px;
      text-align: center;
      position: relative;
    }

    .pir__card-icon {
      font-size: 32px;
      margin-bottom: 12px;
      display: block;
    }

    .pir__card-name {
      font-size: 15px;
      font-weight: 700;
      color: #1a1a1a;
      margin: 0 0 4px;
    }

    .pir__card-amount {
      font-size: 11px;
      font-weight: 600;
      color: #92400e;
      background: #fef3c7;
      padding: 2px 8px;
      border-radius: 100px;
      display: inline-block;
      margin-bottom: 10px;
    }

    .pir__card-role {
      font-size: 13px;
      color: #4a3f2f;
      margin: 0;
      line-height: 1.5;
    }

    .pir__safety-note {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 12px;
      padding: 20px 24px;
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }

    .pir__safety-icon {
      width: 40px;
      height: 40px;
      background: #dcfce7;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }

    .pir__safety-content {
      flex: 1;
    }

    .pir__safety-title {
      font-size: 14px;
      font-weight: 700;
      color: #166534;
      margin: 0 0 6px;
    }

    .pir__safety-text {
      font-size: 13px;
      color: #15803d;
      margin: 0;
      line-height: 1.6;
    }
  </style>

  <div class="pir__inner">

    <div class="pir__header">
      <p class="pir__kicker">{{ section.settings.kicker }}</p>
      <h2 class="pir__title" id="PrimeIngredientRolesTitle">{{ section.settings.heading }}</h2>
      <p class="pir__subtitle">{{ section.settings.subheading }}</p>
    </div>

    <div class="pir__grid">

      <div class="pir__card">
        <span class="pir__card-icon">&#129371;</span>
        <p class="pir__card-name">Yak Milk</p>
        <span class="pir__card-amount">Primary ingredient</span>
        <p class="pir__card-role">The protein-rich base. Yak milk has higher fat and protein than cow milk, creating the dense, long-lasting texture dogs love.</p>
      </div>

      <div class="pir__card">
        <span class="pir__card-icon">&#129371;</span>
        <p class="pir__card-name">Cow Milk</p>
        <span class="pir__card-amount">Secondary base</span>
        <p class="pir__card-role">Blended with yak milk for consistency and structure. Together they form the hard cheese that takes dogs 45&#8211;90 minutes to work through.</p>
      </div>

      <div class="pir__card">
        <span class="pir__card-icon">&#127819;</span>
        <p class="pir__card-name">Lime Juice</p>
        <span class="pir__card-amount">&lt; 1% trace amount</span>
        <p class="pir__card-role">A natural coagulant that hardens the milk into cheese. Used in microscopic amounts — far less than a single lime wedge. Not a flavor ingredient.</p>
      </div>

      <div class="pir__card">
        <span class="pir__card-icon">&#129474;</span>
        <p class="pir__card-name">Salt</p>
        <span class="pir__card-amount">&lt; 1% trace amount</span>
        <p class="pir__card-role">A tiny amount for natural preservation and flavor. Less than 1% of total composition — far below levels that would concern any veterinarian.</p>
      </div>

    </div>

    <div class="pir__safety-note">
      <div class="pir__safety-icon">&#9989;</div>
      <div class="pir__safety-content">
        <p class="pir__safety-title">About the lime juice and salt</p>
        <p class="pir__safety-text">We get asked about these a lot. Both are used in microscopic trace amounts — purely to harden the milk naturally into a dense cheese. The lime juice is not acidic enough to cause any digestive concern, and the salt content is far below what you would find in a single dog treat from any major brand. These are processing agents, not flavor additives.</p>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Prime Ingredient Roles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Full Transparency"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What each ingredient actually does"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Four ingredients. Each one has a specific job. Nothing is there by accident — and nothing is hidden."
    }
  ],
  "presets": [
    {
      "name": "Prime Ingredient Roles"
    }
  ]
}
{% endschema %}
