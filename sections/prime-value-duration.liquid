{% comment %}
  Prime Value Duration Section
  Conversion section centered around the "$0.22/hour" value proposition.
  Self-contained: CSS + JS + Liquid + Schema
{% endcomment %}

{% liquid
  assign eyebrow      = section.settings.eyebrow      | default: "The math is simple"
  assign heading      = section.settings.heading      | default: "Hours of calm. Pennies per hour."
  assign subheading   = section.settings.subheading   | default: "Most dogs chew for 2-4 hours straight. At $0.22/hour, that's less than your morning coffee costs per minute."
  assign price_per_hr = section.settings.price_per_hour | default: "$0.22"
  assign min_dur      = section.settings.min_duration | default: "2"
  assign max_dur      = section.settings.max_duration | default: "4+"
  assign pull_quote   = section.settings.pull_quote   | default: "That's 4 hours of quiet. 4 hours of calm. 4 hours of your dog doing exactly what dogs are meant to do."
  assign cta_text     = section.settings.cta_text     | default: "Get your dog's first Prime chew"
  assign cta_url      = section.settings.cta_url      | default: "/collections/all"
  assign start_price  = section.settings.starting_price | default: "Starting at $14.99"
%}

<section
  class="prime-value prime-section prime-section--dark"
  id="prime-value-{{ section.id }}"
  aria-label="{{ heading }}"
>
  <div class="prime-container">

    {%- comment -%} ── Section Header ── {%- endcomment -%}
    <div class="prime-value__header">
      {% if eyebrow != blank %}
        <span class="prime-value__eyebrow" aria-hidden="true">{{ eyebrow }}</span>
      {% endif %}
      <h2 class="prime-value__heading">{{ heading }}</h2>
      {% if subheading != blank %}
        <p class="prime-value__subheading">{{ subheading }}</p>
      {% endif %}
    </div>

    {%- comment -%} ── Duration Timeline ── {%- endcomment -%}
    <div class="prime-value__timeline" aria-label="Chew duration timeline">
      <p class="prime-value__timeline-label">Average chew duration</p>

      <div class="prime-value__timeline-track" role="presentation">
        <div
          class="prime-value__timeline-fill"
          data-animate-width="85%"
          role="meter"
          aria-valuenow="85"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label="{{ min_dur }}–{{ max_dur }} hours of chewing"
        ></div>
        <div class="prime-value__timeline-glow" aria-hidden="true"></div>
      </div>

      <div class="prime-value__timeline-markers" aria-label="Time markers" role="list">
        <span role="listitem">30min</span>
        <span role="listitem">1hr</span>
        <span role="listitem">2hr</span>
        <span role="listitem">3hr</span>
        <span role="listitem">4hr+</span>
      </div>

      <div class="prime-value__price-display" aria-label="{{ price_per_hr }} per hour">
        <span class="prime-value__price-number" data-count-target="{{ price_per_hr }}">{{ price_per_hr }}</span><span class="prime-value__price-unit">/hr</span>
      </div>
      <p class="prime-value__price-context">of pure chewing entertainment</p>
    </div>

    {%- comment -%} ── Comparison Stats ── {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <div class="prime-value__stats" role="list" aria-label="Value comparison">
        {% for block in section.blocks %}
          {% if block.type == 'stat_comparison' %}
            <div
              class="prime-value__stat-card{% if block.settings.is_prime %} prime-value__stat-card--prime{% endif %}"
              role="listitem"
              {{ block.shopify_attributes }}
              style="--card-index: {{ forloop.index0 }};"
              data-stat-card
            >
              {% if block.settings.is_prime %}
                <div class="prime-value__stat-badge" aria-label="Prime product">Prime Pick</div>
              {% endif %}

              <h3 class="prime-value__stat-name">{{ block.settings.product_name }}</h3>

              <div class="prime-value__stat-metrics">
                <div class="prime-value__stat-metric">
                  <span class="prime-value__stat-value prime-value__stat-value--price">{{ block.settings.price_per_hour }}</span>
                  <span class="prime-value__stat-label">per hour</span>
                </div>
                <div class="prime-value__stat-metric">
                  <span class="prime-value__stat-value">{{ block.settings.duration }}</span>
                  <span class="prime-value__stat-label">chew time</span>
                </div>
                <div class="prime-value__stat-metric">
                  <span class="prime-value__stat-value">{{ block.settings.ingredients }}</span>
                  <span class="prime-value__stat-label">ingredients</span>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {%- comment -%} ── Pull Quote ── {%- endcomment -%}
    {% if pull_quote != blank %}
      <blockquote class="prime-value__quote" data-quote-animate>
        <div class="prime-value__quote-accent" aria-hidden="true"></div>
        <p class="prime-value__quote-text">{{ pull_quote }}</p>
        <cite class="prime-value__quote-cite">— What Prime customers tell us</cite>
      </blockquote>
    {% endif %}

    {%- comment -%} ── Bottom CTA ── {%- endcomment -%}
    <div class="prime-value__cta">
      {% if cta_text != blank %}
        <a
          href="{{ cta_url }}"
          class="prime-btn-primary prime-value__cta-btn"
          aria-label="{{ cta_text }}"
        >
          {{ cta_text }}
        </a>
      {% endif %}
      {% if start_price != blank %}
        <span class="prime-value__price-note">{{ start_price }}</span>
      {% endif %}
    </div>

  </div>
</section>

<style>
  /* ============================================================
     Prime Value Duration Section
     /sections/prime-value-duration.liquid
     All classes prefixed with prime-value- to avoid conflicts
     ============================================================ */

  .prime-value {
    /* Local tokens — fall back to design system custom properties */
    --pv-charcoal:        var(--prime-charcoal,       #1C1917);
    --pv-charcoal-light:  var(--prime-charcoal-light, #2A2724);
    --pv-charcoal-card:   #252220;
    --pv-cream:           var(--prime-cream,          #FAF7F2);
    --pv-white:           var(--prime-white,          #FFFFFF);
    --pv-terracotta:      var(--prime-terracotta,     #C1654A);
    --pv-terracotta-glow: rgba(193, 101, 74, 0.25);
    --pv-sage:            var(--prime-sage,           #7A8B6F);
    --pv-sage-light:      rgba(122, 139, 111, 0.18);
    --pv-gold:            var(--prime-gold,           #C9A84C);
    --pv-text-muted:      rgba(250, 247, 242, 0.55);
    --pv-border:          rgba(250, 247, 242, 0.08);
    --pv-border-prime:    rgba(193, 101, 74, 0.35);
    --pv-radius:          16px;
    --pv-radius-sm:       10px;

    background-color: var(--pv-charcoal);
    padding: 100px 0;
    overflow: hidden;
    position: relative;
  }

  /* Subtle radial gradient backdrop */
  .prime-value::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgba(193, 101, 74, 0.06) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 80% 80%, rgba(122, 139, 111, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  /* ── Container ─────────────────────────────────────────────── */
  .prime-value .prime-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  /* ── Section Header ─────────────────────────────────────────── */
  .prime-value__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 72px;
  }

  .prime-value__eyebrow {
    display: inline-block;
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--pv-terracotta);
    margin-bottom: 20px;
  }

  .prime-value__heading {
    font-family: var(--prime-font-heading, 'Georgia', serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--pv-cream);
    margin: 0 0 20px;
  }

  .prime-value__subheading {
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: clamp(1rem, 2vw, 1.1875rem);
    line-height: 1.65;
    color: var(--pv-text-muted);
    margin: 0;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ── Duration Timeline ──────────────────────────────────────── */
  .prime-value__timeline {
    background: var(--pv-charcoal-light);
    border: 1px solid var(--pv-border);
    border-radius: 24px;
    padding: 48px 56px;
    margin-bottom: 56px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .prime-value__timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--pv-terracotta), transparent);
    opacity: 0.4;
  }

  .prime-value__timeline-label {
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--pv-text-muted);
    margin: 0 0 20px;
  }

  /* Track */
  .prime-value__timeline-track {
    position: relative;
    width: 100%;
    height: 12px;
    background: rgba(250, 247, 242, 0.07);
    border-radius: 6px;
    overflow: visible;
    margin-bottom: 14px;
  }

  /* Animated fill bar */
  .prime-value__timeline-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--pv-sage) 0%, #95A888 60%, var(--pv-terracotta) 100%);
    transition: width 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: width;
  }

  /* Glowing tip on the fill bar */
  .prime-value__timeline-glow {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translate(50%, -50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--pv-terracotta);
    box-shadow: 0 0 16px 4px var(--pv-terracotta-glow);
    opacity: 0;
    transition: opacity 0.4s ease 1.2s;
    pointer-events: none;
  }

  .prime-value__timeline--animated .prime-value__timeline-glow {
    opacity: 1;
  }

  /* Time markers */
  .prime-value__timeline-markers {
    display: flex;
    justify-content: space-between;
    margin-bottom: 40px;
  }

  .prime-value__timeline-markers span {
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--pv-text-muted);
    letter-spacing: 0.04em;
  }

  /* Hero price display */
  .prime-value__price-display {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
    margin-bottom: 10px;
  }

  .prime-value__price-number {
    font-family: var(--prime-font-heading, 'Georgia', serif);
    font-size: clamp(3.5rem, 10vw, 6.5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--pv-terracotta);
    letter-spacing: -0.04em;
    text-shadow: 0 0 60px var(--pv-terracotta-glow);
  }

  .prime-value__price-unit {
    font-family: var(--prime-font-heading, 'Georgia', serif);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 400;
    color: var(--pv-terracotta);
    opacity: 0.75;
    letter-spacing: -0.02em;
  }

  .prime-value__price-context {
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 0.9375rem;
    color: var(--pv-text-muted);
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* ── Comparison Stats Grid ──────────────────────────────────── */
  .prime-value__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 64px;
  }

  /* Stat card base */
  .prime-value__stat-card {
    background: var(--pv-charcoal-card);
    border: 1px solid var(--pv-border);
    border-radius: var(--pv-radius);
    padding: 32px 28px;
    position: relative;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
    will-change: opacity, transform;
  }

  .prime-value__stat-card--visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Prime card highlight */
  .prime-value__stat-card--prime {
    border-color: var(--pv-border-prime);
    background: linear-gradient(145deg, #2A2220 0%, #241E1C 100%);
    box-shadow: 0 0 40px rgba(193, 101, 74, 0.08), inset 0 1px 0 rgba(193, 101, 74, 0.15);
  }

  .prime-value__stat-card--prime:hover {
    border-color: rgba(193, 101, 74, 0.55);
    box-shadow: 0 8px 40px rgba(193, 101, 74, 0.14), inset 0 1px 0 rgba(193, 101, 74, 0.2);
  }

  .prime-value__stat-card:not(.prime-value__stat-card--prime):hover {
    border-color: rgba(250, 247, 242, 0.14);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  /* Prime badge */
  .prime-value__stat-badge {
    display: inline-block;
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pv-terracotta);
    background: rgba(193, 101, 74, 0.12);
    border: 1px solid rgba(193, 101, 74, 0.25);
    border-radius: 50px;
    padding: 4px 10px;
    margin-bottom: 14px;
  }

  /* Stat card name */
  .prime-value__stat-name {
    font-family: var(--prime-font-heading, 'Georgia', serif);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--pv-cream);
    margin: 0 0 24px;
    letter-spacing: -0.01em;
  }

  /* Metrics group */
  .prime-value__stat-metrics {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .prime-value__stat-metric {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--pv-border);
  }

  .prime-value__stat-metric:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .prime-value__stat-value {
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--pv-cream);
    letter-spacing: -0.01em;
  }

  /* Price value gets terracotta on the Prime card */
  .prime-value__stat-card--prime .prime-value__stat-value--price {
    color: var(--pv-terracotta);
    font-size: 1.125rem;
  }

  .prime-value__stat-label {
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--pv-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: right;
  }

  /* ── Pull Quote ─────────────────────────────────────────────── */
  .prime-value__quote {
    position: relative;
    max-width: 820px;
    margin: 0 auto 72px;
    padding: 0 0 0 36px;
    opacity: 0;
    transform: scale(0.97) translateY(16px);
    transition:
      opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: opacity, transform;
  }

  .prime-value__quote--visible {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* Gold accent line */
  .prime-value__quote-accent {
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 3px;
    background: linear-gradient(180deg, var(--pv-gold) 0%, rgba(201, 168, 76, 0.3) 100%);
    border-radius: 2px;
  }

  .prime-value__quote-text {
    font-family: var(--prime-font-heading, 'Georgia', serif);
    font-size: clamp(1.25rem, 3vw, 1.875rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    color: var(--pv-cream);
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .prime-value__quote-cite {
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 0.875rem;
    font-style: normal;
    font-weight: 500;
    color: var(--pv-text-muted);
    letter-spacing: 0.04em;
  }

  /* ── CTA ────────────────────────────────────────────────────── */
  .prime-value__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .prime-value__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 48px;
    background: var(--pv-terracotta);
    color: var(--pv-white);
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    letter-spacing: 0.01em;
    transition:
      background 0.25s ease,
      transform 0.2s ease,
      box-shadow 0.25s ease;
    box-shadow: 0 4px 24px rgba(193, 101, 74, 0.35);
  }

  .prime-value__cta-btn:hover {
    background: #B05A40;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(193, 101, 74, 0.45);
  }

  .prime-value__cta-btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 12px rgba(193, 101, 74, 0.3);
  }

  .prime-value__price-note {
    font-family: var(--prime-font-body, system-ui, sans-serif);
    font-size: 0.9375rem;
    color: var(--pv-text-muted);
    letter-spacing: 0.02em;
  }

  /* ── Tablet ─────────────────────────────────────────────────── */
  @media (max-width: 1024px) and (min-width: 769px) {
    .prime-value {
      padding: 80px 0;
    }

    .prime-value__timeline {
      padding: 40px 40px;
    }

    .prime-value__stats {
      gap: 16px;
    }

    .prime-value__stat-card {
      padding: 28px 22px;
    }
  }

  /* ── Mobile ─────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .prime-value {
      padding: 64px 0;
    }

    .prime-value__header {
      margin-bottom: 48px;
    }

    .prime-value__timeline {
      padding: 32px 24px;
      border-radius: 18px;
      margin-bottom: 40px;
    }

    .prime-value__timeline-track {
      height: 10px;
    }

    .prime-value__timeline-markers span {
      font-size: 0.6875rem;
    }

    /* Stats: single column on mobile */
    .prime-value__stats {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-bottom: 48px;
    }

    .prime-value__stat-card {
      padding: 24px 20px;
    }

    .prime-value__stat-metrics {
      gap: 12px;
    }

    .prime-value__quote {
      padding-left: 24px;
      margin-bottom: 48px;
    }

    .prime-value__cta-btn {
      width: 100%;
      padding: 17px 32px;
      font-size: 1rem;
    }
  }

  /* ── Reduced Motion ─────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .prime-value__timeline-fill {
      transition: none;
    }

    .prime-value__timeline-glow {
      transition: none;
    }

    .prime-value__stat-card {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .prime-value__quote {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .prime-value__cta-btn:hover {
      transform: none;
    }
  }
</style>

<script>
  (function () {
    'use strict';

    var sectionEl = document.getElementById('prime-value-{{ section.id }}');
    if (!sectionEl) return;

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── Helpers ─────────────────────────────────────────────── */

    function onceVisible(el, callback, options) {
      if (!el) return;
      if (prefersReducedMotion) {
        callback(el);
        return;
      }
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            callback(entry.target);
            observer.unobserve(entry.target);
          }
        });
      }, options || { rootMargin: '0px 0px -80px 0px', threshold: 0.15 });
      observer.observe(el);
    }

    /* ── 1. Duration bar fill animation ─────────────────────── */
    var timelineEl = sectionEl.querySelector('.prime-value__timeline');
    var fillEl     = sectionEl.querySelector('.prime-value__timeline-fill');
    var glowEl     = sectionEl.querySelector('.prime-value__timeline-glow');

    if (fillEl) {
      var targetWidth = fillEl.getAttribute('data-animate-width') || '85%';

      if (prefersReducedMotion) {
        fillEl.style.width = targetWidth;
        if (glowEl) glowEl.style.opacity = '1';
        if (timelineEl) timelineEl.classList.add('prime-value__timeline--animated');
      } else {
        onceVisible(timelineEl || fillEl, function () {
          // Small delay so the user sees the bar start from 0
          setTimeout(function () {
            fillEl.style.width = targetWidth;
            if (timelineEl) timelineEl.classList.add('prime-value__timeline--animated');
          }, 200);
        }, { rootMargin: '0px 0px -60px 0px', threshold: 0.2 });
      }
    }

    /* ── 2. Stat cards staggered entrance ───────────────────── */
    var statCards = sectionEl.querySelectorAll('[data-stat-card]');

    if (statCards.length > 0) {
      if (prefersReducedMotion) {
        statCards.forEach(function (card) {
          card.classList.add('prime-value__stat-card--visible');
        });
      } else {
        var cardObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var card  = entry.target;
              var index = parseInt(card.style.getPropertyValue('--card-index'), 10) || 0;
              setTimeout(function () {
                card.classList.add('prime-value__stat-card--visible');
              }, index * 130);
              cardObserver.unobserve(card);
            }
          });
        }, { rootMargin: '0px 0px -60px 0px', threshold: 0.12 });

        statCards.forEach(function (card) {
          cardObserver.observe(card);
        });
      }
    }

    /* ── 3. Pull quote fade + scale ─────────────────────────── */
    var quoteEl = sectionEl.querySelector('[data-quote-animate]');

    if (quoteEl) {
      if (prefersReducedMotion) {
        quoteEl.classList.add('prime-value__quote--visible');
      } else {
        onceVisible(quoteEl, function (el) {
          setTimeout(function () {
            el.classList.add('prime-value__quote--visible');
          }, 100);
        }, { rootMargin: '0px 0px -80px 0px', threshold: 0.2 });
      }
    }

  })();
</script>

