{% comment %}
  Prime Header Section
  Premium, minimal, modern luxury DTC header
  Self-contained: CSS + JS + Liquid + Schema
{% endcomment %}

<style>
  /* ===== Prime Header Styles ===== */
  .prime-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: 80px;
    transition: background-color 0.3s ease, box-shadow 0.3s ease, height 0.3s ease, transform 0.3s ease;
    background-color: transparent;
  }

  .prime-header--scrolled {
    background-color: var(--prime-white, #FFFDF9);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
    height: 60px;
  }

  .prime-header--hidden {
    transform: translateY(-100%);
  }

  .prime-header--visible {
    transform: translateY(0);
  }

  .prime-header--opaque {
    background-color: var(--prime-white, #FFFDF9);
  }

  .prime-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }

  /* Logo */
  .prime-header__logo {
    font-family: var(--prime-font-heading, 'Georgia', serif);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: var(--prime-tracking-wider, 0.12em);
    color: var(--prime-charcoal, #2C2C2C);
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .prime-header__logo img {
    height: 36px;
    width: auto;
    display: block;
  }

  .prime-header--scrolled .prime-header__logo img {
    height: 30px;
  }

  /* Desktop Navigation */
  .prime-header__nav {
    display: flex;
    align-items: center;
    gap: 36px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .prime-header__nav-link {
    font-family: var(--prime-font-body, 'Inter', sans-serif);
    font-size: var(--prime-font-small, 0.8125rem);
    font-weight: 500;
    letter-spacing: var(--prime-tracking-wide, 0.08em);
    text-transform: uppercase;
    color: var(--prime-charcoal, #2C2C2C);
    text-decoration: none;
    position: relative;
    padding: 4px 0;
    transition: color 0.2s ease;
  }

  .prime-header__nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    right: 50%;
    height: 1.5px;
    background-color: var(--prime-charcoal, #2C2C2C);
    transition: left 0.3s ease, right 0.3s ease;
  }

  .prime-header__nav-link:hover::after,
  .prime-header__nav-link:focus::after {
    left: 0;
    right: 0;
  }

  .prime-header__nav-link--highlight {
    color: var(--prime-terracotta, #C75B3F);
  }

  .prime-header__nav-link--highlight::after {
    background-color: var(--prime-terracotta, #C75B3F);
  }

  /* Actions (Search + Cart) */
  .prime-header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }

  .prime-header__search-btn,
  .prime-header__cart {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--prime-charcoal, #2C2C2C);
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
  }

  .prime-header__search-btn:hover,
  .prime-header__cart:hover {
    color: var(--prime-terracotta, #C75B3F);
  }

  .prime-header__search-btn svg,
  .prime-header__cart svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
  }

  .prime-header__cart-count {
    position: absolute;
    top: 2px;
    right: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--prime-terracotta, #C75B3F);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .prime-header__cart-count:empty,
  .prime-header__cart-count--hidden {
    display: none;
  }

  /* Mobile hamburger */
  .prime-header__hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--prime-charcoal, #2C2C2C);
    flex-shrink: 0;
  }

  .prime-header__hamburger svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
  }

  /* ===== Mobile Drawer ===== */
  .prime-header__drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 1100;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .prime-header__drawer-overlay--active {
    opacity: 1;
    visibility: visible;
  }

  .prime-header__drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background-color: var(--prime-white, #FFFDF9);
    z-index: 1200;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prime-header__drawer--open {
    transform: translateX(0);
  }

  .prime-header__drawer-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 20px 24px;
    flex-shrink: 0;
  }

  .prime-header__drawer-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--prime-charcoal, #2C2C2C);
    transition: color 0.2s ease;
  }

  .prime-header__drawer-close:hover {
    color: var(--prime-terracotta, #C75B3F);
  }

  .prime-header__drawer-close svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
  }

  .prime-header__drawer-nav {
    display: flex;
    flex-direction: column;
    padding: 20px 24px;
    flex: 1;
  }

  .prime-header__drawer-link {
    font-family: var(--prime-font-body, 'Inter', sans-serif);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: var(--prime-tracking-wide, 0.08em);
    text-transform: uppercase;
    color: var(--prime-charcoal, #2C2C2C);
    text-decoration: none;
    padding: 14px 0;
    min-height: 48px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    transition: color 0.2s ease;
  }

  .prime-header__drawer-link:last-child {
    border-bottom: none;
  }

  .prime-header__drawer-link:hover,
  .prime-header__drawer-link:focus {
    color: var(--prime-terracotta, #C75B3F);
  }

  .prime-header__drawer-link--highlight {
    color: var(--prime-terracotta, #C75B3F);
  }

  .prime-header__drawer-footer {
    padding: 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    flex-shrink: 0;
  }

  .prime-header__drawer-secondary {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prime-header__drawer-secondary a {
    font-family: var(--prime-font-body, 'Inter', sans-serif);
    font-size: 0.8125rem;
    color: var(--prime-charcoal-light, #6B6B6B);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  .prime-header__drawer-secondary a:hover {
    color: var(--prime-charcoal, #2C2C2C);
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .prime-header {
      height: 60px;
    }

    .prime-header--scrolled {
      height: 56px;
    }

    .prime-header__nav {
      display: none;
    }

    .prime-header__search-btn {
      display: none;
    }

    .prime-header__hamburger {
      display: flex;
    }

    .prime-header__logo {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .prime-header__inner {
      padding: 0 16px;
    }
  }

  @media (min-width: 769px) {
    .prime-header__drawer-overlay,
    .prime-header__drawer {
      display: none !important;
    }
  }

  /* Focus styles for accessibility */
  .prime-header__nav-link:focus-visible,
  .prime-header__search-btn:focus-visible,
  .prime-header__cart:focus-visible,
  .prime-header__hamburger:focus-visible,
  .prime-header__drawer-close:focus-visible,
  .prime-header__drawer-link:focus-visible {
    outline: 2px solid var(--prime-terracotta, #C75B3F);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Spacer to prevent content from going under fixed header */
  .prime-header__spacer {
    height: 80px;
  }

  @media (max-width: 768px) {
    .prime-header__spacer {
      height: 60px;
    }
  }

  /* Body scroll lock when drawer is open */
  body.prime-header__no-scroll {
    overflow: hidden;
  }
</style>

<header class="prime-header{% if section.settings.transparent_on_hero %} prime-header--transparent{% endif %}" data-prime-header data-sticky="{{ section.settings.sticky_enabled }}" role="banner">
  <div class="prime-header__inner">
    {%- comment -%} Mobile hamburger {%- endcomment -%}
    <button class="prime-header__hamburger" aria-label="Open menu" aria-expanded="false" data-drawer-toggle>
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" stroke-linecap="round"/>
        <line x1="3" y1="12" x2="21" y2="12" stroke-linecap="round"/>
        <line x1="3" y1="18" x2="21" y2="18" stroke-linecap="round"/>
      </svg>
    </button>

    {%- comment -%} Logo {%- endcomment -%}
    <a class="prime-header__logo" href="/" aria-label="{{ section.settings.logo_text | default: 'PRIME' }} - Home">
      {%- if section.settings.logo_image != blank -%}
        <img
          src="{{ section.settings.logo_image | image_url: width: 200 }}"
          alt="{{ section.settings.logo_text | default: shop.name }}"
          width="200"
          height="auto"
          loading="eager"
        >
      {%- else -%}
        {{ section.settings.logo_text | default: 'PRIME' }}
      {%- endif -%}
    </a>

    {%- comment -%} Desktop Navigation {%- endcomment -%}
    <nav class="prime-header__nav" role="navigation" aria-label="Main navigation">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_link' -%}
          <a
            class="prime-header__nav-link{% if block.settings.highlight %} prime-header__nav-link--highlight{% endif %}"
            href="{{ block.settings.url }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} Actions: Search + Cart {%- endcomment -%}
    <div class="prime-header__actions">
      <button class="prime-header__search-btn" aria-label="Search" data-search-toggle>
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round"/>
        </svg>
      </button>

      <a class="prime-header__cart" href="/cart" aria-label="Cart ({{ cart.item_count }} items)">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="3" y1="6" x2="21" y2="6" stroke-linecap="round"/>
          <path d="M16 10a4 4 0 01-8 0" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="prime-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
        {%- else -%}
          <span class="prime-header__cart-count prime-header__cart-count--hidden" data-cart-count></span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{%- comment -%} Mobile Drawer {%- endcomment -%}
<div class="prime-header__drawer-overlay" data-drawer-overlay aria-hidden="true"></div>
<aside class="prime-header__drawer" data-drawer aria-label="Mobile navigation" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="prime-header__drawer-header">
    <button class="prime-header__drawer-close" aria-label="Close menu" data-drawer-close>
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" stroke-linecap="round"/>
        <line x1="6" y1="6" x2="18" y2="18" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav class="prime-header__drawer-nav" aria-label="Mobile navigation">
    {%- for block in section.blocks -%}
      {%- if block.type == 'nav_link' -%}
        <a
          class="prime-header__drawer-link{% if block.settings.highlight %} prime-header__drawer-link--highlight{% endif %}"
          href="{{ block.settings.url }}"
        >
          {{ block.settings.label }}
        </a>
      {%- endif -%}
    {%- endfor -%}
    <a class="prime-header__drawer-link" href="/pages/contact">Contact</a>
    <a class="prime-header__drawer-link" href="/account">Account</a>
  </nav>

  <div class="prime-header__drawer-footer">
    <div class="prime-header__drawer-secondary">
      <a href="/policies/shipping-policy">Shipping & Returns</a>
      <a href="/pages/faq">FAQ</a>
      <a href="mailto:hello@primepetfood.com">hello@primepetfood.com</a>
    </div>
  </div>
</aside>

{%- comment -%} Spacer to offset fixed header {%- endcomment -%}
{%- unless section.settings.transparent_on_hero -%}
  <div class="prime-header__spacer"></div>
{%- endunless -%}

<script>
  (function() {
    'use strict';

    const header = document.querySelector('[data-prime-header]');
    if (!header) return;

    const stickyEnabled = header.dataset.sticky === 'true';
    const isTransparent = header.classList.contains('prime-header--transparent');
    const hamburger = document.querySelector('[data-drawer-toggle]');
    const drawer = document.querySelector('[data-drawer]');
    const drawerOverlay = document.querySelector('[data-drawer-overlay]');
    const drawerClose = document.querySelector('[data-drawer-close]');
    const searchBtn = document.querySelector('[data-search-toggle]');

    let lastScrollY = 0;
    let ticking = false;
    const SCROLL_THRESHOLD = 100;
    const HIDE_THRESHOLD = 5;

    /* --- Sticky / Smart Hide Logic --- */
    function handleScroll() {
      const currentScrollY = window.scrollY;

      // Background change on scroll
      if (currentScrollY > SCROLL_THRESHOLD) {
        header.classList.add('prime-header--scrolled');
        if (isTransparent) {
          header.classList.remove('prime-header--transparent');
        }
      } else {
        header.classList.remove('prime-header--scrolled');
        if (isTransparent) {
          header.classList.add('prime-header--transparent');
        }
      }

      // Smart hide/show on scroll direction
      if (stickyEnabled && currentScrollY > SCROLL_THRESHOLD) {
        const scrollDelta = currentScrollY - lastScrollY;

        if (scrollDelta > HIDE_THRESHOLD) {
          // Scrolling down — hide
          header.classList.add('prime-header--hidden');
          header.classList.remove('prime-header--visible');
        } else if (scrollDelta < -HIDE_THRESHOLD) {
          // Scrolling up — show
          header.classList.remove('prime-header--hidden');
          header.classList.add('prime-header--visible');
        }
      } else {
        header.classList.remove('prime-header--hidden');
        header.classList.remove('prime-header--visible');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(handleScroll);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    /* --- Mobile Drawer Logic --- */
    function openDrawer() {
      drawer.classList.add('prime-header__drawer--open');
      drawerOverlay.classList.add('prime-header__drawer-overlay--active');
      drawer.setAttribute('aria-hidden', 'false');
      drawerOverlay.setAttribute('aria-hidden', 'false');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.classList.add('prime-header__no-scroll');

      // Focus the close button
      setTimeout(function() {
        drawerClose.focus();
      }, 100);

      // Trap focus inside drawer
      drawer.addEventListener('keydown', trapFocus);
    }

    function closeDrawer() {
      drawer.classList.remove('prime-header__drawer--open');
      drawerOverlay.classList.remove('prime-header__drawer-overlay--active');
      drawer.setAttribute('aria-hidden', 'true');
      drawerOverlay.setAttribute('aria-hidden', 'true');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('prime-header__no-scroll');

      // Return focus to hamburger
      hamburger.focus();

      drawer.removeEventListener('keydown', trapFocus);
    }

    function trapFocus(e) {
      if (e.key !== 'Tab') return;

      const focusableEls = drawer.querySelectorAll(
        'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'
      );
      const firstEl = focusableEls[0];
      const lastEl = focusableEls[focusableEls.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === firstEl) {
          e.preventDefault();
          lastEl.focus();
        }
      } else {
        if (document.activeElement === lastEl) {
          e.preventDefault();
          firstEl.focus();
        }
      }
    }

    if (hamburger) {
      hamburger.addEventListener('click', function() {
        const isOpen = drawer.classList.contains('prime-header__drawer--open');
        if (isOpen) {
          closeDrawer();
        } else {
          openDrawer();
        }
      });
    }

    if (drawerClose) {
      drawerClose.addEventListener('click', closeDrawer);
    }

    if (drawerOverlay) {
      drawerOverlay.addEventListener('click', closeDrawer);
    }

    // Close drawer on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.classList.contains('prime-header__drawer--open')) {
        closeDrawer();
      }
    });

    /* --- Search Button --- */
    if (searchBtn) {
      searchBtn.addEventListener('click', function() {
        window.location.href = '/search';
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Prime Header",
  "tag": "section",
  "class": "prime-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Recommended height: 72px. Leave blank to use text logo."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "PRIME",
      "info": "Displayed when no logo image is set."
    },
    {
      "type": "checkbox",
      "id": "sticky_enabled",
      "label": "Enable smart sticky header",
      "default": true,
      "info": "Header hides on scroll down and reappears on scroll up."
    },
    {
      "type": "checkbox",
      "id": "transparent_on_hero",
      "label": "Transparent over hero section",
      "default": true,
      "info": "Header starts transparent and gains background on scroll."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL",
          "default": "/"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this link",
          "default": false,
          "info": "Applies accent color to this link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prime Header",
      "blocks": [
        {
          "type": "nav_link",
          "settings": {
            "label": "Shop",
            "url": "/collections/all",
            "highlight": false
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "label": "Our Story",
            "url": "/pages/about-us",
            "highlight": false
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "label": "Blog",
            "url": "/blogs/news",
            "highlight": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
