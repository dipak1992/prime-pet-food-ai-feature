{% comment %}
  Prime Subscribe & Save Section
  File: sections/prime-subscribe-save.liquid
  
  Premium subscription section focused on recurring delivery, convenience,
  savings, and never running out. Tone: calm, reassuring, thoughtful dog parenting.
  
  Reference brands: Ritual vitamins, Seed probiotics, Dollar Shave Club premium tier
{% endcomment %}

<style>
  /* ============================================================
     PRIME SUBSCRIBE & SAVE — Section Styles
     All classes prefixed with prime-subscribe- to avoid conflicts
     ============================================================ */

  /* Section wrapper */
  .prime-subscribe {
    position: relative;
    overflow: hidden;
  }

  /* ── Header ─────────────────────────────────────────────── */

  .prime-subscribe__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--prime-space-2xl);
  }

  .prime-subscribe__eyebrow {
    display: inline-block;
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-small);
    font-weight: 600;
    letter-spacing: var(--prime-tracking-wider);
    text-transform: uppercase;
    color: var(--prime-sage);
    margin-bottom: var(--prime-space-sm);
  }

  .prime-subscribe__heading {
    font-family: var(--prime-font-heading);
    font-size: var(--prime-font-h2);
    line-height: var(--prime-leading-snug);
    letter-spacing: var(--prime-tracking-tight);
    color: var(--prime-charcoal);
    font-weight: 400;
    margin: 0 0 var(--prime-space-md);
  }

  .prime-subscribe__subheading {
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-body-lg);
    line-height: var(--prime-leading-relaxed);
    color: var(--prime-charcoal-light);
    margin: 0;
  }

  /* ── Two-Column Layout ───────────────────────────────────── */

  .prime-subscribe__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--prime-space-xl);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .prime-subscribe__layout {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 5vw, 5rem);
      align-items: center;
    }
  }

  /* ── Visual Column (Left) ────────────────────────────────── */

  .prime-subscribe__visual {
    position: relative;
  }

  .prime-subscribe__image-wrap {
    position: relative;
    border-radius: 12px;
    overflow: visible;
  }

  .prime-subscribe__image-wrap img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
    box-shadow: 0 8px 40px rgba(44, 44, 44, 0.12);
    transition: transform var(--prime-duration-slow) var(--prime-ease-out);
  }

  .prime-subscribe__visual.prime-reveal--visible .prime-subscribe__image-wrap img {
    transform: scale(1);
  }

  .prime-subscribe__visual .prime-subscribe__image-wrap img {
    transform: scale(0.98);
  }

  /* Save badge */
  .prime-subscribe__save-badge {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 80px;
    height: 80px;
    background-color: var(--prime-terracotta);
    color: var(--prime-white);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--prime-font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.2;
    box-shadow: 0 4px 16px rgba(196, 114, 79, 0.4);
    animation: prime-subscribe-badge-pulse 3s ease-in-out infinite;
    z-index: 2;
  }

  .prime-subscribe__save-badge-amount {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  @keyframes prime-subscribe-badge-pulse {
    0%, 100% {
      box-shadow: 0 4px 16px rgba(196, 114, 79, 0.4);
      transform: scale(1);
    }
    50% {
      box-shadow: 0 6px 24px rgba(196, 114, 79, 0.6);
      transform: scale(1.04);
    }
  }

  /* Social proof strip under image */
  .prime-subscribe__social-proof {
    display: flex;
    align-items: center;
    gap: var(--prime-space-sm);
    margin-top: var(--prime-space-md);
    padding: var(--prime-space-sm) var(--prime-space-md);
    background-color: var(--prime-white);
    border-radius: 50px;
    box-shadow: 0 2px 12px rgba(44, 44, 44, 0.08);
    width: fit-content;
  }

  .prime-subscribe__avatars {
    display: flex;
    align-items: center;
  }

  .prime-subscribe__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--prime-white);
    background-color: var(--prime-sage-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--prime-sage);
    margin-left: -8px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .prime-subscribe__avatar:first-child {
    margin-left: 0;
  }

  .prime-subscribe__social-text {
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-small);
    color: var(--prime-charcoal);
    font-weight: 500;
  }

  .prime-subscribe__stars {
    display: flex;
    align-items: center;
    gap: 2px;
    color: var(--prime-gold);
    font-size: 0.75rem;
  }

  /* ── Content Column (Right) ──────────────────────────────── */

  .prime-subscribe__content {
    display: flex;
    flex-direction: column;
    gap: var(--prime-space-lg);
  }

  /* ── Benefits List ───────────────────────────────────────── */

  .prime-subscribe__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--prime-space-md);
  }

  @media (max-width: 767px) {
    .prime-subscribe__benefits {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--prime-space-sm);
    }
  }

  @media (max-width: 480px) {
    .prime-subscribe__benefits {
      grid-template-columns: 1fr;
    }
  }

  .prime-subscribe__benefit {
    display: flex;
    align-items: flex-start;
    gap: var(--prime-space-sm);
  }

  .prime-subscribe__benefit-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background-color: var(--prime-sage-light);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--prime-sage);
  }

  .prime-subscribe__benefit-icon svg {
    width: 20px;
    height: 20px;
    stroke: var(--prime-sage);
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .prime-subscribe__benefit-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 2px;
  }

  .prime-subscribe__benefit-text strong {
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-small);
    font-weight: 600;
    color: var(--prime-charcoal);
    line-height: 1.3;
  }

  .prime-subscribe__benefit-text span {
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-caption);
    color: var(--prime-charcoal-light);
    line-height: var(--prime-leading-normal);
  }

  /* ── Frequency Selector ──────────────────────────────────── */

  .prime-subscribe__frequency-label {
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-caption);
    font-weight: 600;
    letter-spacing: var(--prime-tracking-wider);
    text-transform: uppercase;
    color: var(--prime-charcoal-light);
    margin-bottom: var(--prime-space-xs);
    display: block;
  }

  .prime-subscribe__frequency {
    display: flex;
    gap: var(--prime-space-xs);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  .prime-subscribe__frequency::-webkit-scrollbar {
    display: none;
  }

  .prime-subscribe__freq-option {
    flex-shrink: 0;
    padding: 0.5rem 1.125rem;
    border: 1.5px solid var(--prime-charcoal-light);
    border-radius: 50px;
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-small);
    font-weight: 500;
    color: var(--prime-charcoal-light);
    cursor: pointer;
    transition: all var(--prime-duration-fast) var(--prime-ease-out);
    user-select: none;
    white-space: nowrap;
  }

  .prime-subscribe__freq-option:hover {
    border-color: var(--prime-charcoal);
    color: var(--prime-charcoal);
  }

  .prime-subscribe__freq-option--active {
    background-color: var(--prime-charcoal);
    border-color: var(--prime-charcoal);
    color: var(--prime-white);
  }

  .prime-subscribe__freq-option--active:hover {
    background-color: var(--prime-charcoal);
    color: var(--prime-white);
  }

  /* ── Pricing ─────────────────────────────────────────────── */

  .prime-subscribe__pricing {
    display: flex;
    align-items: center;
    gap: var(--prime-space-sm);
    flex-wrap: wrap;
    padding: var(--prime-space-md) var(--prime-space-md);
    background-color: var(--prime-white);
    border-radius: 12px;
    border: 1.5px solid var(--prime-cream-dark);
  }

  .prime-subscribe__price-original {
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-body-lg);
    color: var(--prime-charcoal-light);
    text-decoration: line-through;
    text-decoration-color: var(--prime-charcoal-light);
    font-weight: 400;
  }

  .prime-subscribe__price-subscribe {
    font-family: var(--prime-font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--prime-terracotta);
    font-weight: 400;
    line-height: 1;
  }

  .prime-subscribe__price-save {
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-caption);
    font-weight: 600;
    letter-spacing: var(--prime-tracking-wide);
    text-transform: uppercase;
    color: var(--prime-sage);
    background-color: var(--prime-sage-light);
    padding: 0.25rem 0.625rem;
    border-radius: 50px;
  }

  .prime-subscribe__price-label {
    width: 100%;
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-caption);
    color: var(--prime-charcoal-light);
    margin-top: -4px;
  }

  /* ── CTA ─────────────────────────────────────────────────── */

  .prime-subscribe__cta {
    display: flex;
    flex-direction: column;
    gap: var(--prime-space-sm);
    align-items: flex-start;
  }

  .prime-subscribe__cta .prime-btn-primary {
    width: 100%;
    justify-content: center;
    padding: 1.125rem 2rem;
    font-size: 0.9375rem;
    letter-spacing: var(--prime-tracking-wide);
  }

  .prime-subscribe__secondary-link {
    font-family: var(--prime-font-body);
    font-size: var(--prime-font-small);
    color: var(--prime-charcoal-light);
    text-decoration: none;
    text-align: center;
    width: 100%;
    padding: 0.25rem 0;
    transition: color var(--prime-duration-fast) var(--prime-ease-out);
  }

  .prime-subscribe__secondary-link:hover {
    color: var(--prime-charcoal);
    text-decoration: underline;
  }

  /* ── Footer Statement ────────────────────────────────────── */

  .prime-subscribe__footer {
    text-align: center;
    margin-top: var(--prime-space-2xl);
    padding-top: var(--prime-space-xl);
    border-top: 1px solid var(--prime-cream-dark);
  }

  .prime-subscribe__statement {
    font-family: var(--prime-font-heading);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: var(--prime-leading-snug);
    color: var(--prime-charcoal);
    font-weight: 400;
    font-style: italic;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── Stagger delays for benefit items ───────────────────── */

  .prime-subscribe__benefit:nth-child(1) { transition-delay: 0ms; }
  .prime-subscribe__benefit:nth-child(2) { transition-delay: 100ms; }
  .prime-subscribe__benefit:nth-child(3) { transition-delay: 200ms; }
  .prime-subscribe__benefit:nth-child(4) { transition-delay: 300ms; }

  /* ── Reduced motion ──────────────────────────────────────── */

  @media (prefers-reduced-motion: reduce) {
    .prime-subscribe__save-badge {
      animation: none;
    }
    .prime-subscribe__visual .prime-subscribe__image-wrap img,
    .prime-subscribe__visual.prime-reveal--visible .prime-subscribe__image-wrap img {
      transform: none;
    }
    .prime-subscribe__benefit {
      transition-delay: 0ms !important;
    }
  }
</style>

{%- liquid
  assign eyebrow         = section.settings.eyebrow | default: 'Never run out'
  assign heading         = section.settings.heading | default: "Your dog's routine. Delivered."
  assign subheading      = section.settings.subheading | default: "Set up a recurring delivery and save 15%. Your dog gets their chew. You get one less thing to think about."
  assign save_pct        = section.settings.save_percentage | default: '15%'
  assign one_time_price  = section.settings.one_time_price | default: '$24.99'
  assign subscribe_price = section.settings.subscribe_price | default: '$21.24'
  assign sub_count       = section.settings.subscriber_count | default: '12,000+'
  assign bottom_stmt     = section.settings.bottom_statement | default: 'Most subscribers have been with us for over a year. Not a coincidence.'
  assign cta_text        = section.settings.cta_text | default: 'Subscribe & Save 15%'
  assign cta_url         = section.settings.cta_url | default: '#'
  assign secondary_text  = section.settings.secondary_text | default: 'Or buy once, no commitment'
  assign secondary_url   = section.settings.secondary_url | default: '#'
-%}

<section
  class="prime-subscribe prime-section prime-section--cream"
  id="prime-subscribe-save"
  aria-label="Subscribe and Save"
>
  <div class="prime-container">

    {%- comment %} ── Section Header ── {%- endcomment %}
    <div class="prime-subscribe__header prime-reveal">
      <span class="prime-subscribe__eyebrow">{{ eyebrow }}</span>
      <h2 class="prime-subscribe__heading">{{ heading }}</h2>
      <p class="prime-subscribe__subheading">{{ subheading }}</p>
    </div>

    {%- comment %} ── Two-Column Layout ── {%- endcomment %}
    <div class="prime-subscribe__layout">

      {%- comment %} Left: Visual Column {%- endcomment %}
      <div class="prime-subscribe__visual prime-reveal" data-delay="100">
        <div class="prime-subscribe__image-wrap">

          {%- if section.settings.hero_image != blank -%}
            {{
              section.settings.hero_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                alt: 'Prime Pet Food subscription box — never run out of your dog\'s favorite chew',
                widths: '400, 600, 800, 900',
                sizes: '(min-width: 1024px) 50vw, 100vw'
            }}
          {%- else -%}
            <img
              src="{{ 'prime-subscribe-save-hero.jpg' | asset_url }}"
              alt="Prime Pet Food subscription box — never run out of your dog's favorite chew"
              loading="lazy"
              width="900"
              height="700"
            >
          {%- endif -%}

          <div
            class="prime-subscribe__save-badge"
            aria-label="Save {{ save_pct }} with subscription"
          >
            <span class="prime-subscribe__save-badge-amount">{{ save_pct }}</span>
            <span>off</span>
          </div>
        </div>

        {%- comment %} Social proof strip {%- endcomment %}
        <div class="prime-subscribe__social-proof" aria-label="Social proof">
          <div class="prime-subscribe__avatars" aria-hidden="true">
            {%- comment %} Placeholder avatar initials {%- endcomment %}
            <div class="prime-subscribe__avatar">S</div>
            <div class="prime-subscribe__avatar">M</div>
            <div class="prime-subscribe__avatar">J</div>
            <div class="prime-subscribe__avatar">A</div>
          </div>
          <div>
            <div class="prime-subscribe__stars" aria-label="5 star rating" role="img">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.39 2.82L10.5 4.27l-2.25 2.19.53 3.1L6 8.02 3.22 9.56l.53-3.1L1.5 4.27l3.11-.45L6 1z"/></svg>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.39 2.82L10.5 4.27l-2.25 2.19.53 3.1L6 8.02 3.22 9.56l.53-3.1L1.5 4.27l3.11-.45L6 1z"/></svg>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.39 2.82L10.5 4.27l-2.25 2.19.53 3.1L6 8.02 3.22 9.56l.53-3.1L1.5 4.27l3.11-.45L6 1z"/></svg>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.39 2.82L10.5 4.27l-2.25 2.19.53 3.1L6 8.02 3.22 9.56l.53-3.1L1.5 4.27l3.11-.45L6 1z"/></svg>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.39 2.82L10.5 4.27l-2.25 2.19.53 3.1L6 8.02 3.22 9.56l.53-3.1L1.5 4.27l3.11-.45L6 1z"/></svg>
            </div>
            <p class="prime-subscribe__social-text">Join {{ sub_count }} subscribers</p>
          </div>
        </div>
      </div>

      {%- comment %} Right: Content Column {%- endcomment %}
      <div class="prime-subscribe__content prime-reveal" data-delay="200">

        {%- comment %} Benefits list {%- endcomment %}
        {%- if section.blocks.size > 0 -%}
          <ul class="prime-subscribe__benefits" aria-label="Subscription benefits">
            {%- for block in section.blocks -%}
              {%- if block.type == 'benefit' -%}
                <li
                  class="prime-subscribe__benefit prime-reveal"
                  data-delay="{{ forloop.index0 | times: 100 }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="prime-subscribe__benefit-icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'truck' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <rect x="1" y="3" width="15" height="13" rx="1"/>
                          <path d="M16 8h4l3 5v4h-7V8z"/>
                          <circle cx="5.5" cy="18.5" r="2.5"/>
                          <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                      {%- when 'discount' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                          <path d="M2 17l10 5 10-5"/>
                          <path d="M2 12l10 5 10-5"/>
                        </svg>
                      {%- when 'pause' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <circle cx="12" cy="12" r="10"/>
                          <line x1="10" y1="15" x2="10" y2="9"/>
                          <line x1="14" y1="15" x2="14" y2="9"/>
                        </svg>
                      {%- when 'bell' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                      {%- when 'heart' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                      {%- when 'check' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    {%- endcase -%}
                  </div>
                  <div class="prime-subscribe__benefit-text">
                    <strong>{{ block.settings.title }}</strong>
                    <span>{{ block.settings.description }}</span>
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment %} Frequency selector {%- endcomment %}
        <div>
          <span class="prime-subscribe__frequency-label">Delivery frequency</span>
          <div
            class="prime-subscribe__frequency"
            role="group"
            aria-label="Select delivery frequency"
          >
            <span
              class="prime-subscribe__freq-option"
              role="button"
              tabindex="0"
              aria-pressed="false"
              data-freq="biweekly"
            >Every 2 weeks</span>
            <span
              class="prime-subscribe__freq-option prime-subscribe__freq-option--active"
              role="button"
              tabindex="0"
              aria-pressed="true"
              data-freq="monthly"
            >Monthly</span>
            <span
              class="prime-subscribe__freq-option"
              role="button"
              tabindex="0"
              aria-pressed="false"
              data-freq="sixweeks"
            >Every 6 weeks</span>
          </div>
        </div>

        {%- comment %} Price comparison {%- endcomment %}
        <div class="prime-subscribe__pricing" aria-label="Pricing comparison">
          <span
            class="prime-subscribe__price-original"
            aria-label="Regular price {{ one_time_price }}"
          >{{ one_time_price }}</span>
          <span
            class="prime-subscribe__price-subscribe"
            aria-label="Subscription price {{ subscribe_price }}"
          >{{ subscribe_price }}</span>
          {%- assign save_amount = one_time_price | remove: '$' | times: 1.0 | minus: (subscribe_price | remove: '$' | times: 1.0) -%}
          <span class="prime-subscribe__price-save">
            {%- if save_amount > 0 -%}
              You save ${{ save_amount | round: 2 }}
            {%- else -%}
              Save {{ save_pct }}
            {%- endif -%}
          </span>
          <p class="prime-subscribe__price-label">per delivery · cancel anytime</p>
        </div>

        {%- comment %} CTA buttons {%- endcomment %}
        <div class="prime-subscribe__cta">
          <a
            href="{{ cta_url }}"
            class="prime-btn-primary"
            aria-label="{{ cta_text }}"
          >{{ cta_text }}</a>
          <a
            href="{{ secondary_url }}"
            class="prime-subscribe__secondary-link"
            aria-label="{{ secondary_text }}"
          >{{ secondary_text }}</a>
        </div>

      </div>{%- comment %} /.prime-subscribe__content {%- endcomment %}
    </div>{%- comment %} /.prime-subscribe__layout {%- endcomment %}

    {%- comment %} ── Footer Statement ── {%- endcomment %}
    <div class="prime-subscribe__footer prime-reveal" data-delay="300">
      <p class="prime-subscribe__statement">
        &ldquo;{{ bottom_stmt }}&rdquo;
      </p>
    </div>

  </div>{%- comment %} /.prime-container {%- endcomment %}
</section>

<script>
  (function () {
    'use strict';

    /* ── Scroll Reveal ─────────────────────────────────────── */

    function initScrollReveal() {
      var revealEls = document.querySelectorAll('#prime-subscribe-save .prime-reveal');
      if (!revealEls.length) return;

      if (!('IntersectionObserver' in window)) {
        revealEls.forEach(function (el) {
          el.classList.add('prime-reveal--visible');
        });
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              var delay = parseInt(el.getAttribute('data-delay') || '0', 10);
              setTimeout(function () {
                el.classList.add('prime-reveal--visible');
              }, delay);
              observer.unobserve(el);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      revealEls.forEach(function (el) {
        observer.observe(el);
      });
    }

    /* ── Frequency Selector Interaction ────────────────────── */

    function initFrequencySelector() {
      var section = document.getElementById('prime-subscribe-save');
      if (!section) return;

      var options = section.querySelectorAll('.prime-subscribe__freq-option');
      if (!options.length) return;

      options.forEach(function (opt) {
        function activate() {
          options.forEach(function (o) {
            o.classList.remove('prime-subscribe__freq-option--active');
            o.setAttribute('aria-pressed', 'false');
          });
          opt.classList.add('prime-subscribe__freq-option--active');
          opt.setAttribute('aria-pressed', 'true');
        }

        opt.addEventListener('click', activate);
        opt.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate();
          }
        });
      });
    }

    /* ── Init ───────────────────────────────────────────────── */

    function init() {
      initScrollReveal();
      initFrequencySelector();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

  })();
</script>

