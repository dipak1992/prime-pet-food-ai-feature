    padding-left: 26px;
    margin: 32px 0;
  }

  .ypc-tabs-recos .rte li {
    margin-bottom: 18px;
    padding-left: 8px;
  }

  .ypc-tabs-recos__reco-heading {
    margin: 0 0 18px;
    color: var(--ypc-text);
    font-size: var(--ypc-reco-heading-size);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

.ypc-tabs-recos__products {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

