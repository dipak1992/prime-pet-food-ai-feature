  }

  .ypc-tabs-recos__empty-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(225, 102, 16, 0.12);
    color: var(--ypc-accent);
    flex: 0 0 auto;
  }

  .ypc-tabs-recos__empty-state strong {
    display: block;
    font-size: 19px;
    line-height: 1.2;
    font-weight: 900;
  }

  .ypc-tabs-recos__empty-state p {
    max-width: 560px;
    margin: 8px 0 0;
    color: var(--ypc-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .ypc-tabs-recos__panel {
    display: none;
    background: #fffaf3;
