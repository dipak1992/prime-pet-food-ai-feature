}

.ypc-rec-product__title a {
  color: inherit;
  text-decoration: none;
}

.ypc-rec-product__price {
  display: flex;
  justify-content: center;
  gap: 8px;
  align-items: center;
  margin-bottom: 10px;
  font-size: var(--ypc-product-price-size);
  font-weight: 850;
}

.ypc-rec-product__price-current {
  color: var(--ypc-accent);
}

.ypc-rec-product__price-compare {
  color: var(--ypc-muted);
  text-decoration: line-through;
}

.ypc-rec-product__quick {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36px;
  padding: 0 14px;
  border-radius: 999px;
  background: var(--ypc-accent);
  color: #fff;
  font-size: 13px;
  font-weight: 850;
  text-decoration: none;
}

.ypc-rec-product__quick:hover {
  opacity: 0.9;
}
  @media (max-width: 1100px) {
    .ypc-tabs-recos__inner {
      grid-template-columns: 1fr;
      gap: 52px;
    }

    .ypc-tabs-recos__right {
      max-width: 760px;
    }
  }

  @media (max-width: 767px) {
    .ypc-tabs-recos {
      padding: 28px 16px 44px;
    }

    .ypc-tabs-recos__nav {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .ypc-tabs-recos__tab {
      min-height: 54px;
      padding: 10px 12px;
      font-size: 12px;
      gap: 8px;
    }

    .ypc-tabs-recos__tab::after {
      content: '+';
      margin-left: auto;
      color: var(--ypc-accent);
      font-size: 18px;
      font-weight: 950;
      line-height: 1;
    }

    .ypc-tabs-recos__tab.is-active::after {
      content: '-';
      color: #fffaf3;
    }

    .ypc-tabs-recos--has-open-panel .ypc-tabs-recos__content {
      padding-top: 12px;
