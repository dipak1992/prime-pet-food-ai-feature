{%- comment -%}
  Prime vs Rawhide visual comparison for homepage.
{%- endcomment -%}

{%- liquid
  assign comparison_image = section.settings.comparison_image | default: 'prime-rawhide-comparison-infographic.jpg' | asset_url
  assign cta_url = section.settings.cta_url | default: '/products/himalayan-yak-chews-for-dogs'
-%}

<section class="prc" aria-labelledby="PrimeRawhideTitle">
  <style>
    .prc {
      --prc-cream: #fbf3e5;
      --prc-panel: #fffdf7;
      --prc-ink: #1f1710;
      --prc-muted: #64584b;
      --prc-green: #183d2b;
      --prc-copper: #b35b2f;
      --prc-line: rgba(68, 51, 34, 0.14);
      background:
        linear-gradient(180deg, #fffaf0 0%, var(--prc-cream) 100%);
      color: var(--prc-ink);
      padding: clamp(50px, 8vw, 88px) 20px;
      font-family: var(--font-body-family, -apple-system, sans-serif);
    }

    .prc__inner {
      max-width: 1180px;
      margin: 0 auto;
    }

    .prc__header {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(260px, 0.42fr);
      gap: 24px;
      align-items: end;
      margin-bottom: 28px;
    }

    .prc__eyebrow {
      display: inline-flex;
      width: fit-content;
      margin-bottom: 14px;
      padding: 7px 14px;
      border: 1px solid rgba(24, 61, 43, 0.18);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.62);
      color: var(--prc-green);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .prc__title {
      max-width: 720px;
      margin: 0;
      color: var(--prc-ink);
      font-size: clamp(32px, 5vw, 56px);
      font-weight: 780;
      letter-spacing: 0;
      line-height: 1.03;
    }

    .prc__intro {
      margin: 0;
      color: var(--prc-muted);
      font-size: 15px;
      line-height: 1.58;
    }

    .prc__media {
      overflow: hidden;
      margin: 0 0 22px;
      border: 1px solid var(--prc-line);
      border-radius: 20px;
      background: var(--prc-panel);
      box-shadow: 0 22px 58px rgba(58, 39, 23, 0.13);
    }

    .prc__media img {
      display: block;
      width: 100%;
      height: auto;
    }

    .prc__grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 24px;
    }

    .prc__card {
      min-height: 210px;
      padding: 18px;
      border: 1px solid var(--prc-line);
      border-radius: 16px;
      background: rgba(255, 253, 247, 0.86);
    }

    .prc__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      margin-bottom: 14px;
      border-radius: 999px;
      background: var(--prc-green);
      color: #fff7ea;
    }

    .prc__icon svg {
      width: 21px;
      height: 21px;
      stroke: currentColor;
    }

    .prc__card h3 {
      margin: 0 0 12px;
      color: var(--prc-ink);
      font-size: 15px;
      font-weight: 800;
      line-height: 1.25;
    }

    .prc__compare {
      display: grid;
      gap: 10px;
      margin: 0;
    }

    .prc__side {
      display: grid;
      gap: 3px;
      padding-left: 12px;
      border-left: 3px solid var(--prc-green);
    }

    .prc__side--rawhide {
      border-left-color: rgba(179, 91, 47, 0.6);
    }

    .prc__label {
      color: var(--prc-green);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .prc__side--rawhide .prc__label {
      color: var(--prc-copper);
    }

    .prc__copy {
      color: var(--prc-muted);
      font-size: 13px;
      line-height: 1.4;
    }

    .prc__footer {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
      justify-content: space-between;
      padding: 18px 20px;
      border: 1px solid rgba(24, 61, 43, 0.14);
      border-radius: 18px;
      background: rgba(24, 61, 43, 0.08);
    }

    .prc__note {
      max-width: 760px;
      margin: 0;
      color: var(--prc-muted);
      font-size: 14px;
      line-height: 1.55;
    }

    .prc__note strong {
      color: var(--prc-green);
    }

    .prc__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 13px 22px;
      border-radius: 999px;
      background: var(--prc-ink);
      color: #fff7ea;
      font-size: 14px;
      font-weight: 780;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
    }

    .prc__cta:hover {
      background: var(--prc-green);
    }

    @media (max-width: 980px) {
      .prc__header {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .prc__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .prc {
        padding: 44px 16px 54px;
      }

      .prc__header {
        margin-bottom: 20px;
      }

      .prc__media {
        border-radius: 15px;
      }

      .prc__media img {
        min-height: 360px;
        object-fit: cover;
        object-position: 50% 50%;
      }

      .prc__grid {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .prc__card {
        min-height: 0;
        padding: 16px;
        border-radius: 14px;
      }

      .prc__footer {
        align-items: stretch;
        border-radius: 14px;
      }

      .prc__cta {
        width: 100%;
      }
    }
  </style>

  <div class="prc__inner">
    <div class="prc__header">
      <div>
        <span class="prc__eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="prc__title" id="PrimeRawhideTitle">{{ section.settings.heading }}</h2>
      </div>
      <p class="prc__intro">{{ section.settings.subheading }}</p>
    </div>

    <figure class="prc__media">
      <img
        src="{{ comparison_image }}"
        alt="Visual comparison of Prime Himalayan yak chews and rawhide across digestibility, odor, splinter risk, ingredients, and longevity"
        width="1792"
        height="1024"
        loading="lazy"
      >
    </figure>

    <div class="prc__grid" aria-label="Prime yak chew versus rawhide comparison">
      <article class="prc__card">
        <span class="prc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 12c4-7 12-7 16 0"/><path d="M4 12c4 7 12 7 16 0"/><path d="M12 5v14"/></svg>
        </span>
        <h3>Digestibility</h3>
        <div class="prc__compare">
          <span class="prc__side"><span class="prc__label">Prime</span><span class="prc__copy">Cheese-based and made for supervised chewing.</span></span>
          <span class="prc__side prc__side--rawhide"><span class="prc__label">Rawhide</span><span class="prc__copy">Processed hide can be harder on digestion.</span></span>
        </div>
      </article>

      <article class="prc__card">
        <span class="prc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M8 5c-2 2-2 4 0 6s2 4 0 6"/><path d="M14 5c-2 2-2 4 0 6s2 4 0 6"/><path d="M20 7c-1.4 1.6-1.4 3.4 0 5"/></svg>
        </span>
        <h3>Odor</h3>
        <div class="prc__compare">
          <span class="prc__side"><span class="prc__label">Prime</span><span class="prc__copy">Low odor for couches, crates, and quiet rooms.</span></span>
          <span class="prc__side prc__side--rawhide"><span class="prc__label">Rawhide</span><span class="prc__copy">Many options carry a stronger indoor smell.</span></span>
        </div>
      </article>

      <article class="prc__card">
        <span class="prc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/><path d="M9 12l2 2 4-5"/></svg>
        </span>
        <h3>Splinter risk</h3>
        <div class="prc__compare">
          <span class="prc__side"><span class="prc__label">Prime</span><span class="prc__copy">No rawhide sheets. Remove the nub before it is swallowable.</span></span>
          <span class="prc__side prc__side--rawhide"><span class="prc__label">Rawhide</span><span class="prc__copy">Can tear, soften, swell, or become difficult to manage.</span></span>
        </div>
      </article>

      <article class="prc__card">
        <span class="prc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M7 20c8 0 12-6 12-14V4h-2C9 4 5 8 5 16v4h2z"/><path d="M5 20c3-5 7-8 12-10"/></svg>
        </span>
        <h3>Ingredients</h3>
        <div class="prc__compare">
          <span class="prc__side"><span class="prc__label">Prime</span><span class="prc__copy">Yak milk, cow milk, lime juice, and salt.</span></span>
          <span class="prc__side prc__side--rawhide"><span class="prc__label">Rawhide</span><span class="prc__copy">Processed hide with quality that varies by brand.</span></span>
        </div>
      </article>

      <article class="prc__card">
        <span class="prc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg>
        </span>
        <h3>Longevity</h3>
        <div class="prc__compare">
          <span class="prc__side"><span class="prc__label">Prime</span><span class="prc__copy">Dense texture for longer calm-time sessions.</span></span>
          <span class="prc__side prc__side--rawhide"><span class="prc__label">Rawhide</span><span class="prc__copy">Chew time can vary widely by product and dog.</span></span>
        </div>
      </article>
    </div>

    <div class="prc__footer">
      <p class="prc__note"><strong>Simple rule:</strong> choose a chew your dog cannot swallow whole, supervise every session, and take the end piece away when it gets small.</p>
      <a class="prc__cta" href="{{ cta_url }}">{{ section.settings.cta_label }} &#8594;</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rawhide visual comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rawhide-free comparison"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why dog parents switch from rawhide."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A yak chew is still a hard chew that needs supervision. The difference is the recipe: simple dairy ingredients, low odor, dense texture, and no rawhide sheets."
    },
    {
      "type": "text",
      "id": "comparison_image",
      "label": "Comparison image asset filename",
      "default": "prime-rawhide-comparison-infographic.jpg"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop rawhide-free chews"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Rawhide visual comparison"
    }
  ]
}
{% endschema %}
