{{ 'prime-roadmap.css' | asset_url | stylesheet_tag }}

<section class="pdg" aria-labelledby="PrimeDurationGuaranteeTitle">
  <div class="pdg__inner">
    <div class="pdg__copy">
      <p class="pdg__kicker">30-day size guarantee</p>
      <h2 id="PrimeDurationGuaranteeTitle">Wrong size? We will help you fix it.</h2>
      <p>If the first size does not work for your dog's weight, jaw strength, or chew pace, contact us within 30 days. We will help you find the right fit or make it right.</p>
    </div>
    <div class="pdg__steps">
      <article><strong>1</strong><span>Use the size estimator before you order.</span></article>
      <article><strong>2</strong><span>Try a few supervised sessions and see how it goes.</span></article>
      <article><strong>3</strong><span>Not right? Contact us. We sort it out.</span></article>
    </div>
  </div>
</section>

